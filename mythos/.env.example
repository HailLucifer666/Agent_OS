# MYTHOS Entity Configuration
MYTHOS_NAME=MYTHOS
MYTHOS_PORT=4478
MYTHOS_BIND=127.0.0.1
# REQUIRED whenever MYTHOS_BIND is non-loopback (e.g. 0.0.0.0, as both
# Dockerfile and render.yaml set for cloud deployment). Server boot refuses
# to start with a clear error if the bind is non-loopback and this is unset —
# a cloud-deployed MYTHOS with no token would expose the full effector set (including T3
# confirm-and-execute) to anyone who finds the URL. Present it as either
# `Authorization: Bearer <token>` (any client) or a `mythos_session` cookie
# (a random session id a browser gets by entering the token once — BUG-444:
# the cookie never carries the token itself); the WS upgrade also
# accepts `?token=` since a browser WebSocket can't set headers. Unset (the
# default) = loopback-only mode, exercises none of the new auth code paths.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CAVEATS (security review, 2026-07-30): a token in `?token=` is exposed to
# whatever logs the request URL (the hosting platform's own access logs, any
# reverse proxy in front of it) — prefer the Authorization header wherever the
# client can set one; `?token=` exists only because a browser WebSocket
# can't. The session cookie is HttpOnly + SameSite=Strict, and Secure whenever
# the request arrived over HTTPS. The desktop app never shows a prompt: its
# main process holds the token and signs the window in itself.
#
# There is NO PIN. It was removed on 2026-09-23 ("I open the app, it puts me
# in the HUD"). With no token set, the server trusts this machine: anything
# running locally can call the API. A web page cannot — requests another site
# makes are refused (Origin / Sec-Fetch-Site, boot-guards.js), and a rebound
# hostname is refused by the Host check. PIN_SESSION_ENFORCE and
# PIN_SESSION_TTL_MS are retired; if set they are named at boot and do nothing.
# MYTHOS_AUTH_TOKEN=
#
# How long a browser tab stays authenticated after the operator enters
# MYTHOS_AUTH_TOKEN once in the dashboard's token prompt, ms. Default 30 days,
# minimum 1 hour. Only relevant when MYTHOS_AUTH_TOKEN is set (which a
# non-loopback MYTHOS_BIND makes mandatory): POST /api/auth/session checks the
# token you type and hands the tab an HttpOnly mythos_session cookie (a random
# id; the server keeps only its hash, in auth-sessions.json beside config.json,
# never in the vault), which is what lets plain page navigation and the
# WebSocket upgrade authenticate — a browser can attach an Authorization header
# to neither. Fixed at sign-in, never sliding; sessions survive a restart;
# changing the token ends every one of them. Nothing is ever auto-issued.
# AUTH_SESSION_COOKIE_TTL_MS=2592000000
MYTHOS_VAULT_ROOT=./vault
# One brain across two machines. Set this to a PRIVATE git repo and the vault
# syncs on boot (pull) and on quit (push), so the memory built on one machine is
# the memory the other one has. It must be private: the vault is every
# conversation, everything MYTHOS has learned about you, and the incident log.
#
# Nothing happens until you run `node scripts/vault-sync.js --init` yourself and
# make the first push by hand — the boot/quit hooks no-op until the vault is a
# git repo with a remote, so setting this alone starts nothing.
#
# Episodic memory is append-only JSONL and --init writes a .gitattributes with
# `*.jsonl merge=union`, which is what makes "both machines wrote today" merge
# instead of conflicting. Goals.json/Kanban.json are single mutable files and can
# still fork; a lock file records which machine had the vault open last, and the
# other machine warns about it on boot rather than silently overwriting.
# MYTHOS_VAULT_REPO=git@github.com:you/mythos-vault.git
MYTHOS_TICK_MS=1000
MYTHOS_IDLE_SALIENCE=0.3
MYTHOS_DRY_RUN=false

# Logging
LOG_LEVEL=info

# NOVA Passthrough (Brain providers)
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=
# GROQ_API_KEY=
# GROQ_API_URL=
# GROQ_MODEL=
# GROQ_STT_MODEL=whisper-large-v3-turbo  # voice input transcription (see providers/groq-stt.js)
# MISTRAL_API_KEY=
# MISTRAL_API_URL=
# MISTRAL_MODEL=
# NIM_API_KEY=
# NIM_API_KEY_2=
# NIM_API_URL=
# NIM_MODEL=
# NVIDIA NIM terms (verified 2026-08-17, https://docs.api.nvidia.com/nim/docs/product):
# the free hosted tier (build.nvidia.com / NVIDIA Developer Program) is for development,
# testing, research and evaluation only — production use requires an NVIDIA AI Enterprise license.
# ZCODE_API_KEY=
# ZCODE_API_URL=
# ZCODE_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_API_URL=
# OPENROUTER_KEEP_REASONING=   # set to 1 to keep chain-of-thought generation on.
#                              # Default excludes it: providers/openrouter.js only
#                              # reads delta.content, so reasoning tokens are billed
#                              # against quota and then discarded unread. Latency-
#                              # neutral (950ms vs 975ms median over 5 paired calls).
# FREE-ONLY MODE (added 2026-09-24). A key being present is not a decision to pay
# for it. With this set, MYTHOS calls only model routes it can classify as free
# (a provider's free plan on its official host, an OpenRouter ":free" variant, a
# Google model with a listed free tier) or local (Ollama on this machine, not a
# ":cloud" model). Paid and unclassified routes are refused BY NAME, in the log and
# in the reply — including CHAIN_* overrides, GEMINI_*_MODEL overrides, the build
# engine, image generation (its model has no free tier) and keys handed to MCP
# servers. It cannot see account billing: a Google project or Mistral account with
# pay-as-you-go enabled still charges for "free" models, so check each console.
# Values: unset or "any" (default, every configured route) | "free-only".
# MODEL_BILLING_POLICY=free-only
#
# BRING YOUR OWN PREMIUM KEY (BUG-418, added 2026-09-09).
# Free tiers are how MYTHOS is DEVELOPED, not a ceiling on what it can run. Set
# either key below and that provider heads the voice, reasoning, memory, build,
# simple and text lanes; leave it unset and the lane skips it silently, exactly
# like every other provider here. Neither is probed at startup -- both are paid
# APIs and a liveness probe every five minutes would be a billable request on
# your account -- so a wrong key surfaces on the first real call, in read_status.
# Reorder without touching code using CHAIN_VOICE / CHAIN_BUILD / CHAIN_REASONING
# / CHAIN_TEXT / CHAIN_SIMPLE / CHAIN_MEMORY.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=            # default claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=       # default 4096; the Messages API REQUIRES a cap
# ANTHROPIC_BASE_URL=         # default https://api.anthropic.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=               # default gpt-4.1
# OPENAI_BASE_URL=            # default https://api.openai.com/v1; point at an
#                             # Azure OpenAI deployment or a gateway if needed
# CEREBRAS_API_KEY=
# CEREBRAS_API_URL=
# CEREBRAS_MODEL=
# Google Gemini via its OpenAI-compatible endpoint (providers/google.js — no
# separate adapter needed). Free keys have NO Pro-tier quota: gemini-2.5-pro /
# gemini-pro-latest / gemini-3.1-pro-preview all 429. Use Flash-tier models.
# GOOGLE_API_KEY=
# GOOGLE_API_URL=
# GOOGLE_MODEL=

# Semantic memory embeddings (local-first: Ollama nomic-embed-text, then
# Mistral's free embeddings endpoint; both down -> keyword-only recall)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed
# GOOGLE_EMBED_MODEL=gemini-embedding-001
#   THIRD embedding rung, added 2026-09-11 and placed LAST in the chain.
#   Ollama being uninstalled left mistral-embed as the ONLY embedder, while
#   Mistral was returning 429 on four other models on the same key — a single
#   rate limit away from keyword-only recall. Requested at 1024 dimensions to
#   match mistral-embed (its default is 3072). Dimensions need not match in
#   any case: vector-index.js partitions by provider and vectors from
#   different providers are never compared. Last on purpose — it shares
#   GOOGLE_API_KEY with the voice/vision/memory/text lanes, and memory writes
#   must not be what exhausts the quota the operator hears.

# Brain lane overrides (optional escape hatches — comma-separated provider:model
# pairs, ranked best-first; leave unset to use lanes.default.js's built-in tables)
# CHAIN_VOICE=
# CHAIN_BUILD=
# CHAIN_SIMPLE=
# CHAIN_TEXT=
# CHAIN_VISION=
# CHAIN_EMBED=
# CHAIN_REASONING and CHAIN_MEMORY were added 2026-08-14 with the lane split.
# reasoning: the slow-and-good lane — background reflection, the reviewer and
#   reality-check seats, design verification, orchestrator synthesis, ask_agent
#   seats, engagement interviews, and the think_deeply tool. Defaults to
#   Cerebras (5 req/min but 2400/day) with NIM and Mistral behind it.
# memory: memory consolidation and grounded document answering. Defaults to a
#   Google model chosen so it does NOT share a per-model quota bucket with the
#   vision or voice lanes.
# CHAIN_REASONING=
# CHAIN_MEMORY=

# Minimum gap between think_deeply calls, in milliseconds (BUG-287).
#
# The reasoning lane is slow and rate-limited upstream (Cerebras is 5 req/min),
# and nothing stopped think_deeply being called in a tight loop. Measured on
# 2026-08-20: eight calls in one session, four of them inside 91 seconds, each
# restating the same diagnosis — the operator asked "why are you thinking deeply
# for everything?" and told MYTHOS to log it as a bug.
#
# 60000 is the cut that blocks the three rapid calls from that session (12s, 17s
# and 22s apart) while allowing the four spaced ones (61s, 153s, 416s). Raise it
# if replies still feel repetitive and slow; lower it if genuinely hard
# questions are being refused.
#
# The limit is global across the cortex, voice and Live paths, because it is one
# scarce upstream quota — so a background call can briefly block an
# operator-initiated one. A refused call is not an error: the tool tells the
# model to answer from its own knowledge, which is what it should have done.
#
# 0 disables it entirely — the deliberate opt-out. A non-numeric or negative
# value is rejected at config load; if one ever reaches the effector it falls
# back to the default rather than to zero, so a typo cannot silently switch the
# limit off while leaving it looking enabled.
# DEEP_THINK_MIN_INTERVAL_MS=60000
# think_deeply budget: the whole call, and each provider attempt inside it.
# DEEP_THINK_TIMEOUT_MS=20000
# DEEP_THINK_ATTEMPT_TIMEOUT_MS=7000

# Terse ("caveman") output style — comma-separated lane names. Adapted from
# https://github.com/JuliusBrussee/caveman, which measures ~65% fewer output
# tokens on prose. Drops articles, filler and pleasantries; code, commands,
# paths and error text are reproduced byte-for-byte (see
# src/core/brain/style-terse.js).
#
# Default is 'simple,memory'. 'simple' is the trivial/formatting lane; 'memory'
# was added 2026-08-14 when memory consolidation and document answering were
# split onto their own lane — without naming it here they would have silently
# lost terse compression, and compact summaries are the point of consolidation.
#
# Excluded on purpose: 'voice' is spoken aloud and terse fragments read out
# sound like a fault; 'build' emits artifact CONTENT, where a brevity
# instruction truncates real code; 'reasoning' exists precisely so those callers
# can think properly, and compressing their output works against that.
#
# Callers on a spoken path opt out per call with think({ terse: false }) — the
# boot greeting does, since it uses lane 'simple' but is read aloud. (The immune
# explainer also uses 'simple' and does NOT opt out; it only ever picks one of
# three fixed remedy values, so the style layer has nothing to compress.)
# Set empty to turn the layer off entirely.
# BRAIN_TERSE_LANES=simple,memory

# Voice reply TTS — local edge-tts service (Microsoft Neural voices, free/no key).
# Autostarted at boot when python + the edge-tts module are installed.
#
# ONE ENTITY, ONE VOICE. Three engines speak in a single session — this one (boot
# greeting + batch replies), GEMINI_LIVE_VOICE (S2S duplex), and the browser's
# speechSynthesis fallback when edge-tts is down. They must match. Until
# 2026-07-31 this default was en-GB-RyanNeural (male) against Aoede (female), so
# the entity greeted you as a British man and then answered as a woman. If you
# change this, change GEMINI_LIVE_VOICE and voice-loop.js's PREFERRED_VOICES too;
# test/voice-identity-consistent.test.js fails if they drift apart.
#
# 2026-08-06: matched gender turned out not to be enough — the operator still
# heard three different people (boot / spoken / typed). VOICE_UNIFIED_LIVE_VOICE
# is the real fix: MYTHOS now speaks through the Gemini Live session on every
# surface it can, so this edge-tts voice is what you hear only when Live cannot
# open. It was retuned en-GB-SoniaNeural -> en-US-AvaNeural to sit closer to
# Aoede, since its job is now "sound like the same person" rather than "be the
# everyday voice".
# VOICE_TTS_VOICE=en-US-AvaNeural

# WHICH ENGINE SPEAKS the non-Live paths (boot greeting, proactive speech, batch
# replies). The Live/S2S path always uses GEMINI_LIVE_VOICE regardless.
#   edge   (default) - edge-tts. ~900ms/sentence, free, but an UNOFFICIAL
#                      Microsoft endpoint this repo labels personal/hobby-only.
#   gemini           - Gemini TTS (VOICE_TTS_PROVIDER=gemini). Uses the SAME
#                      prebuilt voice as the Live path, so the entity is one
#                      person everywhere instead of one voice for the greeting
#                      and another for the conversation. MEASURED ~3.9s/sentence
#                      on gemini-2.5-flash-preview-tts and it is METERED.
#                      (gemini-3.1-flash-tts-preview measured ~17.6s — avoid.)
# Note the voice ids are engine-specific and NOT interchangeable: edge wants
# 'en-GB-SoniaNeural', Gemini wants a prebuilt name like 'Aoede'. The selector
# picks the right key for you; sending the wrong one is a hard 400 per chunk.
# Licensing for a SOLD product is a separate question for a lawyer — see the
# roadmap's step 6.5 gate. Nothing here is a legal conclusion.
# VOICE_TTS_PROVIDER=edge
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
#   DEFAULT CHANGED 2026-09-11. gemini-tts.js pinned gemini-2.5-flash-preview-tts
#   on a 2026-07-31 measurement that put 3.1 at ~17.6s/sentence. Re-measured with
#   3 samples each, alternating: 2.5 median 6382ms [6162, 6382, 21015], 3.1 median
#   5589ms [4445, 5589, 5992]. The newer model is faster AND steadier — the older
#   one produced a 21s outlier in three tries, which in a voice path is a turn the
#   operator hears nothing during. Set this back to the 2.5 id to revert.

# ORDERED CHAIN (preferred over the single VOICE_TTS_PROVIDER above). Resolved ONCE
# per session and STICKY — the boot greeting, proactive speech and every reply all
# come from the same engine, and it only moves on a real failure, never flapping
# back. You should never hear the voice change partway through a session.
#   VOICE_TTS_CHAIN=gemini,kokoro,edge,piper
#     (This example used to read `gemini,edge,piper`, which is the chain BUG-274 T1
#      replaced. T1 was fixed in code — config/voice-defaults.js now derives
#      `gemini,kokoro,edge,piper` — but this template still handed the OLD chain to
#      every fresh clone, and an explicit override beats a derived default, so copying
#      it reproduced the exact defect T1 closed. Corrected 2026-08-20. Leave the key
#      commented out unless you actually want to override the default.)
#     gemini  Aoede — the SAME voice as the Live/S2S path. ~3.9s/sentence, metered.
#             MEASURED 2026-07-31 on a free key: gemini-2.5-flash-tts allows
#             10 requests/DAY, and every SENTENCE is one request. The quota dies
#             about two replies in, mid-reply, and the chain fails over to edge —
#             so you DO hear the voice change partway through, despite the
#             promise above. Put `edge` first (or use a paid key) if a consistent
#             voice matters more than this one.
#     edge    edge-tts Sonia. ~1011ms, free, unofficial MS endpoint (hobby-only).
#     piper   local, OFFLINE, ~350ms, free. FACTS CORRECTED 2026-08-20 (BUG-274 T2):
#             this line used to read "MIT + open voices. The shippable one." Upstream
#             rhasspy/piper was ARCHIVED 2025-08-26; the only maintained fork,
#             OHF-Voice/piper1-gpl, is GPL-3.0; and rhasspy/piper-voices licenses each
#             voice separately (CC BY 4.0 / CC0 / MIT mixed), so "open voices" hides a
#             per-file check. T2 corrected providers/piper-tts.js and missed this copy.
#             Stated as facts on purpose — what you may ship is a lawyer's call, not
#             this file's.
#     kokoro  local Kokoro-82M (onnxruntime, in-process, no child service).
#             OFFLINE after the model is cached. Apache-2.0 code AND weights —
#             see KOKORO_VOICE below and THIRD_PARTY_NOTICES.md. Note its dependency
#             tree pulls an LGPLv3 binary (sharp, required at module scope) that
#             edge-tts does not, since edge-tts is BYO and ships no code — so this is
#             a different exposure, not zero exposure (BUG-274 step 6.6).
#
# IF WHAT YOU WANT IS "ONE VOICE FOR EVERYTHING", THIS CHAIN IS THE WRONG DIAL.
# VOICE_UNIFIED_LIVE_VOICE (default true) routes entity-initiated speech — the boot
# greeting, proactive announcements, typed replies — through the OPEN Gemini Live
# session, so Gemini itself speaks them in the same voice you hear when you talk to
# it. No second engine and no separate TTS quota. This chain is only reached when
# there is no usable Live session, which makes it the fallback voice, and the
# fallback SOUNDS DIFFERENT (edge's default is en-GB-SoniaNeural, a British voice).
# Reported 2026-08-07 as "it greeted me in a different voice"; BUG-149 now logs a
# warning whenever that fall-through happens with unified voice on, instead of
# switching voices silently.
# VOICE_TTS_CHAIN=

# Local Piper TTS (services/piper-server.py). Fully offline: no API, no key, no
# per-call cost — proven by blocking socket.connect/getaddrinfo and still getting
# audio, while edge-tts fails immediately under the same test. Voice models are
# ~60MB each, gitignored, installed per machine into mythos/models/piper.
# Measured US female voices: hfc_female 350ms, kristin 351ms, amy 379ms.
# PIPER_PORT=5051
# PIPER_VOICE=en_US-hfc_female-medium
# PIPER_MODEL_DIR=
# PIPER_AUTOSTART=            # 'false' = don't spawn at boot
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050

# Kokoro-82M TTS (providers/kokoro-tts.js). No child service — runs in-process
# via onnxruntime (kokoro-js + @huggingface/transformers, both Apache-2.0).
# Weights (~26MB q8, the default) download from Hugging Face on first use into
# mythos/models/kokoro/ (gitignored, per-machine, same convention as
# mythos/models/piper/). If the download stalls, the provider reports itself
# unavailable within ~15s so the chain falls through instead of hanging.
# KOKORO_VOICE=af_heart      # see kokoro-js's voice list for alternatives
# KOKORO_MODEL_DIR=          # override the cache dir
# KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_OFFLINE=false     # true = never fetch model files; fail honestly if the cache is missing
# KOKORO_DTYPE=q8            # fp32 | fp16 | q8 | q4 | q4f16 — q8 is the size/quality default
# KOKORO_LOAD_TIMEOUT_MS=60000  # hard bound on BACKGROUND model initialization (BUG-372).
#                             Distinct from the 15s availability RESPONSE bound, which is
#                             fixed: isAvailable() stops WAITING after 15s but does not abort
#                             the load, so a cold download keeps running for a later probe.
#                             This is what stops a stalled download pinning a worker forever.
# KOKORO_SYNTH_TIMEOUT_MS=60000 # one synthesis, measured from ADMISSION rather than from the
#                             start of inference, so time queued behind another utterance is
#                             inside the budget instead of added to it.
# Both must be whole numbers of milliseconds in 1..2147483647. An invalid value makes kokoro
# UNAVAILABLE with a reason naming the variable; it never fails boot, because an optional
# provider must not be the reason the assistant does not start.

# ORDERED STT CHAIN (providers/stt.js). Default 'groq': unchanged behaviour
# for anyone who sets nothing — /api/voice/transcribe used to call
# providers/groq-stt.js directly. Unlike VOICE_TTS_CHAIN there's no "sticky
# voice" concern (a wrong transcript for one utterance isn't an audible
# identity change), so every call just tries the chain fresh, first
# available wins.
#   VOICE_STT_CHAIN=groq,local
#     groq   Groq Whisper API. Needs GROQ_API_KEY + network.
#     local  On-device Whisper (providers/local-whisper-stt.js,
#            @huggingface/transformers). No network after the model is
#            cached, WAV audio only (see that file for why) — if a clip
#            arrives as webm/ogg it throws immediately and the chain falls
#            through to the next provider for that one utterance.
#     gemini Google Gemini transcription (providers/gemini-stt.js). Needs
#            GOOGLE_API_KEY — the key the voice/vision/memory/text lanes
#            already use. ADDED 2026-09-11: a round-trip test (synthesize a
#            sentence, feed the bytes back) transcribed it EXACTLY in 2876ms
#            on gemini-3.5-flash-lite. NOT in the default chain — one clean
#            synthetic sentence proves the wiring, not that it beats Whisper
#            on real room audio with accent, noise and crosstalk. Try
#            VOICE_STT_CHAIN=gemini,groq,local and compare on YOUR audio.
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
#   The purpose-built id is gemini-3.5-transcribe, deliberately NOT the
#   default: it answered 503 "experiencing high demand" on every attempt on
#   2026-09-11. Worth retrying once demand settles.
# KNOWN RISK: like Kokoro above, a Hugging Face download can stall
# indefinitely on this network. isAvailable() bounds the first cold-load
# attempt at ~15s so a stalled download reports unavailable instead of
# hanging the mic. Put 'local' AFTER 'groq' until you've confirmed the
# download completes on your own machine.
# VOICE_STT_CHAIN=
# WHISPER_MODEL_ID=onnx-community/whisper-base
# WHISPER_DTYPE=q8
# WHISPER_MODEL_DIR=          # override the cache dir

# Spoken JARVIS-style boot greeting on the first dashboard connection per boot
# (persona-voiced status brief; canned fallback when the brain is offline).
# Set to false to boot silently.
# BOOT_GREETING=true
# The greeting also picks up the last conversation's thread ("Last time we spoke:
# ...") from the 3 most recent conversation records within 3 days.

# Global push-to-talk hotkey (Electron desktop app only — a browser tab cannot
# claim an OS-wide accelerator). Press it anywhere to start/stop talking; it does
# NOT raise or focus the window, which is the point of a global hotkey. Goes
# through the same path as clicking the orb, so a locked HUD still refuses.
# Default Alt+Space, falling back to Control+Alt+Space, Control+Shift+Space then
# Control+Alt+M if another app already owns the accelerator (the boot log names
# whichever one won). Set to false to disable.
# MYTHOS_HOTKEY_TALK=Alt+Space

# Screen-OCR hotkey (Electron desktop app only): press it anywhere to OCR the
# screen; the result arrives as a native toast and lands on the clipboard from
# the main process (BUG-268). Default Control+Alt+X, falling back to
# Control+Shift+X if another app owns it (the boot log names the winner). Set
# to false to disable.
# MYTHOS_HOTKEY_OCR=Control+Alt+X

# Floating cursor overlay (Electron desktop app only): a global hotkey pops a
# small transparent, click-through attention ring centered on the OS cursor,
# then auto-hides ~1.5s later. Opt-in and OFF by default — an always-on-top
# window appearing unasked is the failure mode to avoid, so a missing or
# unparseable value here is always treated as OFF. Set to exactly "true" to
# enable; the hotkey (default Control+Alt+C, falling back to Control+Shift+C
# then Control+Alt+P) is only registered when this is on.
# MYTHOS_CURSOR_OVERLAY_ENABLED=false

# Electron shell switches (desktop app only; restart after editing).
# MYTHOS_ADBLOCK — the media window blocks ad/tracker requests by default; set
# false to let them through.
# MYTHOS_AUTO_UPDATE — the shell checks GitHub Releases for updates on boot;
# set off to never check (the operator updates by hand).
# MYTHOS_UPDATE_URL — override the update feed (a generic electron-updater
# feed URL). Unset = the GitHub Releases feed from package.json build.publish.
# MYTHOS_ADBLOCK=true
# MYTHOS_AUTO_UPDATE=on
# MYTHOS_UPDATE_URL=
# MYTHOS_HOTKEY_CURSOR_OVERLAY=Control+Alt+C

# Proactive follow-ups: the cortex's idle mull emits high-priority thoughts (an
# unanswered question, a stalled goal/build) and MYTHOS says them unprompted.
# Guards: never within FOLLOWUP_QUIET_MS of your last turn, at most one per
# FOLLOWUP_MIN_GAP_MS. Set FOLLOWUP_MIN_GAP_MS=0 to disable follow-ups entirely.
# FOLLOWUP_QUIET_MS=120000
# FOLLOWUP_MIN_GAP_MS=3600000

# Learning loop: run a reflection pass every N turns. It extracts operator
# preferences + speaking style from recent conversations into
# vault/Identity/self.md and vault/Identity/operator-style.txt, and REWRITES
# vault/Identity/operator-profile.txt whole. The profile exists because the
# preference list is newest-first and capped, so a durable day-one fact would
# otherwise be evicted by a week of newer trivia; rewriting it in full is what
# lets it accumulate and self-compact without an eviction policy.
# Runs only when MEMORY_AUTO_USER_FACTS=true (off by default since 2026-10-06:
# it writes about you without being asked).
# REFLECTION_EVERY_TURNS=15
# Second, separate reflection pass: analyses ACTION OUTCOMES (not conversation
# preferences) every N turns, writing to the diagnostician + Skills. Schema
# default is 30 (src/core/config/schema.js); when set only via env and left
# unset, src/core/identity/reflection.js falls back to 2x
# REFLECTION_EVERY_TURNS instead. REFLECTION_ACTION_MIN is the sample-size
# floor below which the pass skips.
# REFLECTION_ACTION_EVERY_TURNS=30
# REFLECTION_ACTION_MIN=5

# Self-error explanation: when an anomaly has no healing playbook, speak a
# plain-language cause + safe remedy (suppress tool / re-probe providers /
# needs-human). Set to false to disable.
# IMMUNE_EXPLAIN=true

# DeepSeek Harness / dsh (github.com/deepseek-ai/deepseek-harness, MIT) — REQUIRED.
# As of 2026-08-22 (W6) dsh is the ONLY build-content engine: build-runner.js
# (pipeline_execute / kanban_build_card / start_project / run_mission), the
# engagement executor's build stage, and Forge (build_project / revise_project)
# all generate through it, as does the dsh_task tool. There is deliberately NO
# brain.think fallback — when the engine is unavailable a build FAILS with an
# install hint rather than quietly producing a plausible-but-wrong artifact.
# Boot still succeeds without it; only builds stop.
#
# THIS REPLACED Hermes-Agent, and the swap was of the HARNESS ONLY. The models
# did not change: dsh runs whatever `BRAIN_TABLES.build` in
# src/core/brain/lanes.default.js ranks first that this machine can reach —
# today mistral/codestral-latest. There is no DEEPSEEK_API_KEY requirement and
# no DeepSeek model involved; "DeepSeek Harness" is the name of the program.
#
# INSTALL (once per clone):  node mythos/scripts/setup-dsh.js --install
# VERIFY:                    node mythos/scripts/setup-dsh.js
# It runs `npm install --save-exact @deepseek-ai/dsh@<pinned>` into
# <repo>/DeepSeek Harness/ (gitignored) — never `curl | bash`, and never into
# mythos/ itself: installing it there makes npm re-resolve mythos's whole
# 191-package tree, measured at 24 minutes of CPU and 2.8 GB of RSS with zero
# files extracted. A separate vendor root has nothing to re-resolve (452
# packages, ~26 minutes on Windows).
#
# THE VERSION IS PINNED AND THE PIN IS ASSERTED. dsh is a developer preview whose
# own README says there WILL be compatibility-breaking changes, so
# adapters/dsh-agent checks BOTH the installed package.json and the CLI's own
# --version output before every task (a half-finished reinstall makes those two
# disagree, and that is the state that produces inexplicable results rather than
# a clean failure). Do not float it on `latest`.
#
# NO KEY OF ITS OWN. dsh authenticates with the SAME provider key the build lane
# already names — MISTRAL_API_KEY for the current lane head. The adapter forwards
# exactly ONE credential per run, the one the selected route references, so a
# build cannot reach an unrelated provider key through a tool call. The generated
# provider overlay holds a credential REFERENCE (`apiKeyEnv: MISTRAL_API_KEY`),
# never a value, and is written to a temp file and deleted after the run.
#
# NOTE ON A SHARED MISTRAL KEY. Under Hermes this section demanded a SEPARATE
# workspace key, because a 20-60-call build shares Mistral's workspace rate limit
# with memory consolidation, the boot greeting, and every realtime vision/voice
# call that also ranks Mistral. That arithmetic has not changed and the symptom is
# the same: voice stutters, replies drop to the weakest model in the chain, or
# 429s appear on voice turns WHILE a build is running. If you have a second
# workspace key, put the build one first in the build lane rather than here — the
# lane is the single source of truth for which model and key a build uses.
#
# ===================== MEASURED BUILD ENDURANCE 2026-08-03 =====================
# Kept from the Hermes section because it measures THE PROVIDER, not the harness,
# and dsh drives the same Mistral endpoint. Measured with 12K-char prompts:
#   unpaced        -> HTTP 429 at call 3 of 60
#   8s  pacing     -> HTTP 429 at call 3 (pacing this small does not help)
#   45s pacing     -> 4/4 clean
# So it is a time-window rate limit, and the usable spacing is somewhere between
# 8s and 45s. A 60-call build at 45s spacing is ~45 minutes of waiting alone. In
# practice a real multi-call build needs a PAID tier or throttling. Backoff and
# retry is NOT built, deliberately — that is a design change the operator should
# choose rather than something a verification session adds.
#
# dsh's own request overhead, measured 12 times on 2026-08-21: ~10,700-10,820
# tokens of system prompt plus tool definitions BEFORE any task text, with a
# spread of ~120 tokens. It is a per-REQUEST floor, so pacing cannot evade it.
# ===============================================================================
#
# MEASURED AND EXCLUDED as build providers — do not re-add without new evidence:
#   Groq            8000 TPM on the free tier is a PER-REQUEST ceiling, and dsh's
#                   fixed ~10.7k overhead exceeds it before the task is added.
#                   413 rate_limit_exceeded on all 12 attempts. Needs the Dev tier.
#   NVIDIA NIM      0/3 at build size, one 503, up to 37s.
#   OpenRouter free the guardrail is a strict ALLOW-list; every model not on the
#                   account's list returns 404 "No endpoints available matching
#                   your guardrail restrictions and data policy".
#   ollama          pi-ai ships no catalog for it, so it is DELIBERATELY unmapped
#                   in the adapter. A lane walk that reaches the ollama tail
#                   refuses by name rather than guessing a loopback port.
#
# Mistral model notes: codestral-latest DOES support tool calling (256K ctx)
# despite its docs saying otherwise. Every devstral-*, mistral-code-agent-latest
# and mistral-medium-2505/2508 are DEPRECATED 2026-08-31 — do not pin them.
#
# WIRE-PROTOCOL GOTCHA, and it cost most of a session. dsh reaches a provider
# through pi-ai, which ships INSTALLED CATALOGS for mistral/cerebras/groq/nvidia/
# google/openrouter/deepseek. A route key naming one of those inherits that
# provider's endpoint AND ITS PROTOCOL. Hand-declaring `api: openai-completions`
# plus a `baseURL` instead forces OpenAI shaping, which sends the system prompt in
# a `developer` role, which Mistral rejects with `422 union_tag_invalid` — and
# `compat.supportsDeveloperRole: false` is INERT against it at both route and
# model level in 0.1.1-rc.2. The fix is not a compat switch: it is to stop
# declaring a protocol for a provider the catalog already describes. The adapter
# generates a catalog route and test/dsh-agent.test.js guards it.
#
# Build-driver timing (forge-runner.js). Plan runs are short and sandboxed;
# builds run a real agent loop and need real headroom. RENAMED from HERMES_* by
# W6 — the old names are NOT accepted as aliases, deliberately: a key named after
# a deleted program would look like it was working while the runner read the DSH_
# default instead.
# DSH_PLAN_TIMEOUT_MS=300000
# DSH_BUILD_TIMEOUT_MS=1800000
# DSH_POLL_MS=2000
#
# Timeout for a SINGLE-ARTIFACT text build (build-engine.js: pipeline cards,
# kanban cards, engagement builds). Separate from the two above, which bound
# Forge's multi-file agent loop. Until this existed no caller passed a timeout at
# all, so these builds silently inherited the adapter's generic default while a
# grounded build stacks research + skill resolution + a possible review-retry
# into one budget.
# DSH_TEXT_BUILD_TIMEOUT_MS=600000
# DSH_BUILD_TERMINAL_ENV=local
#
# Adapter-level bounds, read straight from the environment (not schema-validated):
# DSH_TASK_TIMEOUT_MS=600000
# Boot-time `dsh --version` liveness probe only — NOT for running a task. A live
# probe answers in about a second; 30s is cold-start headroom on a loaded machine.
# The hermes adapter's 15s cap once declared the engine OFFLINE while it was
# installed and working, purely because the machine was busy.
# DSH_PROBE_TIMEOUT_MS=30000
#
# Permission preset. MYTHOS SETS THIS PER RUN and an inherited value cannot
# override it, so this is documented for reading dsh's own docs rather than for
# tuning: a reply-only call (build-engine.generate, runPlan, runWidgetBuild) runs
# under `read-only`, so "write nothing" is enforced by the sandbox instead of
# asked for in a prompt; a write call (Forge runBuild, dsh_task) runs under
# `workspace-write`, confined to the invoking directory. `danger-full-access` is
# never used.
# DSH_PERMISSION_MODE=
#
# Telemetry is hard-disabled by the adapter (DSH_TELEMETRY_DISABLED=1) and the two
# companion variables are deleted from the child environment. dsh's shipped base
# bundle has NO redaction rule, so an enabled export can carry message text, tool
# arguments and results, and workspace paths.
# EDGE_TTS_AUTOSTART=true

# Voice agent max spoken reply length (chars). Raise for full reasoning paragraphs.
# VOICE_MAX_SAY_CHARS=800

# STT RECOGNITION HINTS (2026-08-22). Whisper takes an optional `prompt` that
# biases decoding toward the vocabulary it contains, and providers/groq-stt.js
# was sending none -- so every MYTHOS-specific word competed with ordinary
# English on equal terms. The idea is taken from Claude Code's published
# voice-dictation behaviour ("your current project name and git branch name are
# added as recognition hints automatically"), NOT its implementation: that
# service needs a Claude.ai session and is explicitly unavailable to an API key,
# so the model behind it cannot be reused. Only the technique is portable.
#
# MEASURED on synthesized speech, 2026-08-22
# (node mythos/scripts/verify-stt-hints.js): 4/8 MYTHOS terms recognised
# WITHOUT hints, 8/8 WITH. The specific misses it fixed were
#   "DeepSeq Harness"          -> "DeepSeek Harness"
#   "CodeStraw on Mistraw"     -> "CodeStral on Mistral"
#   "wakeward"                 -> "wake word"
#
# CAVEAT WORTH KEEPING. Synthesized speech is cleaner than a human on a laptop
# microphone with music playing, so that is a LOWER bound on the real gain, and
# it says nothing about the operator's own accent. Two of six cases were skipped
# on a Google TTS 429, so n=1 per term. Re-run the script against a real
# recording before treating the number as final.
#
# ON by default, because the failure mode is mild (a slightly more confident
# recognizer) while the defect it fixes is constant. Set to `off` to disable and
# A/B it yourself. The term list lives in providers/stt-hints.js; it is a bare
# comma-separated list rather than a sentence, on purpose -- Whisper reads the
# prompt as PRECEDING TRANSCRIPT, so a grammatical frame gives it something to
# continue on near-silent audio, and this repo already documents Whisper
# inventing stock phrases from silence.
# VOICE_STT_HINTS=on

# Conversation brain — idle reasoning frequency. During quiet moments the entity
# forms thoughts about the operator's situation (loose ends, follow-ups, observations).
# These surface naturally in the next conversation. 0 = disabled (zero-cost idle).
# MYTHOS_MULL_EVERY_TICKS=300

# get_weather tool default location ("lat,lon"), used when no location is
# spoken. Same Kolkata fallback the dashboard weather widget already uses —
# change to your real coordinates for accurate default weather reports.
# WEATHER_LOCATION=22.57,88.36

# Brain Timing
REFLECT_EVERY=60
CONSOLIDATE_EVERY=300
EPISODIC_RETENTION_DAYS=30
CHAIN_COOLDOWN_MS=60000
MODEL_REGISTRY_TTL_MS=300000

# Autonomy
AUTONOMOUS_MAX_TIER=2

# Operator-present trust (leash). A curated set of LOCAL, REVERSIBLE tier-3
# tools — browser clicking/typing/uploading, desktop clicking, closing a window —
# runs without an approval prompt WHEN AND ONLY WHEN a real operator connection
# is driving (a voice command or the Live session). Anything acting on its own —
# the autonomous goal loop, an LLM-authored engagement stage, an unattended
# reminder — passes no connection and still raises a confirm for exactly the same
# tools. This is not a change to AUTONOMOUS_MAX_TIER above and grants the
# autonomous loop nothing.
#
# TRUSTED_TOOLS adds your own tool names to that list (comma-separated). Entries
# that send, run/install, delete or execute arbitrary code can NOT be added — the
# never-trustable set is fixed in code, and includes gmail_send, whatsapp_send,
# run_command, install_from_github, hermes_task, delete_file, build_project,
# browser_evaluate and kill_session. Anything that is not tier 3, or is not a
# real tool name, is also ignored. Every ignored entry is reported by name at
# boot rather than dropped silently.
# TRUSTED_TOOLS=right_click_at,drag
#
# Set this to true to go back to confirming tier-3 actions, including the
# built-in trusted ones. It falls back to the older behaviour rather than to
# confirm-every-time: one approval per tool per connection, held for 15 minutes.
# Like every key here, it is read at boot — restart MYTHOS after changing it.
# TRUSTED_TOOLS_DISABLED=false
# B4 (2026-08-14): raised from 20000, which was ONE planner call. Measured that
# day: two goals spent ~31,200 tokens across 2 actions and auto-paused five
# seconds after being created, because the debit counts the whole prompt (system
# instruction + tool catalogue + recalled memory + history), i.e. a fixed
# per-call overhead identical for a one-line goal and a fifty-step one.
# GOAL_ACTION_BUDGET is the real runaway ceiling and is unchanged — on 2026-08-14
# it reached 2 of 25. Note this file is copied to .env, so a stale value here
# overrides the schema default no matter what the schema says.
GOAL_TOKEN_BUDGET=250000
GOAL_ACTION_BUDGET=25
MAX_ACTIVE_GOALS=5

# Immune
# REMEDIATION P2-9: was pinned at 5000 — copying this file to .env re-pinned
# the old pre-fix value and silently defeated config/schema.js's STALL_MS
# default bump to 30000 (lastTickAt isn't refreshed mid-tick, so a legitimate
# slow 'build'-lane brain call past 5s tripped the stall watchdog on healthy
# ticks). Kept explicit (matching this section's style) but now current.
STALL_MS=30000
WATCHDOG_MS=2000
BREAKER_FAIL_THRESHOLD=3
BREAKER_WINDOW_MS=30000
BREAKER_RESET_MS=15000

# Bus
BUS_HISTORY_SIZE=500
BUS_STORM_MAX=400

# Browser automation (playwright-core, drives installed Chrome/Edge)
# BROWSER_CDP_URL=http://127.0.0.1:9222
# BROWSER_AUTOMATION=true
# Windows Operator qualification mode: completed STT before task dispatch,
# native Live playback for conversation, verified TTS for task outcomes.
# Requires explicit extension setup with scripts/setup-browser-extension.js.
# DESKTOP_OPERATOR_ENABLED=false
# MYTHOS_BROWSER_EXTENSION_RUNTIME_DIR=<project-local-runtime-directory>
# Per-page default action timeout (click/type/textContent), ms. The adapter's
# page.setDefaultTimeout. Raise it for a slow SPA; lower it to fail faster on a
# genuinely-absent element. Default 15000.
# BROWSER_PAGE_TIMEOUT_MS=15000
# How long the waitReady() pre-wait (before click/type/get_text) waits for a
# selector to become visible, ms. Less than PAGE_TIMEOUT so a missing element
# fails here with a clean selector-named message instead of the raw Playwright
# timeout. 8000 covers most SPA (YouTube ytd-*) hydration. Default 8000.
# BROWSER_PAGE_WAIT_MS=8000
# Auto-connect: while OFFLINE, retry the CDP connect on this interval (ms) so
# browser automation comes online the moment a debug Chrome exists, and
# re-attaches after a drop. Connect-only, never launches — zero mic risk.
# 0 disables the poller. Default 15000.
# BROWSER_RECONNECT_MS=15000
# Fully hands-off: launch a debug Chrome automatically AFTER boot (once voice/mic
# init has claimed the audio device, so it can't steal the mic). Off by default —
# with it off, a debug Chrome opens on demand (first browser tool, or ask MYTHOS
# to "open the browser") or when you run scripts/setup-chrome-debug.ps1.
# BROWSER_AUTO_LAUNCH=false
# Delay (ms) before the deferred auto-launch fires. Default 20000.
# BROWSER_AUTO_LAUNCH_DELAY_MS=20000
# BUG-115: unpacked extension directories to load into MYTHOS's dedicated
# debug profile (semicolon-separated, e.g. an ad blocker) — the debug profile
# is otherwise a throwaway with no extensions, logins or history, so an
# extension living only in your REAL browser profile was never actually
# present in the one MYTHOS drove. Must be unpacked directories (not .crx/
# store installs); a configured directory that doesn't exist fails the launch
# loudly rather than silently launching without it. Empty by default.
#
# ADS IN THE DEBUG BROWSER (BUG-130). Two ways to deal with them, both BYO —
# MYTHOS bundles no third-party extension and downloads nothing on your behalf,
# because auto-fetching executable browser code would be both a supply-chain
# risk and a licensing one.
#   1. Easiest: let MYTHOS use BRAVE. Its Shields are part of the browser rather
#      than an extension, so they are on in the fresh debug profile with nothing
#      installed. Since BUG-130 Brave is picked first when it is installed; say
#      "open it in Chrome" (or pass browser:"chrome") if you want Chrome anyway.
#   2. Or point BROWSER_EXTENSIONS at an unpacked blocker you downloaded and
#      unzipped yourself. Example with uBlock Origin Lite, unpacked into
#      %USERPROFILE%\MYTHOS-extensions\ublock-lite (the folder containing
#      manifest.json — NOT its parent, and NOT a .crx file):
#      BROWSER_EXTENSIONS=%USERPROFILE%\MYTHOS-extensions\ublock-lite
#      Several are separated by semicolons. Note Chromium needs
#      --disable-extensions-except alongside --load-extension, which MYTHOS
#      passes for you; a consequence is that ONLY the extensions listed here
#      load.
# BROWSER_EXTENSIONS=
# Folders browser_upload_file may attach files from — the resume/document case
# for job applications (semicolon-separated; %USERPROFILE% is expanded). This is
# a security boundary, not a convenience default: with nothing set here MYTHOS
# REFUSES every upload and says so, rather than being able to hand an arbitrary
# file off your disk to a web page. Paths are checked after resolving symlinks,
# so a link planted inside an allowed folder cannot point outside it.
# BROWSER_UPLOAD_DIR=%USERPROFILE%\Documents\MYTHOS
# Unrelated to CDP automation above: generate_pdf (src/core/effectors/
# from-docs.js) shells out to headless Chrome to print HTML to PDF, and probes
# the standard Windows install locations first. Set this only when Chrome lives
# somewhere non-standard; it is ignored unless the path exists. With no Chrome
# at all, generate_pdf degrades honestly to styled HTML instead of failing.
# CHROME_PATH=

# Google OAuth (Gmail + Calendar adapters). Full operator walkthrough:
#   docs/google-oauth-setup.md   (Cloud Console project, consent screen, scopes)
# Mint the refresh token with:  node scripts/google-auth.js
# (Phase 3 / BUG-024: the script now requests calendar.readonly too — re-mint if
# your existing token predates 2026-07-19, or Calendar reads will 403.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Engagement Layer (structured task lifecycle — interview intake through completion)
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Wake-word — hands-free "hey jarvis" activation (on-device ONNX, no cloud).
# Opt-in and off by default. The pretrained openWakeWord models are CC BY-NC-SA
# so they are never committed to this repo; fetch them yourself once with:
#   node scripts/setup-wakeword.js
# then set WAKEWORD_ENABLED=true and restart. WAKEWORD_THRESHOLD is the
# 0.1-0.95 score cutoff that counts as a detected wake word (higher = fewer
# false triggers, more missed activations).
# WAKEWORD_ENABLED=false
# WAKEWORD_THRESHOLD=0.5

# Ambient screen awareness — periodic screenshot -> vision-description sensor
# feeding the perception loop (src/core/sensors/screen-sensor.js). Opt-in and
# off by default. An unchanged screen (sha1 hash match) never triggers a vision
# call. Raw screenshot bytes are NEVER written to disk — only the text
# description flows onward. Toggle live with the voice/tool command
# "watch my screen" / "stop watching my screen" (ambient_awareness tool).
# SCREEN_AWARENESS_ENABLED=false
# SCREEN_AWARENESS_POLL_MS=30000
# SCREEN_AWARENESS_SALIENCE=0.3

# Native speech-to-speech voice (Gemini Live, BidiGenerateContent). Opt-in and
# OFF by default — voice-agent.js's existing batch Whisper-STT path is the
# untouched fallback with zero behavior change until this is flipped; setting
# it back to false is a total rollback (V2 §16), no code revert needed.
# Requires a real GOOGLE_API_KEY with Live API access — run
# node scripts/verify-gemini-live.js first to confirm your key can reach it.
#
# VERIFIED END TO END 2026-07-31 against the real API, not just the handshake:
# session open 799ms, text -> first audio 668ms, real PCM returned, AD-6 output
# transcription live, and a tool call (list_windows) executed through the normal
# leash -> dispatch spine with exactly one audit line. A T3 request (delete_goal)
# correctly raised a confirm instead of executing, and the target survived.
# For comparison, the batch path it replaces measures ~612ms of brain plus a flat
# ~900ms per sentence of TTS, on top of STT.
#
# COST: the Live API is METERED PER SESSION and bills for the whole time the
# socket is open, not per request. LIVE_IDLE_TIMEOUT_MS / LIVE_SESSION_MAX_MS
# below are the two caps that stop an idle session billing forever.
# VOICE_S2S_ENABLED=false

# Live memory: inject what the vault knows into the spoken path's frame so the
# voice does not forget what the text path remembers. Default ON; false
# restores the pre-fix frame exactly (see server/index.js OPERATOR FACTS).
# A saved note that names startup ("Upon boot, ...", "... on startup") is given
# to the boot greeting only, never to this frame or a recall snippet (BUG-463).
# LIVE_MEMORY_INJECT=true

# Automatic "facts about you" (memory consolidation, step 3b): OFF by default
# since 2026-09-25 (BUG-463). When on, MYTHOS reads recent conversation every few
# minutes and saves what it takes to be durable facts about you, without asking.
# On one machine that turned a day of bug testing into a permanent "currently
# working on bugs ..." fact that steered later chats. Only the exact value "true"
# turns it on. What you ask MYTHOS to remember is saved either way.
# Since 2026-10-06 the same switch also covers the reflection pass, which records
# what MYTHOS infers about you without asking (your learned preferences, speaking
# style and profile, every REFLECTION_EVERY_TURNS turns). Off, it writes nothing
# new; what is already stored stays. Not covered, on purpose: habit facts
# ("Listens to X") stay on, but need 3 plays on 2+ different days; and memory
# consolidation keeps MYTHOS's own status lines but drops any line about you.
# Notes and remembered facts you ask for are saved either way.
# MEMORY_AUTO_USER_FACTS=false

# Record-window ducking on the legacy (non-S2S) voice path: MYTHOS lowers system
# volume while it listens. Live duplex never reaches this code. Volume is a
# percentage; the rest are guards against flapping (hold, cooldown, how many
# false triggers before ducking is suppressed and for how long, and a safety
# un-duck if the release is ever missed).
# DUCK_VOLUME_LEVEL=15
# DUCK_MIN_HOLD_MS=800
# DUCK_COOLDOWN_MS=1200
# DUCK_FALSE_MAX=2
# DUCK_SUPPRESS_MS=30000
# UNDUCK_SAFETY_MS=15000
# BUG-428: set false to restore the old microphone-ceiling decision; restart required.
# No barge-in echo veto or 8s/30s timer changes. Acoustic verification remains owed.
# VOICE_ECHO_VERDICT_TO_CLIENT=true
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
#
# GEMINI_LIVE_VOICE — one of Aoede | Kore | Leda | Zephyr | Puck | Charon.
# Kept at Google's own suggested assistant-style default, Aoede, because
# picking between them properly means auditioning each by ear against real
# speakers — a step that needs a human operator and cannot be done in this
# build environment. This default is fully operator-overridable: set this key
# once you've listened to a few turns and have a preference.
# GEMINI_LIVE_VOICE=Aoede
#
# GEMINI_LIVE_LANGUAGE — pin the Live session's speech language (BCP-47, e.g.
# en-US, es-ES, fr-FR). Default unset = auto-detect, Gemini's own default and
# this project's. Set this if your session's STT drifts into a different
# language mid-conversation. CAVEAT: per Gemini Live's own docs, some
# languages (e.g. Hindi, Bengali) are speech-INPUT-only for this API — pinning
# one of those changes what the model expects to HEAR, not what it can speak
# back in.
#   CORRECTION, 2026-08-20 session: the practical half of that caveat is NOT
#   confirmed here, and as written it would lead the next reader to the wrong
#   conclusion. With this key UNSET, MYTHOS produced multiple long, fluent
#   Bengali replies in that session, and the operator confirms it speaks Hindi
#   and Bengali. Whether output would survive PINNING one of those languages is
#   untested on this machine — that, and only that, is what the caveat still
#   covers. Do not restate the stronger claim.
#
#   DELIBERATELY UNSET. Operator decision 2026-08-21, after being shown that
#   the 2026-08-20 session's transcripts drifted into Spanish and Korean ("¿Qué
#   forma tiene un hongo?" and "후에 원도 만에 좋겠어" against Bengali/Hindi/English
#   speech): "keep English for now, it can speak in Hindi and Bengali, this is
#   not an issue of priority, leave it as is." Auto-detect is the accepted
#   trade-off. Do NOT pin a language, and do NOT add a language selector,
#   without asking the operator again.
#
#   The third option the operator declined, recorded so nobody builds it
#   speculatively: surfacing the detected language in the HUD or a log line so a
#   drift is visible rather than inferred from a nonsense reply.
#
#   What this does NOT excuse: a garbled transcript must never produce a
#   confident fabricated answer. That is BUG-295's territory (the missing
#   NO_CONTENT_CLAIM) and BUG-280's stale-source caution — absorbing bad input
#   honestly beats trying to guarantee perfect transcription.
# GEMINI_LIVE_LANGUAGE=
#
# VOICE_UNIFIED_LIVE_VOICE — one voice on every surface. Default true.
# The Live session is normally created lazily, on the wake word, which is why
# the boot greeting and typed-only chat used to answer in the edge-tts voice (or
# the browser's, if the edge-tts sidecar was still starting) while spoken
# conversation answered in GEMINI_LIVE_VOICE. With this on, entity-initiated
# speech and typed HUD turns open a Live session on demand and speak through it,
# so all three surfaces are literally the same voice.
# THE TRADEOFF, stated plainly: a Live session can now open without you having
# said anything, and the Live API bills for the time the socket is open. The
# idle/session-max rotations above still apply, and live-session.js stops
# rotating after 3 idle rounds with no real speech. Set false for the previous
# behaviour — it is a pure config rollback, no code path changes.
# VOICE_UNIFIED_LIVE_VOICE=true
#
# LIVE_IDLE_TIMEOUT_MS and LIVE_SESSION_MAX_MS are cost/lifecycle gates, not
# hard kills (BUG-059 fix): when either fires, live-session.js rotates the
# duplex socket (closes and transparently reopens with the same
# sessionResumption handle) instead of dropping the session, so MYTHOS never
# goes silently deaf just because it was mid-TTS when the timer fired. Raise
# LIVE_IDLE_TIMEOUT_MS if you still see resets during long silences; lower it
# to bill less for idle open-mic time.
# LIVE_IDLE_TIMEOUT_MS=120000
# LIVE_SESSION_MAX_MS=600000
#
# LIVE_TOOL_ALLOWLIST — comma-separated tool names exposed to the Live
# session's functionDeclarations. Empty (default) uses live-tools.js's curated
# high-traffic set — function-calling accuracy degrades with MYTHOS's full
# registered tool set, so this is a deliberate subset, not a cap you need to lift.
# LIVE_TOOL_ALLOWLIST=
#
# TOOL_ACK_DEADLINE_MS — how long a Live voice turn waits for a tool call to
# resolve before it counts as slow. Since BUG-457 (2026-09-24) a slow call's reply
# is then HELD up to 12 s for its real result (a `live.tool-held` line each, and
# the HUD's one soft chime covers the silence); only past that is it acked
# status:'started', with the outcome arriving later on the [SYSTEM] channel
# (BUG-128's net). Lower = the chime comes sooner; higher = fewer holds. EVIDENCE-FIRST
# tuning: count `live.tool-ack-deadline` lines in the server log per voice
# session — each names the tool and the deadline it blew — and raise the value
# until the storms stop. A 2026-08-15 session measured 4 late acks on
# web_search/web_fetch alone at the default. Default 1500; minimum 250.
# TOOL_ACK_DEADLINE_MS=1500

# --- Live screen share (Electron Slice 3, desktopCapturer) --------------------
# Streams your desktop into the open Live session as JPEG video frames, so you
# can ask "what am I looking at?" and get an answer about the ACTUAL screen
# rather than a description the ambient screen-sensor wrote earlier.
#
# READ THIS BEFORE ENABLING. This sends pictures of your screen to Google
# continuously for as long as a voice session is open — a materially different
# privacy posture from sending audio. Everything visible goes: other windows,
# notifications, whatever is behind the HUD. It is off by default and no
# upgrade turns it on. Frames are never written to the vault or the bus; they
# go to the Live socket and nowhere else.
#
# Needs Electron (the desktop shell grants the capture). In a plain browser the
# native screen-picker appears instead, which also works but asks every session.
# LIVE_SCREEN_SHARE_ENABLED=false

# BUG-432. Our own system notices interrupt each other: six can leave
# onLiveTurnComplete in one synchronous pass, and Gemini treats each text frame
# as a new turn, so notice two cuts notice one mid-sentence. With this on, a
# notice offered while a turn is in flight is held and released one per turn.
# Since 2026-09-23 (BUG-432's measured pass, BUG-436) the answer to your own
# request is never held behind a notice, nothing is ever forced into a reply in
# progress, an ordinary announcement older than 60 s is dropped, and a result
# that finishes while the voice connection is reconnecting reaches the resumed
# session instead of being spoken in the other voice. OFF until an attended
# comparison against the previous behaviour; off is the pre-fix path exactly.
# Read from the environment rather than the config schema because schema.js is
# at its file-size ratchet ceiling — see notice-queue.js.
# VOICE_SERIALIZE_NOTICES=false
# LIVE_NOTICE_HOLD_MAX_MS was removed on 2026-09-23 along with the ceiling it
# set; a value left in your .env is ignored.
#
# Diagnostic only (BUG-406). Records the microphone gate around every release —
# mic level, both gates, playback-ahead time and the audio clocks, NUMBERS ONLY,
# never audio or words — and writes it under the repo's .cache/voice-gate-recorder/
# (gitignored, never the vault). For attended runs from source; a packaged install
# cannot write there and says so once in the log.
# VOICE_GATE_RECORDER=false
#
# Diagnostic only (BUG-436). Times every synchronous fs and child_process call
# so a loop.stalled log row can name the one that blocked the event loop. Read
# straight from the environment by src/core/loop-lag.js, not a schema key — see
# the comment there. Leave it off unless you are chasing a stall; it wraps
# hundreds of functions.
# LOOP_LAG_TRACE=false
#
# Frames per second. This is a COST dial: every frame is a billed image input
# on your own key. 0.5 (one frame per two seconds) is enough for "watch my
# screen" because the model retains earlier frames in context. 1-2 feels more
# responsive and costs proportionally more. Max 4.
# LIVE_SCREEN_FPS=0.5
#
# JPEG quality, 0.1-1. Frames are downscaled to a 1280px long edge first — the
# model reads layout and large text, not fine pixels, so 0.6 is a deliberate
# floor rather than a compromise.
# LIVE_SCREEN_JPEG_QUALITY=0.6
#
# Per-frame size ceiling in KB, enforced server-side. This is a security bound,
# not a tuning knob: without it nothing capped a frame below the WebSocket
# library's 100MB default, so anything that could reach the local socket could
# push arbitrarily large billed images at your own Gemini key. Raise it only if
# real frames are being refused (the log names the size when that happens).
# LIVE_SCREEN_MAX_FRAME_KB=2048

# Daily planning + accountability — morning brief, stall check-ins, evening
# review over the existing Goals system (src/core/planner/daily.js). On by
# default (no camera/mic/screen capture involved). Say "be stricter with me"
# to raise the strictness persona dial and harden the check-in tone.
# PLANNER_ENABLED=true
# PLANNER_MORNING_HOUR=9
# PLANNER_EVENING_HOUR=21
# PLANNER_CHECKIN_EVERY_MS=10800000

# ---- W8 (Phase 2 — Wiring Integrity): previously-undocumented schema keys.
# All schema-defined (see src/core/config/schema.js); documented here for
# discoverability. Commented = the schema default is in effect. ----

# Action dispatch / leash / lifecycle
# ACTION_TIMEOUT_MS=30000          # bounds a single dispatchAction() call
# TICK_WEDGED_MS=120000            # a cortex tick past this is declared wedged (well past ACTION_TIMEOUT_MS)
# screen_look / vision: the whole look, and each provider attempt inside it. A
# look that outlives the budget fails honestly instead of narrating late.
# VISION_CALL_TIMEOUT_MS=12000
# VISION_ATTEMPT_TIMEOUT_MS=7000
# LEASH_CONFIRM_TTL_MS=120000      # how long a T3/T4 confirm stays approvable
                                   # (was 30s; widened for phone approvals, where
                                   # the operator has to pick the device up first)
# SHUTDOWN_MS=10000                # graceful-shutdown hard-exit backstop
# MAX_DRAIN_PER_TICK=50            # perception cap per cortex tick (§11.1)

# Server rate limiting + WS/CORS allowlist
# RATE_LIMIT_GLOBAL=240            # /api/* requests per minute
# RATE_LIMIT_EXPENSIVE=8           # /api/voice/transcribe per minute
# ALLOWED_ORIGINS=                 # comma-sep WS/CORS allowlist (P4 — Render hostname)

# Brain chain tuning
# CHAIN_ATTEMPT_TIMEOUT_MS=30000   # per-provider-attempt timeout (distinct from ACTION_TIMEOUT_MS)
# VOICE_OLLAMA_KEEP_ALIVE=10m      # ollama vision-lane keep-alive

# Voice loop
# VOICE_RECALL_TIMEOUT_MS=3500     # RAG recall bound before reply
# VOICE_MAX_TOOL_ITERATIONS=4      # tool-call rounds per voice turn
#
# Conversation memory. The history is SERVER-scoped and persisted to
# vault/Conversation/session.json, so it survives both a dashboard reconnect and
# a restart; it is dropped once it is older than VOICE_INTAKE_IDLE_MS. Entries
# are capped BOTH by count and by total characters — real voice turns run
# 50-400 chars, so 12000 chars holds roughly 12-18 exchanges. Raising
# VOICE_HISTORY_MAX_CHARS costs prompt tokens and latency on EVERY turn.
# VOICE_INTAKE_IDLE_MS=2700000     # idle conversation retention (45 min)
# VOICE_HISTORY_MAX_TURNS=40       # history entries kept (user+assistant+outcomes)
# VOICE_HISTORY_MAX_CHARS=12000    # total history prompt budget
# VOICE_EMAIL_MODE=gmail           # 'gmail' (adapter) or 'mailto' (open client)
# Semicolon-separated sandbox roots for open_folder/list_folder/read_file (the
# project root is always included). Add more roots with ";", e.g.
# %USERPROFILE%;%LOCALAPPDATA%\SomeFolder
# VOICE_ALLOWED_DIRS=%USERPROFILE%

# Speech cadence
# ANNOUNCER_REANNOUNCE_MS=600000   # immune announcer dedup cooldown (BUG-030)
# MYTHOS_LOG_PRETTY=               # 'force' = on when piped, 'false' = off

# Task 5 (step 5, alarms/timers) — override the bundled timer/reminder alert
# tone (a real WAV; default is mythos/ui/public/audio/alert.wav). Missing or
# unreadable degrades honestly — the reminder still speaks, it just doesn't ring.
# REMINDER_ALERT_SOUND=

# Embeddings / STT model overrides (free-tier default models)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Provider URL overrides (default to the official endpoints)
# NIM_API_URL=https://integrate.api.nvidia.com/v1
# GROQ_API_URL=https://api.groq.com/openai/v1
# MISTRAL_API_URL=https://api.mistral.ai/v1
# CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Edge-TTS child service. edge-tts is BYO — never bundled, never installed for you.
# Supply it project-local (the autostarter checks these BEFORE PATH):
#   python -m venv .venv
#   .venv/Scripts/python -m pip install edge-tts     # Windows
#   .venv/bin/python -m pip install edge-tts         # macOS / Linux
# Searched, in order: mythos/.venv, <repo>/.venv, then `python`/`python3` on PATH.
# Absent = server TTS stays off and the browser's speechSynthesis speaks instead.
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050
# EDGE_TTS_AUTOSTART=              # 'false' = don't spawn at boot

# Phase 3 (V7) — run_command effector. Allow-listed shell commands for build
# verification (engagement verify-stages + Forge verify-stages). Empty = disabled
# (fail-closed). Format: 'cmd:flag,flag;cmd2:flag;cmd3' — semicolons between
# commands, colon precedes a command's allowed flags, commas between flags.
# Keep minimal; NEVER allow sh/bash/cmd/powershell. v1 is allowlist+timeout,
# NOT a full sandbox — see mythos/src/core/effectors/from-runner.js.
# RUN_COMMAND_ALLOWLIST=npm:test,install,run;node:--version;git:status,diff,log
# RUN_COMMAND_TIMEOUT_MS=60000

# install_from_github effector — shares the RUN_COMMAND_ALLOWLIST gate above, so
# it is disabled (fail-closed) whenever that list is empty. It needs 'git' plus
# whichever package manager the target repo uses:
#   RUN_COMMAND_ALLOWLIST=git;npm;pip;cargo;go
# TRADE-OFF TO UNDERSTAND BEFORE SETTING THIS: the allowlist is shared, so
# allow-listing these also lets the generic run_command tool invoke them with
# arbitrary arguments (still T3 confirm-gated). Entries without a colon permit
# ANY args for that command — use the 'cmd:flag,flag' form to narrow them.
# Clones land in vault/builds/installs/<repo>. The effector never executes a
# repo's install.sh/Makefile — only git + package-manager commands.
# INSTALL_TIMEOUT_MS is separate from RUN_COMMAND_TIMEOUT_MS because a real
# `npm install`/`pip install .` routinely exceeds the 60s command default.
# INSTALL_TIMEOUT_MS=600000

# Calendar-upcoming sensor. Reads the unfired reminders and emits
# perception.calendar for events due within CALENDAR_UPCOMING_LEAD_MS, so the
# OODA loop (orient/decide) can act on them — distinct from reminder-sensor,
# which fires straight to proactive speech once an event is already overdue.
# On by default.
# CALENDAR_UPCOMING_ENABLED=true
# CALENDAR_UPCOMING_POLL_MS=60000
# CALENDAR_UPCOMING_LEAD_MS=900000
# CALENDAR_UPCOMING_SALIENCE=0.6

# Window-awareness sensor. Reads the FOREGROUND window's app/title via the
# pc-child 'active_window' command (no screenshot, no vision call) and emits
# perception.window so the cortex can reason about what the operator is doing
# right now. Opt-in, off by default (same privacy surface as screen-sensor).
# WINDOW_AWARENESS_ENABLED=false
# WINDOW_AWARENESS_POLL_MS=30000
# WINDOW_AWARENESS_SALIENCE=0.3

# Misc previously-undocumented schema keys
# MYTHOS_VERSION=                   # overrides package.json version at boot
# SKILL_MIN_SUCCESS_RATE=0.5        # skills below this success rate are not replayed by plan()
# VOICE_SPOKEN_CONFIRM_TTL_MS=60000 # window in which a spoken "yes" confirms a pending action
# GOAL_FAIL_PAUSE_THRESHOLD=3       # identical (tool+argsHash+goalTitle) failures before a goal auto-pauses
# LESSON_RECALL_LIMIT=5             # prior failures the goal planner injects into its brain prompt
# LESSON_RETENTION_DAYS=90          # how long the Lessons store keeps a recorded failure
# ORIENT_RECALL_LIMIT=5             # orient->recall cache size cap
# ORIENT_RECALL_MIN_SALIENCE=0.5    # perception salience needed to trigger a recallHybrid call
# CONSOLIDATE_MERGE_MIN=3           # consolidated-* topics needed before the merge pass fires

# ---------------------------------------------------------------------------
# MCP client — talk to Model Context Protocol servers over stdio.
# ---------------------------------------------------------------------------
# Empty = disabled (fail-closed): nothing is spawned and every mcp_* tool
# reports disabled. This is the default and it is a fine place to stay.
#
# MCP_SERVERS is a JSON array on ONE line. Per entry:
#   name       [A-Za-z0-9_-]. Becomes part of the tool address, which is always
#              mcp__<name>__<tool> — never the server's bare tool name. That
#              prefix is what stops browser-use's browser_navigate from
#              colliding with MYTHOS's own browser_navigate.
#   command    the binary. Spawned with shell:false; no shell expansion.
#   args       array of strings.
#   env        per-server environment. "${VAR}" expands from your real
#              environment, so no key is written into this file twice. This is
#              the ONLY way a secret reaches a server: the ambient environment
#              is scrubbed of API keys/tokens before spawning.
#   autostart  connect at boot instead of on first use. Default false.
#
# READ THIS BEFORE ENABLING ANYTHING. An MCP server is NOT sandboxed by MYTHOS.
# It runs with your privileges. RUN_COMMAND_ALLOWLIST, the folder allowedRoots
# and the shell-metachar reject guard MYTHOS's own effectors and do NOT apply to
# a call routed through this transport — Desktop Commander's write_file reaches
# your whole disk. Every call is therefore tier 3 (confirm), and the real trust
# decision is listing the server here at all.
#
# Desktop Commander (long-lived terminal sessions, paged tree search, surgical
# block edits — see mythos/skills/desktop-commander/SKILL.md for which jobs
# should stay on MYTHOS's own tools instead):
# MCP_SERVERS=[{"name":"desktop_commander","command":"npx","args":["-y","@wonderwhy-er/desktop-commander@latest"]}]
#
# browser-use (outcome-driven browsing; needs uv + its own LLM key. MYTHOS's
# built-in playwright browser_* tools stay the default for anything
# deterministic):
# MCP_SERVERS=[{"name":"browser_use","command":"uvx","args":["--from","browser-use[cli]","browser-use","--mcp"],"env":{"OPENAI_API_KEY":"${OPENAI_API_KEY}"}}]
#
# Both at once (one line, one array):
# MCP_SERVERS=[{"name":"desktop_commander","command":"npx","args":["-y","@wonderwhy-er/desktop-commander@latest"]},{"name":"browser_use","command":"uvx","args":["--from","browser-use[cli]","browser-use","--mcp"],"env":{"OPENAI_API_KEY":"${OPENAI_API_KEY}"}}]
#
# TencentDB Agent Memory (TAM) — Wiki + Code-Graph only. TAM's MCP surface
# exposes 12 read-only tools (wiki_search/read/list/graph, code_search/explore/
# callers/callees/impact/node/status/files). Chat Memory + Skill are NOT MCP
# tools in TAM (they live on separate REST routes) and are deliberately not
# bridged — MYTHOS's local episodic/semantic/skills are richer and feed the
# learning loop natively. This takes the one genuinely-better-than-local part:
# real symbol/call-graph/impact analysis that from-code-search.js doesn't do.
# tam-bridge.js is a stdio↔HTTP shim (MYTHOS's client is stdio-only; TAM is HTTP
# on :8424). Reachable as mcp__hub__code_callers etc. Empty/absent TAM_* env →
# the bridge returns an empty tool list and MYTHOS boots normally (fail-closed).
# Requires TAM running (deploy/global-images/start-all.sh) + a service id + a
# per-user sk-mem-... key issued via the Memory Hub.
# MCP_SERVERS=[{"name":"hub","command":"node","args":["adapters/mcp-client/tam-bridge.js"],"env":{"TAM_BASE_URL":"http://127.0.0.1:8424","TAM_SERVICE_ID":"<knowledge-instance-id>","TAM_USER_KEY":"${TAM_USER_KEY}"},"autostart":true}]
#
# headroom (https://github.com/headroomlabs-ai/headroom, Apache-2.0) — context
# compression. Compresses tool output, logs, files and RAG chunks before they
# reach a model; headroom_retrieve pulls the original back when the model needs
# it, so compression is reversible rather than lossy-and-forgotten. Exposes
# headroom_compress / headroom_retrieve / headroom_stats.
#
# Install project-local, NOT globally:
#   python -m venv .venv
#   .venv/Scripts/activate          (Windows)  |  source .venv/bin/activate
#   pip install "headroom-ai[all]"
# Then point `command` at the venv's headroom executable. The path below is
# relative to the repo root on purpose — do not paste an absolute path from your
# own machine into a tracked file.
# MCP_SERVERS=[{"name":"headroom","command":".venv/Scripts/headroom.exe","args":["mcp","serve"],"autostart":true}]
#
# WHAT THIS DOES AND DOES NOT BUY YOU. Every MCP call is tier 3 and mcp_call_tool
# is on the leash's NEVER_TRUSTABLE list, so this is compression ON REQUEST — it
# does not silently shrink MYTHOS's own per-turn prompt. If you want automatic
# savings on the hot path, headroom also ships a proxy (`headroom proxy --port
# 8787`) you can point the provider base URLs at; that is zero-code but routes
# every brain call through a local process, so treat it as a deliberate choice
# rather than a default. Neither mode is enabled out of the box.
#
# Optional second gate: only these fully-qualified tools may be called.
# Separate with ; , or newlines. Empty = every advertised tool is callable.
# MCP_TOOL_ALLOWLIST=mcp__desktop_commander__start_process;mcp__desktop_commander__interact_with_process;mcp__desktop_commander__start_search
# MCP_TOOL_ALLOWLIST=mcp__headroom__headroom_compress;mcp__headroom__headroom_retrieve;mcp__headroom__headroom_stats
# MCP_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Strix security scanning — the `security_scan` tool (effectors/from-strix.js).
# ---------------------------------------------------------------------------
# Optional. Absent Strix or Docker → the tool reports an install hint and never
# blocks boot. Install with `pip install strix-agent` (Python >=3.12 + a running
# Docker daemon).
#
# STRIX_LLM / LLM_API_KEY are the operator's OWN LLM credentials — Strix bills
# against them, not MYTHOS's brain keys. These only decide whether an authorized
# run can execute; the tool still REFUSES any call that lacks a per-call
# `authorized_by` stating you own or have written permission to test the target.
# Scanning a target you do not control is unlawful — this gate is not optional.
# STRIX_LLM=openai/gpt-5.4
# LLM_API_KEY=your-own-llm-key
# LLM_API_BASE=            # optional OpenAI-compatible proxy base URL
# STRIX_TIMEOUT_MS=1800000 # 30 min; real runs are long
# PERPLEXITY_API_KEY=      # optional research backend Strix can use

# web_search effector — optional provider. With a key set, Exa's REST API is
# tried after the local daemon below (higher rate limits, better snippets).
# See src/core/effectors/web-search.js for the full chain order.
# EXA_API_KEY=

# Jina AI search (s.jina.ai) — optional, BUG-302. Jina withdrew its no-key tier
# (measured HTTP 401 on 2026-08-20 and again on 2026-08-21) and this rung had no
# way to present a credential at all, so it was permanently failing. With a key
# it works again; without one the rung still tries, still gets 401, and still
# reports it honestly — nothing was removed to add this.
#
# Worth setting because the keyless options are not holding: on 2026-08-21 every
# engine the local daemon supports refused within a single day (startpage token
# extraction failed, bing 301, brave 429, DuckDuckGo serves a CAPTCHA, baidu
# socket hang up) — and startpage had worked that same morning. Anything keyless
# is a scrape, and every scrape is one anti-bot update from dead. A keyed
# provider is the only part of this chain that does not depend on not being
# noticed.
#
# The key travels in an Authorization header, never in the URL — a query string
# ends up in logs, proxies, and the health.anomaly payloads this rung emits.
# JINA_API_KEY=

# ---------------------------------------------------------------------------
# Local web-search daemon (BUG-280) — STRONGLY RECOMMENDED, no API key
# ---------------------------------------------------------------------------
# Measured 2026-08-20: every keyless provider in the chain had stopped working.
# The Exa free tier (150/day) was spent, Jina had removed its no-key tier
# (HTTP 401), and both DuckDuckGo hosts had started answering HTTP 202 with a
# CAPTCHA page — "Select all squares containing a duck" — which is a deliberate
# refusal to serve bots and is respected here rather than worked around.
# Search returned "All search providers are unavailable" for every query.
#
# The fix is an adopted, keyless, self-hosted search daemon rather than more
# scraping of our own. It is OPTIONAL in exactly the way cua-driver is: if it
# is not running, the rung reports the refused connection and the chain carries
# on to the other providers. Nothing breaks without it; search is just worse.
#
# INSTALL IT — one command, project-local, gitignored:
#
#   node mythos/scripts/setup-websearch.js --install
#   node mythos/scripts/setup-websearch.js --check     (is it there?)
#
# MYTHOS then starts and stops the daemon itself, as it does for Piper and
# edge-tts (look for websearch.started in the log). Nothing else to run.
#
# WHY A SCRIPT AND NOT THESE TWO LINES, which is what this block used to say:
#
#   npm install open-websearch          (in a directory of your choosing)
#   npx open-websearch serve --host 127.0.0.1 --port 3100
#
# Because nobody ran them. BUG-288, measured 2026-08-21 from the operator's own
# audit vault: the rung shipped, this comment shipped, the daemon was never
# installed, and for a day every single web_search answered from the chain's
# last rung — Wikipedia. "Kolkata news today" returned the Kolkata city
# article; a request for a football result returned the 2023 final. All eight
# calls reported ok. An optional dependency that the product cannot install or
# start is not optional, it is absent.
#
# If you do run it by hand (WEB_SEARCH_LOCAL_AUTOSTART=false), the `serve`
# subcommand is load-bearing: without it the entrypoint starts the MCP server
# on the same port and answers POST /search with a 404 page — up, healthy and
# useless. WEB_SEARCH_LOCAL_ENTRY points at a build/index.js outside the repo.
# First search after boot may still miss it: cold start measured ~16s.
#
# open-webSearch is Apache-2.0 (LICENSE file in the published package; note its
# package.json omits the `license` field, so tooling may report "unknown").
# See THIRD_PARTY_NOTICES.md.
#
# Loopback only. A non-loopback value is REFUSED by name rather than used —
# this rung fetches a URL taken from configuration, and following one off-box
# would be an SSRF. Redirects are refused for the same reason.
# WEB_SEARCH_LOCAL_URL=http://127.0.0.1:3100
# WEB_SEARCH_LOCAL_AUTOSTART=true
# WEB_SEARCH_LOCAL_ENTRY=
#
# Which of the daemon's engines to ask, in order. Measured from one machine on
# 2026-08-20, driven through the daemon itself: startpage returned 3 relevant
# results; bing returned HTTP 301, baidu a socket hang up, brave HTTP 429,
# sogou an anti-bot page, and duckduckgo/csdn nothing. Your network will differ
# — bing in particular is widely reachable and worth adding if it works for
# you. Note that a raw request to an engine succeeding does NOT mean the
# daemon's parser for it works; test through the daemon.
# WEB_SEARCH_ENGINES=startpage
#
# Providers to skip entirely, comma-separated. Use this only for a provider you
# KNOW is permanently unreachable here — a corporate proxy, a national block.
# EMPTY BY DEFAULT AND IT SHOULD STAY THAT WAY: a default naming real providers
# would encode one machine's network into a tracked file, and every one of these
# is reachable from somewhere.
#
# You usually do NOT need this. Since 2026-08-26 the chain remembers a provider
# that FAULTS and skips it for progressively longer — a minute, then five, then
# an hour, then a day — and a single success restores it immediately. That
# handles an outage on its own; this setting is for the case where you already
# know the answer and would rather not pay even the first attempt.
#
# Names are provider KEYS, not the source labels in a result: local-websearch,
# exa, exa-mcp, you-mcp, ddg-html, ddg-lite, jina, google-news-rss, wikipedia.
#
# exa-mcp and you-mcp are the two KEYLESS rungs and need no configuration at
# all. They carry independent free daily quotas (Exa documents 150/day, You.com
# 100/day), which is the point of having both: one running out is a step down
# rather than a cliff onto the scrape rungs.
# WEB_SEARCH_DISABLED_PROVIDERS=

# Voice VAD (client-side mic speech-detection thresholds; exposed via /api/config/vad)
# VAD_SPEECH_RMS=0.035
# VAD_MIN_PEAK_RMS=0.06
# VAD_HOLD_TICKS=3
# VAD_SILENCE_MS=1800

# Which speech-detector voice-loop.js uses. Default 'rms' (the hand-tuned
# volume-threshold detector above, unchanged behavior for anyone who sets
# nothing). 'silero' runs Silero VAD (MIT, snakers4/silero-vad) client-side
# through onnxruntime — a trained speech/non-speech model instead of a volume
# threshold. Install the model once with:
#   node mythos/scripts/setup-silero.js
# (downloads ~2.2MB into ui/public/models/silero/, gitignored, per-machine —
# same convention as scripts/setup-wakeword.js). Then set VAD_ENGINE=silero
# and restart. NOTE: VAD_SPEECH_RMS/VAD_MIN_PEAK_RMS above are read as speech
# PROBABILITY thresholds (0..1) when silero is active, not RMS amplitude —
# voice-loop.js applies its own sane probability defaults if you don't
# override them, but a value tuned for 'rms' (e.g. 0.035) means something
# very different here.
# VAD_ENGINE=rms

# Effectors & sensors
# MYTHOS_BUILD_CONCURRENCY=3
# MYTHOS_JOBS_MAX_PERSISTED=100
# MYTHOS_WATCH_DIRS=
# MYTHOS_FILE_DEBOUNCE_MS=500

# Notes directory (note_take / note_read / note_search). Plain Obsidian-flavoured
# markdown — one .md per note, YAML frontmatter, [[wikilinks]] kept verbatim.
# Unset = <vault>/Notes. Point it at an existing Obsidian vault folder and the
# notes MYTHOS writes appear there directly; no Obsidian plugin or CLI required.
# MYTHOS_NOTES_DIR=

# Build refine loop. After a build passes the source verifier, MYTHOS renders the
# artifact in real headless Chrome, screenshots it, and asks the vision lane
# whether it actually runs, meets the brief and looks designed — regenerating with
# that critique when it does not. Bounded, and the job record carries every
# screenshot + verdict so refinement is visible rather than claimed.
# Needs an installed Chrome/Edge (or CHROME_PATH) and a live vision model; absent
# either, the build still ships and the job says refinement was skipped and why.
# BUILD_REFINE_ENABLED=true
# BUILD_REFINE_MAX_ITERATIONS=2

# Gmail triage sensor
# GMAIL_TRIAGE_ENABLED=true
# GMAIL_TRIAGE_POLL_MS=300000
# BUG-111: how often the sensor polls gmail_unread. 'boot-once' (default) runs
# a single pass at startup then stops its timer -- gmail_unread still answers
# any explicit request, since that is the effector, not this sensor. 'poll'
# is the pre-2026-08-05 always-on behaviour; 'off' disables the sensor
# entirely. A stored `remember` preference can't stop code that runs on a
# timer, so this has to be a config decision, not a memory note.
# GMAIL_TRIAGE_MODE=boot-once

# Android ADB bridge (Task 8-10, Wave 2) — OPTIONAL. adapters/android-child
# probes `adb version` at boot; if adb isn't found, the adapter degrades to
# OFFLINE with an install hint and boot continues unaffected (AD-9) — every
# phone_* tool then fails honestly instead of the process failing to start.
#
# INSTALL (once, per machine that wants phone control):
#   node mythos/scripts/setup-android.js --install
#   node mythos/scripts/setup-android.js            (--check status/devices)
# It downloads Google's official platform-tools zip into
# <repo>/Android Platform Tools/ (gitignored) — never curl|bash / iex(irm).
#
# PAIRING (Android 11+ Wireless Debugging — the pairing code is shown on the
# phone itself, Settings > Developer options > Wireless debugging; no script
# can read or automate that on-phone step):
#   node mythos/scripts/setup-android.js --pair <ip:port> <code>
#   node mythos/scripts/setup-android.js --connect <ip:port>
# --connect persists the address to vault/Identity/android-devices.json (a
# growing device list, not a static secret, hence vault rather than here).
# Recommend a router DHCP reservation for paired phones — a renewed lease
# silently breaks every phone_* tool until reconnected.
#
# ANDROID_ADB_BIN: absolute path to adb if it isn't on PATH — --install
# prints the exact value to set here.
# ANDROID_ADB_BIN=adb
# ANDROID_ADB_POLL_MS=8000
# ANDROID_CMD_TIMEOUT_MS=15000

# WhatsApp Desktop (whatsapp_send) — no env key needed, but messaging someone by
# NAME needs a contacts file. It lives in the vault, not here, because phone
# numbers are personal data that must never be committed:
#
#   vault/Contacts/contacts.json
#   { "dad": "+15551234567", "mom": "+15559876543" }
#
# Numbers are E.164 (leading +, country code). Without the file you can still
# say the number itself ("whatsapp +1 555 123 4567 saying hi"); an unknown name
# fails honestly and lists the names it does know. Requires WhatsApp Desktop
# installed — the tool opens the exact chat via WhatsApp's own
# whatsapp://send?phone= deep link rather than automating its UI.

# Engagement layer
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Forge (multi-file agentic build pipeline — drives the build engine, see the
# DSH_* build-driver keys above)
# FORGE_MAX_FILES=12
# Checkpoints (workflow approval gates — distinct from LEASH_CONFIRM_TTL_MS)
# CHECKPOINT_TTL_MS=1800000
# CHECKPOINT_SWEEP_MS=60000
# CHECKPOINT_EVERY_TICKS=50

# MCP server (opt-in stdio JSON-RPC tool catalog)
# MCP_SERVER_ENABLED=false

# YouTube embed mode (BUG-006 escape hatch)
# YOUTUBE_MODE=electron            # 'electron' (in-app window), 'embed' (iframe), 'newtab' (browser tab)

# Agent skills — where MYTHOS looks for installed SKILL.md packs and their
# runnable tooling (mythos/skills.allowlist selects WHICH ones it surfaces).
# Repo-vendored skills under mythos/skills/ always resolve first so a fresh
# clone works with zero installs. Beyond that, MYTHOS searches, in order:
#   $MYTHOS_SKILLS_DIR (below)
#   <home>/.claude/skills                                 (personal skills)
#   <home>/.claude/plugins/marketplaces/*/src             (plugin packs)
#   <home>/.claude/plugins/marketplaces/*/.claude/skills  (nested layout)
#   <home>/.zcode/skills
# Set this only if your skills live somewhere else. Accepts several paths
# separated by the platform delimiter (';' on Windows, ':' elsewhere) and they
# are searched before all the built-in locations.
# To see exactly where MYTHOS looked, call loader.externalSkillRoots().
# MYTHOS_SKILLS_DIR=

# Aether-BLE proximity-focus sensor (src/core/sensors/aether.js). Pulls the
# Aether aggregator's `election` broadcast — nearest device = owner — and emits
# perception.aether on owner-change / RSSI drift, surfaced in the HUD "NEAREST
# DEVICE" widget. OFF by default; point AETHER_WS_URL at the aggregator (:8766),
# NOT the raw scanner bridge (:8765). Agent_OS is just another dashboard client
# of the aggregator, so no Python-side config is needed.
# AETHER_ENABLED=false
# AETHER_WS_URL=ws://127.0.0.1:8766
# 
# Phase 2 — route voice output to the nearest Aether device instead of the
# local TTS chain: every proactiveSpeak()/spoken reply is sent as a `say` to
# the aggregator, which generates TTS and assigns the utterance to the current
# owner. The HUD still captions the reply; the local machine stays silent.
# Falls back to local TTS automatically when the aggregator socket is down.
# AETHER_AUDIO_ROUTE=false
#
# ---------------------------------------------------------------------------
# Voice Nodes — phones as Aether scanners and audio endpoints
# ---------------------------------------------------------------------------
# Aether's topology (PROTOCOL.md §2) is a star where the AGGREGATOR dials out
# to each scanner, so a conformant scanner has to serve its own WebSocket. A
# phone can't: its IP roams, doze kills listeners, and no port is stable. So
# MYTHOS stands up one loopback WS server per phone ("scanner-proxy") and
# republishes whatever that phone pushes — over the phone's OWN outbound socket
# to /ws — in §4.1 `reading` / §4.2 `lost` shape. The aggregator dials the
# proxy; the phone dials MYTHOS. No Python-side change, no edit to Aether-BLE.
#
# AETHER_NODE_IDS is comma-separated and ITS ORDER DECIDES THE PORTS: first id
# -> AETHER_PROXY_PORT_BASE, second -> base+1, and so on. The aggregator's
# --peers must list them in that same order, e.g. for
#   AETHER_NODE_IDS=kitchen-phone,desk-phone
#   AETHER_PROXY_PORT_BASE=4480
# run:
#   python aggregator.py --peers ws://127.0.0.1:8765,ws://127.0.0.1:4480,ws://127.0.0.1:4481
# (8765 being the laptop's own bridge.py, unchanged). Each id must also be what
# the phone app sends as its node id — one string per device, everywhere.
# AETHER_PROXY_ENABLED=false
# AETHER_PROXY_PORT_BASE=4480
# AETHER_NODE_IDS=
#
# Phones are not browsers: OkHttp sends no Origin header, and the WS upgrade
# gate rejects "no Origin + non-loopback" outright (V2 §7.2) before it ever
# looks at a token — so no combination of ALLOWED_ORIGINS lets a phone in. This
# flag adds the one branch that does. It is a deliberate relaxation of that
# rule, so: OFF by default, and a valid MYTHOS_AUTH_TOKEN is MANDATORY for
# every request it admits (unlike the loopback path, where an unset token means
# "no auth configured"). No token => no node access, flag or not.
#
# Reaching MYTHOS from a phone at all also needs a non-loopback bind, and the
# boot guard already refuses that without a token:
#   MYTHOS_BIND=0.0.0.0
#   MYTHOS_AUTH_TOKEN=<a long random string>
# Only do this on a LAN you trust — PROTOCOL.md §11.4 defers transport
# encryption, and this exposes the same 100+ tools the token guards.
# AETHER_NODE_TRUST=false
#
# Speak through the elected node. MYTHOS synthesizes exactly as it does today and
# delivers the speech-chunk stream to whichever phone Aether currently names as
# owner; the HUD still captions the reply, and the local speakers stay quiet.
#
# Not the same thing as AETHER_AUDIO_ROUTE above. That one hands the TEXT to the
# aggregator and lets IT synthesize, on whatever machine the aggregator runs on.
# This one keeps MYTHOS's own voice and only changes which speaker it comes out
# of — so if both are set, the node wins.
#
# Precedence, highest first: an open Gemini Live session (its own PCM playback IS
# the entity's voice — two would overlap), then an elected voice node, then the
# aggregator's TTS, then the local chain. Falls back to local audio whenever no
# node is elected, the elected device never identified itself, or its socket is
# closed — a missing phone must never swallow a reply.
# AETHER_NODE_AUDIO=false
#
# Wake arbitration (voice nodes). Each device runs its own wake-word detector, so
# a phrase spoken in a hallway is heard by several at once. None of them decides:
# each REPORTS what it heard, MYTHOS asks the aggregator to rank them (the only
# component holding every scanner's RSSI), and the single ACCEPTED device opens
# its microphone while the rest stand down. No configuration is needed for phones
# — it follows from AETHER_ENABLED plus the node setup above.
#
# The desktop is a scanner in that mesh too (your own bridge.py), so it should
# win or lose the same arbitration; otherwise the wake phrase opens a turn on the
# PC *as well as* the kitchen phone. MYTHOS cannot infer which scanner id is this
# machine — the scanner is a separate process you start, and the aggregator only
# reports ids — so name it here. It is whatever you pass to
# `bridge.py --scanner <id>`, conventionally PC.
#
# Unset (the default), the desktop wake word behaves exactly as it always has.
# Set, the HUD competes. Either way it FAILS OPEN: no verdict within ~700ms, or
# this scanner absent from the election, and the desktop proceeds — a wake word
# that goes deaf waiting for the network is worse than one that answers twice.
# AETHER_LOCAL_SCANNER_ID=
#
# NO WAKE-WORD MODEL SHIPS IN THE PHONE APP, deliberately. Wake-word weights are
# frequently licensed apart from the code that runs them — MYTHOS's own
# openWakeWord weights are CC BY-NC-SA 4.0 (non-commercial) while its code is
# Apache-2.0 — so the app loads a model the operator supplies instead:
#   adb push <model> /sdcard/Android/data/com.mythos.nodes.phone/files/wakeword/
# With no model the node says so on screen and push-to-talk still works; it never
# pretends to be listening. See nodes/README.md.

# ---------------------------------------------------------------------------
# PREVIOUSLY UNDOCUMENTED, ADDED 2026-08-19
# ---------------------------------------------------------------------------
# Found by diffing `process.env.X` across every tracked source file against the
# names documented in this file. All of these were read by shipping code and
# named nowhere a user would look — which for the TAM_* trio meant an entire MCP
# bridge had no discoverable configuration surface at all.
#
# Deliberately NOT listed: variables read only by dev/verification scripts
# (E2E_*, VERIFY_*, AGG_*, PLAYWRIGHT_BROWSERS_PATH, SYNC_TEST_COUNT_NO_STDIN,
# CLAUDE_SCRATCHPAD_DIR) and values the installer/build stamps in rather than
# the operator setting (MYTHOS_APP_VERSION, MYTHOS_BUILD_TIME,
# MYTHOS_UPDATE_RESULT, RENDER). Those are omissions on purpose, not gaps.

# --- TAM MCP bridge (adapters/mcp-client/tam-bridge.js) --------------------
# The bridge stays inert unless all three are set; no key, no feature.
# TAM_BASE_URL=
# TAM_SERVICE_ID=
# TAM_USER_KEY=

# --- Paths MYTHOS will derive from the repo/profile if you leave them unset ---
# Where the DeepSeek Harness build engine is installed. Default:
# <repo>/DeepSeek Harness/, or <MYTHOS_TOOLS_DIR>/DeepSeek Harness for a packaged
# install (userData survives an update; the repo root does not — an NSIS update
# was measured removing 23,283 files from it). Created by
# `node mythos/scripts/setup-dsh.js --install`. Both are searched on read.
# MYTHOS_DSH_INSTALL_DIR=
# Where dsh keeps its own profile/credential state. Defaults to a MYTHOS-owned
# directory under LOCALAPPDATA so a build can never mutate the operator own dsh
# profiles. Set only to relocate it.
# MYTHOS_DSH_HOME=
# Where dsh_task creates its per-task sandboxed workspaces. These are NOT deleted
# afterwards — an agent task output is the point of running it.
# MYTHOS_DSH_TASK_ROOT=
# Directory of persona .md files loaded by src/core/agents/personas.js. A loader
# pointed at a directory that does not exist returns null forever and every seat
# degrades silently, so set this only if you have moved them.
# MYTHOS_PERSONAS_DIR=
# Where setup-android.js puts platform-tools (adb).
# MYTHOS_TOOLS_DIR=

# --- Timeouts and limits (all have working defaults) ------------------------
# Largest WebSocket frame the server will accept, in bytes. Default 16 MiB.
# Sized above the biggest legitimate frame (a vision-query carrying a base64
# webcam JPEG); the ws library default is 100 MiB, which is not a bound worth
# having. An over-sized frame closes the socket with code 1009.
# WS_MAX_PAYLOAD_BYTES=16777216
# New WS upgrades allowed per rate-limit window. Default 30.
# RATE_LIMIT_WS_UPGRADE=30
# Groq speech-to-text request bound, ms. Default 20000. This is what lets the
# STT chain fall through to on-device Whisper instead of hanging forever.
# GROQ_STT_TIMEOUT_MS=20000
# Gmail/Calendar/OAuth request bound, ms. Default 20000.
# GOOGLE_HTTP_TIMEOUT_MS=20000
# How long pc-child gets to complete its startup handshake, ms.
# PC_CHILD_STARTUP_TIMEOUT_MS=
# Backoff between pc-child restart attempts, ms.
# PC_CHILD_RESTART_BACKOFF_MS=

# --- Miscellaneous --------------------------------------------------------
# Base URL of the Piper TTS sidecar. Default http://127.0.0.1:5051.
# PIPER_URL=
# Default voice the edge-tts sidecar uses when a request names none.
# EDGE_TTS_DEFAULT_VOICE=
# Explicit browser binary for from-browser.js, when auto-detection picks wrong.
# BROWSER_EXECUTABLE=
# Set false to disable the brain chain circuit breakers (diagnostics only —
# with these off a failing provider is retried instead of being stepped over).
# CHAIN_BREAKERS_ENABLED=true
# Set false to suppress spoken unknown/unreadable-settings notices (BUG-429).
VOICE_SETTINGS_WARNINGS_ENABLED=true
# BUG-426: after 3 all-timeout walks, cool affected pairs. Infinity restores the old exemption.
# Raw environment controls (not desktop config.json settings); restart after editing.
# CHAIN_WHOLE_LANE_TIMEOUT_STREAK_LIMIT=3
# BUG-420/427: 403/404 bench only the model for 24h; false disables model benching.
# PROVIDER_MODEL_HEALTH_ENABLED=true
# PROVIDER_MODEL_HEALTH_TTL_MS=86400000
# How long a whole PROVIDER stays benched after a provider-level failure
# (auth, quota, outage) before it is retried. Default 15 minutes.
# PROVIDER_HEALTH_TTL_MS=900000
# BUG-430: advise web_fetch after 4 searches in 120s without a read; false disables the caution.
# LIVE_SEARCH_STORM_GUARD_ENABLED=true

# Set false to roll back PR3 Live voice honesty (setup facts, progressive detection, silent-TTS guard, offline/completion notices).
# LIVE_VOICE_HONESTY_ENABLED=true
