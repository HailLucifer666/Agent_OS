# MYTHOS Entity Configuration
MYTHOS_NAME=MYTHOS
MYTHOS_PORT=4478
MYTHOS_BIND=127.0.0.1
# REQUIRED whenever MYTHOS_BIND is non-loopback (e.g. 0.0.0.0, as both
# Dockerfile and render.yaml set for cloud deployment). Server boot refuses
# to start with a clear error if the bind is non-loopback and this is unset —
# a cloud-deployed MYTHOS with no token would expose 107 tools (including T3
# confirm-and-execute) to anyone who finds the URL. Present it as either
# `Authorization: Bearer <token>` (any client) or a `mythos_token` cookie
# (the HUD sets this after the operator enters it once); the WS upgrade also
# accepts `?token=` since a browser WebSocket can't set headers. Unset (the
# default) = loopback-only mode, exercises none of the new auth code paths.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CAVEATS (security review, 2026-07-30): a token in `?token=` is exposed to
# whatever logs the request URL (the hosting platform's own access logs, any
# reverse proxy in front of it) — prefer the Authorization header wherever the
# client can set one; `?token=` exists only because a browser WebSocket
# can't. If a future frontend change sets the `mythos_token` cookie, it MUST
# set Secure (HTTPS-only) + SameSite=Lax/Strict, and should set HttpOnly
# unless page JS genuinely needs to read it back.
# MYTHOS_AUTH_TOKEN=
MYTHOS_VAULT_ROOT=./vault
MYTHOS_TICK_MS=1000
MYTHOS_IDLE_SALIENCE=0.3
MYTHOS_DRY_RUN=false

# Logging
LOG_LEVEL=info

# NOVA Passthrough (Brain providers)
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=
# GROQ_API_KEY=
# GROQ_API_URL=
# GROQ_MODEL=
# GROQ_STT_MODEL=whisper-large-v3-turbo  # voice input transcription (see providers/groq-stt.js)
# MISTRAL_API_KEY=
# MISTRAL_API_URL=
# MISTRAL_MODEL=
# NIM_API_KEY=
# NIM_API_KEY_2=
# NIM_API_URL=
# NIM_MODEL=
# ZCODE_API_KEY=
# ZCODE_API_URL=
# ZCODE_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_API_URL=
# OPENROUTER_KEEP_REASONING=   # set to 1 to keep chain-of-thought generation on.
#                              # Default excludes it: providers/openrouter.js only
#                              # reads delta.content, so reasoning tokens are billed
#                              # against quota and then discarded unread. Latency-
#                              # neutral (950ms vs 975ms median over 5 paired calls).
# CEREBRAS_API_KEY=
# CEREBRAS_API_URL=
# CEREBRAS_MODEL=
# Google Gemini via its OpenAI-compatible endpoint (providers/google.js — no
# separate adapter needed). Free keys have NO Pro-tier quota: gemini-2.5-pro /
# gemini-pro-latest / gemini-3.1-pro-preview all 429. Use Flash-tier models.
# GOOGLE_API_KEY=
# GOOGLE_API_URL=
# GOOGLE_MODEL=

# Semantic memory embeddings (local-first: Ollama nomic-embed-text, then
# Mistral's free embeddings endpoint; both down -> keyword-only recall)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed

# Brain lane overrides (optional escape hatches — comma-separated provider:model
# pairs, ranked best-first; leave unset to use lanes.default.js's built-in tables)
# CHAIN_VOICE=
# CHAIN_BUILD=
# CHAIN_SIMPLE=
# CHAIN_TEXT=
# CHAIN_VISION=
# CHAIN_EMBED=

# Voice reply TTS — local edge-tts service (Microsoft Neural voices, free/no key).
# Autostarted at boot when python + the edge-tts module are installed.
# VOICE_TTS_VOICE=en-GB-RyanNeural
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050

# Spoken JARVIS-style boot greeting on the first dashboard connection per boot
# (persona-voiced status brief; canned fallback when the brain is offline).
# Set to false to boot silently.
# BOOT_GREETING=true

# Learning loop: run a reflection pass (extract operator preferences + speaking
# style from recent conversations into vault/Identity/self.md) every N turns.
# REFLECTION_EVERY_TURNS=15

# Self-error explanation: when an anomaly has no healing playbook, speak a
# plain-language cause + safe remedy (suppress tool / re-probe providers /
# needs-human). Set to false to disable.
# IMMUNE_EXPLAIN=true

# hermes-agent (github.com/NousResearch/hermes-agent, MIT) — REQUIRED.
# As of 2026-07-29 Hermes is the ONLY build-content engine: build-runner.js
# (pipeline_execute / kanban_build_card / start_project / run_mission), the
# engagement executor's build stage, and Forge (build_project /
# revise_project) all generate through it. There is deliberately NO
# brain.think fallback — when Hermes is unavailable a build FAILS with an
# install hint rather than quietly producing a plausible-but-wrong artifact.
#
# INSTALL (once per clone):  node mythos/scripts/setup-hermes.js --install
# VERIFY:                    node mythos/scripts/setup-hermes.js
# It clones the repo into <repo>/Hermes Agent/hermes-agent and runs that
# clone's own installer with HERMES_HOME pointed at <repo>/Hermes Agent, so
# the install dir, its managed uv, its bundled PortableGit and Hermes's own
# config/credentials all stay inside the project (that dir is gitignored).
# Hermes provisions its OWN CPython 3.11, so your system Python version is
# irrelevant — a 3.14 system Python is fine even though Hermes pins <3.14.
#
# HERMES_CLI must be an ABSOLUTE path, not a bare `hermes`: a shim earlier on
# PATH (e.g. one forwarding into WSL) will otherwise win, and a .bat/.cmd shim
# cannot carry a build prompt — cmd.exe concatenates args unquoted and caps the
# command line at 8191 chars, while build prompts run to 24000. The adapter
# warns loudly if HERMES_CLI resolves to a .bat/.cmd.
# HERMES_CLI=/absolute/path/to/Hermes Agent/hermes-agent/venv/bin/hermes
# HERMES_TASK_TIMEOUT_MS=180000
#
# The HTTP gateway is a fallback for one-shot hermes_task only — it cannot be
# cwd-pinned, so builds always require the CLI.
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=
#
# Hermes's OWN model + provider key. Forwarded to the Hermes child as
# OPENAI_API_KEY/OPENAI_BASE_URL (the generic OpenAI-compatible shape it
# speaks; Mistral is OpenAI-shaped at https://api.mistral.ai/v1). Prefer a
# separate workspace key over reusing MISTRAL_API_KEY above: a 20-60-call
# build shares Mistral's workspace rate limit with memory consolidation, the
# boot greeting, and every realtime vision/voice call that also ranks Mistral
# — a shared key reintroduces the exact voice stutter this separation avoids.
# HERMES_PROVIDER_KEY=
# HERMES_PROVIDER_BASE_URL=https://api.mistral.ai/v1
# HERMES_INFERENCE_MODEL=mistral-large-2512
#
# GOTCHA (root-caused live 2026-07-29 against v0.19.0): these env vars are not
# the whole story. Hermes's own `<HERMES_HOME>/config.yaml` carries
# `model.provider`, `model.default` and `model.base_url`, and a fresh install
# defaults to OpenRouter — so pointing the env vars at another provider yields
# "HTTP 401: Missing Authentication header".
#
# THE FIX: `model.provider` must be `openai-api`. That is the registry id for
# generic API-key access (hermes_cli/auth.py PROVIDER_REGISTRY), and it is the
# one entry whose ProviderConfig declares
#   api_key_env_vars=("OPENAI_API_KEY",)  base_url_env_var="OPENAI_BASE_URL"
# i.e. exactly what this adapter forwards. `provider: openai` is NOT a registry
# id, and `custom` is a plugin rather than the generic key path — both of those
# authenticate as nobody and produce the 401 above. So for Mistral:
#   model:
#     provider: openai-api
#     default: mistral-large-2512
#     base_url: https://api.mistral.ai/v1
# `node mythos/scripts/setup-hermes.js` reports the resolved trio and warns when
# the provider is not openai-api. `hermes model` also works but is interactive.
#
# SEPARATE GOTCHA: Hermes prints provider errors to STDOUT AND EXITS 0, which is
# indistinguishable from a successful run — build-engine.js guards against that
# reply being filed as an artifact.
#
# Hermes build-driver timing (hermes-runner.js). Plan runs are short and
# sandboxed; builds run a real agent loop and need real headroom.
# HERMES_PLAN_TIMEOUT_MS=300000
# HERMES_BUILD_TIMEOUT_MS=1800000
# HERMES_POLL_MS=2000
# HERMES_BUILD_TERMINAL_ENV=local
# EDGE_TTS_AUTOSTART=true

# Voice agent max spoken reply length (chars). Raise for full reasoning paragraphs.
# VOICE_MAX_SAY_CHARS=800

# Conversation brain — idle reasoning frequency. During quiet moments the entity
# forms thoughts about the operator's situation (loose ends, follow-ups, observations).
# These surface naturally in the next conversation. 0 = disabled (zero-cost idle).
# MYTHOS_MULL_EVERY_TICKS=300

# get_weather tool default location ("lat,lon"), used when no location is
# spoken. Same Kolkata fallback the dashboard weather widget already uses —
# change to your real coordinates for accurate default weather reports.
# WEATHER_LOCATION=22.57,88.36

# Brain Timing
REFLECT_EVERY=60
CONSOLIDATE_EVERY=300
EPISODIC_RETENTION_DAYS=30
CHAIN_COOLDOWN_MS=60000
MODEL_REGISTRY_TTL_MS=300000

# Autonomy
AUTONOMOUS_MAX_TIER=2
GOAL_TOKEN_BUDGET=20000
GOAL_ACTION_BUDGET=25
MAX_ACTIVE_GOALS=5

# Immune
# REMEDIATION P2-9: was pinned at 5000 — copying this file to .env re-pinned
# the old pre-fix value and silently defeated config/schema.js's STALL_MS
# default bump to 30000 (lastTickAt isn't refreshed mid-tick, so a legitimate
# slow 'build'-lane brain call past 5s tripped the stall watchdog on healthy
# ticks). Kept explicit (matching this section's style) but now current.
STALL_MS=30000
WATCHDOG_MS=2000
BREAKER_FAIL_THRESHOLD=3
BREAKER_WINDOW_MS=30000
BREAKER_RESET_MS=15000

# Bus
BUS_HISTORY_SIZE=500
BUS_STORM_MAX=400

# Browser automation (playwright-core, drives installed Chrome/Edge)
# BROWSER_CDP_URL=http://127.0.0.1:9222
# BROWSER_AUTOMATION=true
# Auto-connect: while OFFLINE, retry the CDP connect on this interval (ms) so
# browser automation comes online the moment a debug Chrome exists, and
# re-attaches after a drop. Connect-only, never launches — zero mic risk.
# 0 disables the poller. Default 15000.
# BROWSER_RECONNECT_MS=15000
# Fully hands-off: launch a debug Chrome automatically AFTER boot (once voice/mic
# init has claimed the audio device, so it can't steal the mic). Off by default —
# with it off, a debug Chrome opens on demand (first browser tool, or ask MYTHOS
# to "open the browser") or when you run scripts/setup-chrome-debug.ps1.
# BROWSER_AUTO_LAUNCH=false
# Delay (ms) before the deferred auto-launch fires. Default 20000.
# BROWSER_AUTO_LAUNCH_DELAY_MS=20000

# Google OAuth (Gmail + Calendar adapters). Full operator walkthrough:
#   docs/google-oauth-setup.md   (Cloud Console project, consent screen, scopes)
# Mint the refresh token with:  node scripts/google-auth.js
# (Phase 3 / BUG-024: the script now requests calendar.readonly too — re-mint if
# your existing token predates 2026-07-19, or Calendar reads will 403.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Engagement Layer (structured task lifecycle — interview intake through completion)
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Wake-word — hands-free "hey jarvis" activation (on-device ONNX, no cloud).
# Opt-in and off by default. The pretrained openWakeWord models are CC BY-NC-SA
# so they are never committed to this repo; fetch them yourself once with:
#   node scripts/setup-wakeword.js
# then set WAKEWORD_ENABLED=true and restart. WAKEWORD_THRESHOLD is the
# 0.1-0.95 score cutoff that counts as a detected wake word (higher = fewer
# false triggers, more missed activations).
# WAKEWORD_ENABLED=false
# WAKEWORD_THRESHOLD=0.5

# Ambient screen awareness — periodic screenshot -> vision-description sensor
# feeding the perception loop (src/core/sensors/screen-sensor.js). Opt-in and
# off by default. An unchanged screen (sha1 hash match) never triggers a vision
# call. Raw screenshot bytes are NEVER written to disk — only the text
# description flows onward. Toggle live with the voice/tool command
# "watch my screen" / "stop watching my screen" (ambient_awareness tool).
# SCREEN_AWARENESS_ENABLED=false
# SCREEN_AWARENESS_POLL_MS=30000
# SCREEN_AWARENESS_SALIENCE=0.3

# Native speech-to-speech voice (Gemini Live, BidiGenerateContent). Opt-in and
# OFF by default — voice-agent.js's existing batch Whisper-STT path is the
# untouched fallback with zero behavior change until this is flipped; setting
# it back to false is a total rollback (V2 §16), no code revert needed.
# Requires a real GOOGLE_API_KEY with Live API access — run
# node scripts/verify-gemini-live.js first to confirm your key can reach it.
# VOICE_S2S_ENABLED=false
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
#
# GEMINI_LIVE_VOICE — one of Aoede | Kore | Leda | Zephyr | Puck | Charon.
# Kept at Google's own suggested assistant-style default, Aoede, because
# picking between them properly means auditioning each by ear against real
# speakers — a step that needs a human operator and cannot be done in this
# build environment. This default is fully operator-overridable: set this key
# once you've listened to a few turns and have a preference.
# GEMINI_LIVE_VOICE=Aoede
#
# LIVE_IDLE_TIMEOUT_MS closes the duplex socket after this much silence (cost
# gate — continuous audio bills for open-mic time, unlike today's per-utterance
# batch path). LIVE_SESSION_MAX_MS hard-caps wall-clock per session (the
# connection dies at ~10 minutes regardless per Gemini's own limits).
# LIVE_IDLE_TIMEOUT_MS=45000
# LIVE_SESSION_MAX_MS=600000
#
# LIVE_TOOL_ALLOWLIST — comma-separated tool names exposed to the Live
# session's functionDeclarations. Empty (default) uses live-tools.js's curated
# high-traffic set — function-calling accuracy degrades with MYTHOS's full 107
# registered tools, so this is a deliberate subset, not a cap you need to lift.
# LIVE_TOOL_ALLOWLIST=

# Daily planning + accountability — morning brief, stall check-ins, evening
# review over the existing Goals system (src/core/planner/daily.js). On by
# default (no camera/mic/screen capture involved). Say "be stricter with me"
# to raise the strictness persona dial and harden the check-in tone.
# PLANNER_ENABLED=true
# PLANNER_MORNING_HOUR=9
# PLANNER_EVENING_HOUR=21
# PLANNER_CHECKIN_EVERY_MS=10800000

# ---- W8 (Phase 2 — Wiring Integrity): previously-undocumented schema keys.
# All schema-defined (see src/core/config/schema.js); documented here for
# discoverability. Commented = the schema default is in effect. ----

# Action dispatch / leash / lifecycle
# ACTION_TIMEOUT_MS=30000          # bounds a single dispatchAction() call
# LEASH_CONFIRM_TTL_MS=30000       # confirm popup auto-dismiss
# SHUTDOWN_MS=10000                # graceful-shutdown hard-exit backstop
# MAX_DRAIN_PER_TICK=50            # perception cap per cortex tick (§11.1)

# Server rate limiting + WS/CORS allowlist
# RATE_LIMIT_GLOBAL=240            # /api/* requests per minute
# RATE_LIMIT_EXPENSIVE=8           # /api/voice/transcribe per minute
# ALLOWED_ORIGINS=                 # comma-sep WS/CORS allowlist (P4 — Render hostname)

# Brain chain tuning
# CHAIN_ATTEMPT_TIMEOUT_MS=30000   # per-provider-attempt timeout (distinct from ACTION_TIMEOUT_MS)
# VOICE_OLLAMA_KEEP_ALIVE=10m      # ollama vision-lane keep-alive

# Voice loop
# VOICE_RECALL_TIMEOUT_MS=3500     # RAG recall bound before reply
# VOICE_INTAKE_IDLE_MS=600000      # idle conversation history retention
# VOICE_MAX_TOOL_ITERATIONS=4      # tool-call rounds per voice turn
# VOICE_EMAIL_MODE=gmail           # 'gmail' (adapter) or 'mailto' (open client)
# Semicolon-separated sandbox roots for open_folder/list_folder/read_file (the
# project root is always included). Add more roots with ";", e.g.
# %USERPROFILE%;D:\Some\Folder
# VOICE_ALLOWED_DIRS=%USERPROFILE%

# Speech cadence
# ANNOUNCER_REANNOUNCE_MS=600000   # immune announcer dedup cooldown (BUG-030)
# MYTHOS_LOG_PRETTY=               # 'force' = on when piped, 'false' = off

# Embeddings / STT model overrides (free-tier default models)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Provider URL overrides (default to the official endpoints)
# NIM_API_URL=https://integrate.api.nvidia.com/v1
# GROQ_API_URL=https://api.groq.com/openai/v1
# MISTRAL_API_URL=https://api.mistral.ai/v1
# CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Edge-TTS child service
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050
# EDGE_TTS_AUTOSTART=              # 'false' = don't spawn at boot

# Phase 3 (V7) — run_command effector. Allow-listed shell commands for build
# verification (engagement verify-stages + Forge verify-stages). Empty = disabled
# (fail-closed). Format: 'cmd:flag,flag;cmd2:flag;cmd3' — semicolons between
# commands, colon precedes a command's allowed flags, commas between flags.
# Keep minimal; NEVER allow sh/bash/cmd/powershell. v1 is allowlist+timeout,
# NOT a full sandbox — see mythos/src/core/effectors/from-runner.js.
# RUN_COMMAND_ALLOWLIST=npm:test,install,run;node:--version;git:status,diff,log
# RUN_COMMAND_TIMEOUT_MS=60000

# install_from_github effector — shares the RUN_COMMAND_ALLOWLIST gate above, so
# it is disabled (fail-closed) whenever that list is empty. It needs 'git' plus
# whichever package manager the target repo uses:
#   RUN_COMMAND_ALLOWLIST=git;npm;pip;cargo;go
# TRADE-OFF TO UNDERSTAND BEFORE SETTING THIS: the allowlist is shared, so
# allow-listing these also lets the generic run_command tool invoke them with
# arbitrary arguments (still T3 confirm-gated). Entries without a colon permit
# ANY args for that command — use the 'cmd:flag,flag' form to narrow them.
# Clones land in vault/builds/installs/<repo>. The effector never executes a
# repo's install.sh/Makefile — only git + package-manager commands.
# INSTALL_TIMEOUT_MS is separate from RUN_COMMAND_TIMEOUT_MS because a real
# `npm install`/`pip install .` routinely exceeds the 60s command default.
# INSTALL_TIMEOUT_MS=600000

# Agent-Reach CLI (optional, external) — absolute path to the agent-reach binary
# for a future web_reach effector. Not required by anything today; MYTHOS does
# not spawn it yet. Left unset = feature absent, no error.
# AGENT_REACH_BIN=/path/to/.venv/bin/agent-reach

# Voice VAD (client-side mic speech-detection thresholds; exposed via /api/config/vad)
# VAD_SPEECH_RMS=0.035
# VAD_MIN_PEAK_RMS=0.06
# VAD_HOLD_TICKS=3
# VAD_SILENCE_MS=1800

# Effectors & sensors
# MYTHOS_BUILD_CONCURRENCY=3
# MYTHOS_JOBS_MAX_PERSISTED=100
# MYTHOS_WATCH_DIRS=
# MYTHOS_FILE_DEBOUNCE_MS=500

# Gmail triage sensor
# GMAIL_TRIAGE_ENABLED=true
# GMAIL_TRIAGE_POLL_MS=300000

# Engagement layer
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Forge (multi-file agentic build pipeline — drives Hermes, see the HERMES_*
# build-driver keys above)
# FORGE_MAX_FILES=12
# Checkpoints (workflow approval gates — distinct from LEASH_CONFIRM_TTL_MS)
# CHECKPOINT_TTL_MS=1800000
# CHECKPOINT_SWEEP_MS=60000
# CHECKPOINT_EVERY_TICKS=50

# MCP server (opt-in stdio JSON-RPC tool catalog)
# MCP_SERVER_ENABLED=false

# YouTube embed mode (BUG-006 escape hatch)
# YOUTUBE_MODE=embed               # 'embed' (iframe) or 'newtab' (browser tab)
