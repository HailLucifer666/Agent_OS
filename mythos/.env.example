# MYTHOS Entity Configuration
MYTHOS_NAME=MYTHOS
MYTHOS_PORT=4478
MYTHOS_BIND=127.0.0.1
# REQUIRED whenever MYTHOS_BIND is non-loopback (e.g. 0.0.0.0, as both
# Dockerfile and render.yaml set for cloud deployment). Server boot refuses
# to start with a clear error if the bind is non-loopback and this is unset —
# a cloud-deployed MYTHOS with no token would expose 107 tools (including T3
# confirm-and-execute) to anyone who finds the URL. Present it as either
# `Authorization: Bearer <token>` (any client) or a `mythos_token` cookie
# (the HUD sets this after the operator enters it once); the WS upgrade also
# accepts `?token=` since a browser WebSocket can't set headers. Unset (the
# default) = loopback-only mode, exercises none of the new auth code paths.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CAVEATS (security review, 2026-07-30): a token in `?token=` is exposed to
# whatever logs the request URL (the hosting platform's own access logs, any
# reverse proxy in front of it) — prefer the Authorization header wherever the
# client can set one; `?token=` exists only because a browser WebSocket
# can't. If a future frontend change sets the `mythos_token` cookie, it MUST
# set Secure (HTTPS-only) + SameSite=Lax/Strict, and should set HttpOnly
# unless page JS genuinely needs to read it back.
# MYTHOS_AUTH_TOKEN=
#
# PIN_SESSION_ENFORCE — Track B1: makes the §7.3 PIN lock screen (the
# password-style overlay the HUD shows when a PIN is configured) into REAL
# server-side access control instead of a client-side visual/pointer
# deterrent. Until this existed, the overlay gated nothing on the server: with
# MYTHOS_AUTH_TOKEN unset (the default), tokenOk() passed every request, so
# `curl 127.0.0.1:4478/api/...` reached the full tool surface with no PIN
# prompt at all — anyone at the keyboard, or on the loopback interface, could
# skip the lock screen entirely.
#
# What this DOES protect once true AND a PIN is configured (via
# POST /api/pin/set): every /api/* route and the WebSocket upgrade both
# refuse a request that presents no valid session — a correct
# POST /api/pin/verify mints a real, CSPRNG server-side session and returns it
# as the mythos_token cookie, the same cookie extractToken() already checks
# for the bearer token. Session is short-lived and slides forward on activity
# (PIN_SESSION_TTL_MS below); a caller who already holds the real
# MYTHOS_AUTH_TOKEN is unaffected either way — that token and the PIN remain
# two independent layers (network-remote vs local-physical), neither
# subsuming the other.
#
# What this does NOT protect: it is still a single 4-12 digit PIN with a
# 5-attempt/60s lockout (src/core/security/pin-lock.js) — brute-force friction,
# not cryptographic strength. It does nothing for a non-loopback bind beyond
# what MYTHOS_AUTH_TOKEN already must do at boot (see above); set both for a
# remotely-reachable install.
#
# OFF by default so nothing changes for an existing install: a loopback bind
# with no token and no PIN configured (headless/Docker/Render, and every
# pre-existing test) behaves exactly as before, and even with this set true,
# a fresh install with no PIN yet stays open rather than locking the operator
# out of their own server.
# PIN_SESSION_ENFORCE=false
# How long a PIN-unlocked session stays valid with no further activity
# (sliding — extended on every authenticated request), ms. Default 30 min.
# PIN_SESSION_TTL_MS=1800000
MYTHOS_VAULT_ROOT=./vault
MYTHOS_TICK_MS=1000
MYTHOS_IDLE_SALIENCE=0.3
MYTHOS_DRY_RUN=false

# Logging
LOG_LEVEL=info

# NOVA Passthrough (Brain providers)
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=
# GROQ_API_KEY=
# GROQ_API_URL=
# GROQ_MODEL=
# GROQ_STT_MODEL=whisper-large-v3-turbo  # voice input transcription (see providers/groq-stt.js)
# MISTRAL_API_KEY=
# MISTRAL_API_URL=
# MISTRAL_MODEL=
# NIM_API_KEY=
# NIM_API_KEY_2=
# NIM_API_URL=
# NIM_MODEL=
# ZCODE_API_KEY=
# ZCODE_API_URL=
# ZCODE_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_API_URL=
# OPENROUTER_KEEP_REASONING=   # set to 1 to keep chain-of-thought generation on.
#                              # Default excludes it: providers/openrouter.js only
#                              # reads delta.content, so reasoning tokens are billed
#                              # against quota and then discarded unread. Latency-
#                              # neutral (950ms vs 975ms median over 5 paired calls).
# CEREBRAS_API_KEY=
# CEREBRAS_API_URL=
# CEREBRAS_MODEL=
# Google Gemini via its OpenAI-compatible endpoint (providers/google.js — no
# separate adapter needed). Free keys have NO Pro-tier quota: gemini-2.5-pro /
# gemini-pro-latest / gemini-3.1-pro-preview all 429. Use Flash-tier models.
# GOOGLE_API_KEY=
# GOOGLE_API_URL=
# GOOGLE_MODEL=

# Semantic memory embeddings (local-first: Ollama nomic-embed-text, then
# Mistral's free embeddings endpoint; both down -> keyword-only recall)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed

# Brain lane overrides (optional escape hatches — comma-separated provider:model
# pairs, ranked best-first; leave unset to use lanes.default.js's built-in tables)
# CHAIN_VOICE=
# CHAIN_BUILD=
# CHAIN_SIMPLE=
# CHAIN_TEXT=
# CHAIN_VISION=
# CHAIN_EMBED=

# Voice reply TTS — local edge-tts service (Microsoft Neural voices, free/no key).
# Autostarted at boot when python + the edge-tts module are installed.
#
# ONE ENTITY, ONE VOICE. Three engines speak in a single session — this one (boot
# greeting + batch replies), GEMINI_LIVE_VOICE (S2S duplex), and the browser's
# speechSynthesis fallback when edge-tts is down. They must match. Until
# 2026-07-31 this default was en-GB-RyanNeural (male) against Aoede (female), so
# the entity greeted you as a British man and then answered as a woman. If you
# change this, change GEMINI_LIVE_VOICE and voice-loop.js's PREFERRED_VOICES too;
# test/voice-identity-consistent.test.js fails if they drift apart.
# VOICE_TTS_VOICE=en-GB-SoniaNeural

# WHICH ENGINE SPEAKS the non-Live paths (boot greeting, proactive speech, batch
# replies). The Live/S2S path always uses GEMINI_LIVE_VOICE regardless.
#   edge   (default) - edge-tts. ~900ms/sentence, free, but an UNOFFICIAL
#                      Microsoft endpoint this repo labels personal/hobby-only.
#   gemini           - Gemini TTS (VOICE_TTS_PROVIDER=gemini). Uses the SAME
#                      prebuilt voice as the Live path, so the entity is one
#                      person everywhere instead of one voice for the greeting
#                      and another for the conversation. MEASURED ~3.9s/sentence
#                      on gemini-2.5-flash-preview-tts and it is METERED.
#                      (gemini-3.1-flash-tts-preview measured ~17.6s — avoid.)
# Note the voice ids are engine-specific and NOT interchangeable: edge wants
# 'en-GB-SoniaNeural', Gemini wants a prebuilt name like 'Aoede'. The selector
# picks the right key for you; sending the wrong one is a hard 400 per chunk.
# Licensing for a SOLD product is a separate question for a lawyer — see the
# roadmap's step 6.5 gate. Nothing here is a legal conclusion.
# VOICE_TTS_PROVIDER=edge
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ORDERED CHAIN (preferred over the single VOICE_TTS_PROVIDER above). Resolved ONCE
# per session and STICKY — the boot greeting, proactive speech and every reply all
# come from the same engine, and it only moves on a real failure, never flapping
# back. You should never hear the voice change partway through a session.
#   VOICE_TTS_CHAIN=gemini,edge,piper
#     gemini  Aoede — the SAME voice as the Live/S2S path. ~3.9s/sentence, metered.
#             MEASURED 2026-07-31 on a free key: gemini-2.5-flash-tts allows
#             10 requests/DAY, and every SENTENCE is one request. The quota dies
#             about two replies in, mid-reply, and the chain fails over to edge —
#             so you DO hear the voice change partway through, despite the
#             promise above. Put `edge` first (or use a paid key) if a consistent
#             voice matters more than this one.
#     edge    edge-tts Sonia. ~1011ms, free, unofficial MS endpoint (hobby-only).
#     piper   local, OFFLINE, ~350ms, free, MIT + open voices. The shippable one.
#     kokoro  local Kokoro-82M (onnxruntime, in-process, no child service).
#             OFFLINE after the model is cached. Apache-2.0 code AND weights —
#             see KOKORO_VOICE below and THIRD_PARTY_NOTICES.md.
# VOICE_TTS_CHAIN=

# Local Piper TTS (services/piper-server.py). Fully offline: no API, no key, no
# per-call cost — proven by blocking socket.connect/getaddrinfo and still getting
# audio, while edge-tts fails immediately under the same test. Voice models are
# ~60MB each, gitignored, installed per machine into mythos/models/piper.
# Measured US female voices: hfc_female 350ms, kristin 351ms, amy 379ms.
# PIPER_PORT=5051
# PIPER_VOICE=en_US-hfc_female-medium
# PIPER_MODEL_DIR=
# PIPER_AUTOSTART=            # 'false' = don't spawn at boot
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050

# Kokoro-82M TTS (providers/kokoro-tts.js). No child service — runs in-process
# via onnxruntime (kokoro-js + @huggingface/transformers, both Apache-2.0).
# Weights (~26MB q8, the default) download from Hugging Face on first use into
# mythos/models/kokoro/ (gitignored, per-machine, same convention as
# mythos/models/piper/). If the download stalls, the provider reports itself
# unavailable within ~15s so the chain falls through instead of hanging.
# KOKORO_VOICE=af_heart      # see kokoro-js's voice list for alternatives
# KOKORO_MODEL_DIR=          # override the cache dir
# KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_DTYPE=q8            # fp32 | fp16 | q8 | q4 | q4f16 — q8 is the size/quality default

# ORDERED STT CHAIN (providers/stt.js). Default 'groq': unchanged behaviour
# for anyone who sets nothing — /api/voice/transcribe used to call
# providers/groq-stt.js directly. Unlike VOICE_TTS_CHAIN there's no "sticky
# voice" concern (a wrong transcript for one utterance isn't an audible
# identity change), so every call just tries the chain fresh, first
# available wins.
#   VOICE_STT_CHAIN=groq,local
#     groq   Groq Whisper API. Needs GROQ_API_KEY + network.
#     local  On-device Whisper (providers/local-whisper-stt.js,
#            @huggingface/transformers). No network after the model is
#            cached, WAV audio only (see that file for why) — if a clip
#            arrives as webm/ogg it throws immediately and the chain falls
#            through to the next provider for that one utterance.
# KNOWN RISK: like Kokoro above, a Hugging Face download can stall
# indefinitely on this network. isAvailable() bounds the first cold-load
# attempt at ~15s so a stalled download reports unavailable instead of
# hanging the mic. Put 'local' AFTER 'groq' until you've confirmed the
# download completes on your own machine.
# VOICE_STT_CHAIN=
# WHISPER_MODEL_ID=onnx-community/whisper-base
# WHISPER_DTYPE=q8
# WHISPER_MODEL_DIR=          # override the cache dir

# Spoken JARVIS-style boot greeting on the first dashboard connection per boot
# (persona-voiced status brief; canned fallback when the brain is offline).
# Set to false to boot silently.
# BOOT_GREETING=true
# The greeting also picks up the last conversation's thread ("Last time we spoke:
# ...") from the 3 most recent conversation records within 3 days.

# Global push-to-talk hotkey (Electron desktop app only — a browser tab cannot
# claim an OS-wide accelerator). Press it anywhere to start/stop talking; it does
# NOT raise or focus the window, which is the point of a global hotkey. Goes
# through the same path as clicking the orb, so a locked HUD still refuses.
# Default Alt+Space, falling back to Control+Alt+Space, Control+Shift+Space then
# Control+Alt+M if another app already owns the accelerator (the boot log names
# whichever one won). Set to false to disable.
# MYTHOS_HOTKEY_TALK=Alt+Space

# Floating cursor overlay (Electron desktop app only): a global hotkey pops a
# small transparent, click-through attention ring centered on the OS cursor,
# then auto-hides ~1.5s later. Opt-in and OFF by default — an always-on-top
# window appearing unasked is the failure mode to avoid, so a missing or
# unparseable value here is always treated as OFF. Set to exactly "true" to
# enable; the hotkey (default Control+Alt+C, falling back to Control+Shift+C
# then Control+Alt+P) is only registered when this is on.
# MYTHOS_CURSOR_OVERLAY_ENABLED=false
# MYTHOS_HOTKEY_CURSOR_OVERLAY=Control+Alt+C

# Proactive follow-ups: the cortex's idle mull emits high-priority thoughts (an
# unanswered question, a stalled goal/build) and MYTHOS says them unprompted.
# Guards: never within FOLLOWUP_QUIET_MS of your last turn, at most one per
# FOLLOWUP_MIN_GAP_MS. Set FOLLOWUP_MIN_GAP_MS=0 to disable follow-ups entirely.
# FOLLOWUP_QUIET_MS=120000
# FOLLOWUP_MIN_GAP_MS=3600000

# Learning loop: run a reflection pass every N turns. It extracts operator
# preferences + speaking style from recent conversations into
# vault/Identity/self.md and vault/Identity/operator-style.txt, and REWRITES
# vault/Identity/operator-profile.txt whole. The profile exists because the
# preference list is newest-first and capped, so a durable day-one fact would
# otherwise be evicted by a week of newer trivia; rewriting it in full is what
# lets it accumulate and self-compact without an eviction policy.
# REFLECTION_EVERY_TURNS=15
# Second, separate reflection pass: analyses ACTION OUTCOMES (not conversation
# preferences) every N turns, writing to the diagnostician + Skills. Schema
# default is 30 (src/core/config/schema.js); when set only via env and left
# unset, src/core/identity/reflection.js falls back to 2x
# REFLECTION_EVERY_TURNS instead. REFLECTION_ACTION_MIN is the sample-size
# floor below which the pass skips.
# REFLECTION_ACTION_EVERY_TURNS=30
# REFLECTION_ACTION_MIN=5

# Self-error explanation: when an anomaly has no healing playbook, speak a
# plain-language cause + safe remedy (suppress tool / re-probe providers /
# needs-human). Set to false to disable.
# IMMUNE_EXPLAIN=true

# hermes-agent (github.com/NousResearch/hermes-agent, MIT) — REQUIRED.
# As of 2026-07-29 Hermes is the ONLY build-content engine: build-runner.js
# (pipeline_execute / kanban_build_card / start_project / run_mission), the
# engagement executor's build stage, and Forge (build_project /
# revise_project) all generate through it. There is deliberately NO
# brain.think fallback — when Hermes is unavailable a build FAILS with an
# install hint rather than quietly producing a plausible-but-wrong artifact.
#
# INSTALL (once per clone):  node mythos/scripts/setup-hermes.js --install
# VERIFY:                    node mythos/scripts/setup-hermes.js
# It clones the repo into <repo>/Hermes Agent/hermes-agent and runs that
# clone's own installer with HERMES_HOME pointed at <repo>/Hermes Agent, so
# the install dir, its managed uv, its bundled PortableGit and Hermes's own
# config/credentials all stay inside the project (that dir is gitignored).
# Hermes provisions its OWN CPython 3.11, so your system Python version is
# irrelevant — a 3.14 system Python is fine even though Hermes pins <3.14.
#
# HERMES_CLI must be an ABSOLUTE path, not a bare `hermes`: a shim earlier on
# PATH (e.g. one forwarding into WSL) will otherwise win, and a .bat/.cmd shim
# cannot carry a build prompt — cmd.exe concatenates args unquoted and caps the
# command line at 8191 chars, while build prompts run to 24000. The adapter
# warns loudly if HERMES_CLI resolves to a .bat/.cmd.
# HERMES_CLI=/absolute/path/to/Hermes Agent/hermes-agent/venv/bin/hermes
# HERMES_TASK_TIMEOUT_MS=180000
# Separate, much smaller bound for the boot-time `hermes --version` liveness
# probe only — NOT for running a task (that is HERMES_TASK_TIMEOUT_MS above).
# A live probe returns in ~800ms; the 15s default is cold-start headroom.
# HERMES_CLI_PROBE_TIMEOUT_MS=15000
#
# The HTTP gateway is a fallback for one-shot hermes_task only — it cannot be
# cwd-pinned, so builds always require the CLI.
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=
#
# Hermes's OWN model + provider key. Forwarded to the Hermes child as
# OPENAI_API_KEY/OPENAI_BASE_URL (the generic OpenAI-compatible shape it
# speaks; Mistral is OpenAI-shaped at https://api.mistral.ai/v1). REQUIRED:
# this must be a SEPARATE workspace key, not the MISTRAL_API_KEY above. A
# 20-60-call build shares Mistral's workspace rate limit with memory
# consolidation, the boot greeting, and every realtime vision/voice call that
# also ranks Mistral — a shared key reintroduces the exact voice stutter this
# separation avoids.
# SYMPTOM that these are the same key: voice stutters, replies drop to the
# weakest model in the chain, or 429s appear on voice turns WHILE a build is
# running. Boot logs `hermes.shared-provider-key` when it detects it.
# HERMES_PROVIDER_KEY=
# HERMES_PROVIDER_BASE_URL=https://api.mistral.ai/v1
# HERMES_INFERENCE_MODEL=mistral-large-2512
#
# PROVIDER FAILOVER (slots 2-4, added 2026-08-03). The adapter forwards exactly
# one provider pair per attempt; on a provider-class failure it rotates to the
# next configured slot and logs `hermes.provider-rotated` + a health.anomaly.
# Rotation triggers: non-zero exit, spawn error, timeout, or an exit-0 reply
# whose text starts with Hermes's own error prefix ("HTTP 4xx:", "API call
# failed after N retries:"). A bad PROMPT never rotates.
#
# WHICH FAILURE ACTUALLY HAPPENS: 429, not 401. Every free provider rate-limits
# long before it fails auth, and none of them expose rate-limit headers, so
# exhaustion only ever surfaces as a 429 partway through a build.
#
# The convention is additive and absent slots are skipped, so leaving all of
# these unset behaves exactly as a single-key install always has.
# `node mythos/scripts/setup-hermes.js` prints the resolved slot table (keys
# redacted) and warns when two slots share one key value — one key is one rate
# bucket, so rotating between duplicates cannot escape a 429.
#
# ===================== MEASURED BUILD ENDURANCE 2026-08-03 =====================
# The slot table's premise — "Mistral is the only provider with the TPM headroom
# for a whole build" — DOES NOT HOLD on a free-tier key. Measured with
# `scripts/verify-hermes-build-endurance.js`, 12K-char prompts:
#   unpaced        -> HTTP 429 at call 3 of 60
#   8s  pacing     -> HTTP 429 at call 3 (pacing this small does not help)
#   45s pacing     -> 4/4 clean
# So it is a time-window rate limit, and the usable spacing is somewhere between
# 8s and 45s. A 60-call build at 45s spacing is ~45 minutes of waiting alone.
#
# What this means in practice: a real multi-call build needs either a PAID tier,
# or throttling. Note that rotating on a 429 does NOT rescue it here — rotation
# cannot change provider (see below), and two slots holding keys for the same
# provider share one bucket. Backoff-and-retry is the mechanism that would
# actually help; it is NOT built, deliberately, because that is a design change
# the operator should choose rather than something a verification session adds.
# ===============================================================================
#
# ============================ READ THIS FIRST ============================
# ROTATION CANNOT CHANGE THE ENDPOINT. Proven 2026-08-03: forwarding an
# unroutable HERMES_PROVIDER_BASE_URL (http://127.0.0.1:9/v1) still produced a
# correct reply, because Hermes takes model.base_url from its own config.yaml
# and IGNORES the OPENAI_BASE_URL the adapter forwards. There is no generic
# HERMES_INFERENCE_BASE_URL to override it — only HERMES_INFERENCE_MODEL and
# HERMES_INFERENCE_PROVIDER exist.
#
# Consequence: slots rotate the KEY and the MODEL, never the PROVIDER. A slot
# aimed at a different vendor sends its key to config.yaml's endpoint and comes
# back 401 — which reads as "bad key" and sends you to rotate a credential that
# was never wrong. Observed exactly that with a VALID Cerebras key.
#
# So slots 2-4 below are only useful today as ADDITIONAL KEYS FOR THE SAME
# PROVIDER as config.yaml (e.g. a second Mistral key to escape a 429). Genuine
# cross-provider failover needs config.yaml rewritten per attempt, which this
# design deliberately does not do. `setup-hermes.js --check` flags any slot
# whose base_url differs from config.yaml as UNREACHABLE.
# =========================================================================
#
# NAMING ASYMMETRY, deliberate but easy to trip over: slot 1's model comes from
# HERMES_INFERENCE_MODEL above (Hermes's own process-level override, kept as-is
# so existing installs are untouched), while slots 2-4 use
# HERMES_PROVIDER_MODEL_<n>. There is NO plain HERMES_PROVIDER_MODEL — setting
# one is read by nothing, and slot 1 silently falls back to whatever
# config.yaml holds. `setup-hermes.js --check` prints the model each slot
# actually resolved, so check there rather than assuming.
#
# ALSO: <HERMES_HOME>/.env loads with override=True and BEATS every key
# forwarded here. If it contains OPENAI_API_KEY, provider-key rotation silently
# does nothing — every slot authenticates as that one key, all tests still
# pass, and a broken slot 1 keeps "working". Comment it out there.
#
# Slot order below reflects measured probes, not preference. Slot 1 is the only
# provider with the TPM headroom for a whole build (Mistral 500K vs Cerebras
# 30K; a 60-call build at ~12K prompt tokens is ~700K tokens).
# HERMES_PROVIDER_KEY_2=
# HERMES_PROVIDER_BASE_URL_2=https://model.inferx.net/endpoints/v1
# HERMES_PROVIDER_MODEL_2=Qwen3-Coder-Next-FP8
#   InferX — most consistent latency (2.3-3.6s), coding-specialised. Shared
#   capacity 429s when all replicas are busy, so it is not the primary.
# HERMES_PROVIDER_KEY_3=
# HERMES_PROVIDER_BASE_URL_3=https://api.cerebras.ai/v1
# HERMES_PROVIDER_MODEL_3=gpt-oss-120b
#   Cerebras — fastest peak (506ms) and accepts 30K-token prompts, but its
#   30K TPM ceiling 429s partway into a multi-call build. Fine for single
#   artifacts. NOTE: cerebras/zai-glm-4.7 hard-400s above ~8K tokens; that cap
#   belongs to THAT model, not to gpt-oss-120b.
# HERMES_PROVIDER_KEY_4=
# HERMES_PROVIDER_BASE_URL_4=https://api.kilo.ai/api/gateway/v1
# HERMES_PROVIDER_MODEL_4=kilo-auto/free
#   Kilo Gateway — last resort; only 2/3 tool calls at build size. Its
#   auto-route discloses the model it resolved to in the response.
#
# MEASURED AND EXCLUDED — do not re-add these without new evidence:
#   Groq            413 "Request too large" at 24000 chars, which is exactly
#                   Hermes's prompt cap. Stays on the voice lane.
#   NVIDIA NIM      0/3 at build size, one 503, up to 37s. z-ai/glm-5.2 timed
#                   out at 90s; moonshotai/kimi-k2.6 404s.
#   OpenRouter free 4 of 5 tool-capable :free slugs return 404 "No endpoints
#                   available"; the survivor drops the tool call.
#   OmniRoute       the key is for a LOCAL gateway (localhost:20128/v1).
#   OpenCode Zen    different endpoints per model family; Hermes speaks plain
#                   /chat/completions only.
#   InferX deepseek-v4-flash  48s (60s for -0731) and 429s under load.
#   Kilo cohere/north-mini-code:free  persistent 429 limit_rpm.
#
# Mistral model notes: codestral-latest DOES support tool calling (256K ctx)
# despite its docs saying otherwise. Every devstral-*, mistral-code-agent-latest
# and mistral-medium-2505/2508 are DEPRECATED 2026-08-31 — do not pin them.
#
# GOTCHA (root-caused live 2026-07-29 against v0.19.0): these env vars are not
# the whole story. Hermes's own `<HERMES_HOME>/config.yaml` carries
# `model.provider`, `model.default` and `model.base_url`, and a fresh install
# defaults to OpenRouter — so pointing the env vars at another provider yields
# "HTTP 401: Missing Authentication header".
#
# THE FIX: `model.provider` must be `openai-api`. That is the registry id for
# generic API-key access (hermes_cli/auth.py PROVIDER_REGISTRY), and it is the
# one entry whose ProviderConfig declares
#   api_key_env_vars=("OPENAI_API_KEY",)  base_url_env_var="OPENAI_BASE_URL"
# i.e. exactly what this adapter forwards. `provider: openai` is NOT a registry
# id, and `custom` is a plugin rather than the generic key path — both of those
# authenticate as nobody and produce the 401 above. So for Mistral:
#   model:
#     provider: openai-api
#     default: mistral-large-2512
#     base_url: https://api.mistral.ai/v1
# `node mythos/scripts/setup-hermes.js` reports the resolved trio and warns when
# the provider is not openai-api. `hermes model` also works but is interactive.
#
# SEPARATE GOTCHA: Hermes prints provider errors to STDOUT AND EXITS 0, which is
# indistinguishable from a successful run — build-engine.js guards against that
# reply being filed as an artifact.
#
# Hermes build-driver timing (hermes-runner.js). Plan runs are short and
# sandboxed; builds run a real agent loop and need real headroom.
# HERMES_PLAN_TIMEOUT_MS=300000
# HERMES_BUILD_TIMEOUT_MS=1800000
# HERMES_POLL_MS=2000
#
# Timeout for a SINGLE-ARTIFACT text build (build-engine.js: pipeline cards,
# kanban cards, engagement builds). Separate from the two above, which bound
# Forge's multi-file agent loop. Until this existed no caller passed a timeout at
# all, so these builds silently inherited the adapter's generic 3-minute default
# while a grounded build stacks research + skill resolution + a possible
# review-retry into one budget.
# HERMES_TEXT_BUILD_TIMEOUT_MS=600000
# HERMES_BUILD_TERMINAL_ENV=local
# EDGE_TTS_AUTOSTART=true

# Voice agent max spoken reply length (chars). Raise for full reasoning paragraphs.
# VOICE_MAX_SAY_CHARS=800

# Conversation brain — idle reasoning frequency. During quiet moments the entity
# forms thoughts about the operator's situation (loose ends, follow-ups, observations).
# These surface naturally in the next conversation. 0 = disabled (zero-cost idle).
# MYTHOS_MULL_EVERY_TICKS=300

# get_weather tool default location ("lat,lon"), used when no location is
# spoken. Same Kolkata fallback the dashboard weather widget already uses —
# change to your real coordinates for accurate default weather reports.
# WEATHER_LOCATION=22.57,88.36

# Brain Timing
REFLECT_EVERY=60
CONSOLIDATE_EVERY=300
EPISODIC_RETENTION_DAYS=30
CHAIN_COOLDOWN_MS=60000
MODEL_REGISTRY_TTL_MS=300000

# Autonomy
AUTONOMOUS_MAX_TIER=2
GOAL_TOKEN_BUDGET=20000
GOAL_ACTION_BUDGET=25
MAX_ACTIVE_GOALS=5

# Immune
# REMEDIATION P2-9: was pinned at 5000 — copying this file to .env re-pinned
# the old pre-fix value and silently defeated config/schema.js's STALL_MS
# default bump to 30000 (lastTickAt isn't refreshed mid-tick, so a legitimate
# slow 'build'-lane brain call past 5s tripped the stall watchdog on healthy
# ticks). Kept explicit (matching this section's style) but now current.
STALL_MS=30000
WATCHDOG_MS=2000
BREAKER_FAIL_THRESHOLD=3
BREAKER_WINDOW_MS=30000
BREAKER_RESET_MS=15000

# Bus
BUS_HISTORY_SIZE=500
BUS_STORM_MAX=400

# Browser automation (playwright-core, drives installed Chrome/Edge)
# BROWSER_CDP_URL=http://127.0.0.1:9222
# BROWSER_AUTOMATION=true
# Per-page default action timeout (click/type/textContent), ms. The adapter's
# page.setDefaultTimeout. Raise it for a slow SPA; lower it to fail faster on a
# genuinely-absent element. Default 15000.
# BROWSER_PAGE_TIMEOUT_MS=15000
# How long the waitReady() pre-wait (before click/type/get_text) waits for a
# selector to become visible, ms. Less than PAGE_TIMEOUT so a missing element
# fails here with a clean selector-named message instead of the raw Playwright
# timeout. 8000 covers most SPA (YouTube ytd-*) hydration. Default 8000.
# BROWSER_PAGE_WAIT_MS=8000
# Auto-connect: while OFFLINE, retry the CDP connect on this interval (ms) so
# browser automation comes online the moment a debug Chrome exists, and
# re-attaches after a drop. Connect-only, never launches — zero mic risk.
# 0 disables the poller. Default 15000.
# BROWSER_RECONNECT_MS=15000
# Fully hands-off: launch a debug Chrome automatically AFTER boot (once voice/mic
# init has claimed the audio device, so it can't steal the mic). Off by default —
# with it off, a debug Chrome opens on demand (first browser tool, or ask MYTHOS
# to "open the browser") or when you run scripts/setup-chrome-debug.ps1.
# BROWSER_AUTO_LAUNCH=false
# Delay (ms) before the deferred auto-launch fires. Default 20000.
# BROWSER_AUTO_LAUNCH_DELAY_MS=20000
# Unrelated to CDP automation above: generate_pdf (src/core/effectors/
# from-docs.js) shells out to headless Chrome to print HTML to PDF, and probes
# the standard Windows install locations first. Set this only when Chrome lives
# somewhere non-standard; it is ignored unless the path exists. With no Chrome
# at all, generate_pdf degrades honestly to styled HTML instead of failing.
# CHROME_PATH=

# Google OAuth (Gmail + Calendar adapters). Full operator walkthrough:
#   docs/google-oauth-setup.md   (Cloud Console project, consent screen, scopes)
# Mint the refresh token with:  node scripts/google-auth.js
# (Phase 3 / BUG-024: the script now requests calendar.readonly too — re-mint if
# your existing token predates 2026-07-19, or Calendar reads will 403.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Engagement Layer (structured task lifecycle — interview intake through completion)
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Wake-word — hands-free "hey jarvis" activation (on-device ONNX, no cloud).
# Opt-in and off by default. The pretrained openWakeWord models are CC BY-NC-SA
# so they are never committed to this repo; fetch them yourself once with:
#   node scripts/setup-wakeword.js
# then set WAKEWORD_ENABLED=true and restart. WAKEWORD_THRESHOLD is the
# 0.1-0.95 score cutoff that counts as a detected wake word (higher = fewer
# false triggers, more missed activations).
# WAKEWORD_ENABLED=false
# WAKEWORD_THRESHOLD=0.5

# Ambient screen awareness — periodic screenshot -> vision-description sensor
# feeding the perception loop (src/core/sensors/screen-sensor.js). Opt-in and
# off by default. An unchanged screen (sha1 hash match) never triggers a vision
# call. Raw screenshot bytes are NEVER written to disk — only the text
# description flows onward. Toggle live with the voice/tool command
# "watch my screen" / "stop watching my screen" (ambient_awareness tool).
# SCREEN_AWARENESS_ENABLED=false
# SCREEN_AWARENESS_POLL_MS=30000
# SCREEN_AWARENESS_SALIENCE=0.3

# Native speech-to-speech voice (Gemini Live, BidiGenerateContent). Opt-in and
# OFF by default — voice-agent.js's existing batch Whisper-STT path is the
# untouched fallback with zero behavior change until this is flipped; setting
# it back to false is a total rollback (V2 §16), no code revert needed.
# Requires a real GOOGLE_API_KEY with Live API access — run
# node scripts/verify-gemini-live.js first to confirm your key can reach it.
#
# VERIFIED END TO END 2026-07-31 against the real API, not just the handshake:
# session open 799ms, text -> first audio 668ms, real PCM returned, AD-6 output
# transcription live, and a tool call (list_windows) executed through the normal
# leash -> dispatch spine with exactly one audit line. A T3 request (delete_goal)
# correctly raised a confirm instead of executing, and the target survived.
# For comparison, the batch path it replaces measures ~612ms of brain plus a flat
# ~900ms per sentence of TTS, on top of STT.
#
# COST: the Live API is METERED PER SESSION and bills for the whole time the
# socket is open, not per request. LIVE_IDLE_TIMEOUT_MS / LIVE_SESSION_MAX_MS
# below are the two caps that stop an idle session billing forever.
# VOICE_S2S_ENABLED=false
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
#
# GEMINI_LIVE_VOICE — one of Aoede | Kore | Leda | Zephyr | Puck | Charon.
# Kept at Google's own suggested assistant-style default, Aoede, because
# picking between them properly means auditioning each by ear against real
# speakers — a step that needs a human operator and cannot be done in this
# build environment. This default is fully operator-overridable: set this key
# once you've listened to a few turns and have a preference.
# GEMINI_LIVE_VOICE=Aoede
#
# LIVE_IDLE_TIMEOUT_MS and LIVE_SESSION_MAX_MS are cost/lifecycle gates, not
# hard kills (BUG-059 fix): when either fires, live-session.js rotates the
# duplex socket (closes and transparently reopens with the same
# sessionResumption handle) instead of dropping the session, so MYTHOS never
# goes silently deaf just because it was mid-TTS when the timer fired. Raise
# LIVE_IDLE_TIMEOUT_MS if you still see resets during long silences; lower it
# to bill less for idle open-mic time.
# LIVE_IDLE_TIMEOUT_MS=120000
# LIVE_SESSION_MAX_MS=600000
#
# LIVE_TOOL_ALLOWLIST — comma-separated tool names exposed to the Live
# session's functionDeclarations. Empty (default) uses live-tools.js's curated
# high-traffic set — function-calling accuracy degrades with MYTHOS's full 107
# registered tools, so this is a deliberate subset, not a cap you need to lift.
# LIVE_TOOL_ALLOWLIST=

# --- Live screen share (Electron Slice 3, desktopCapturer) --------------------
# Streams your desktop into the open Live session as JPEG video frames, so you
# can ask "what am I looking at?" and get an answer about the ACTUAL screen
# rather than a description the ambient screen-sensor wrote earlier.
#
# READ THIS BEFORE ENABLING. This sends pictures of your screen to Google
# continuously for as long as a voice session is open — a materially different
# privacy posture from sending audio. Everything visible goes: other windows,
# notifications, whatever is behind the HUD. It is off by default and no
# upgrade turns it on. Frames are never written to the vault or the bus; they
# go to the Live socket and nowhere else.
#
# Needs Electron (the desktop shell grants the capture). In a plain browser the
# native screen-picker appears instead, which also works but asks every session.
# LIVE_SCREEN_SHARE_ENABLED=false
#
# Frames per second. This is a COST dial: every frame is a billed image input
# on your own key. 0.5 (one frame per two seconds) is enough for "watch my
# screen" because the model retains earlier frames in context. 1-2 feels more
# responsive and costs proportionally more. Max 4.
# LIVE_SCREEN_FPS=0.5
#
# JPEG quality, 0.1-1. Frames are downscaled to a 1280px long edge first — the
# model reads layout and large text, not fine pixels, so 0.6 is a deliberate
# floor rather than a compromise.
# LIVE_SCREEN_JPEG_QUALITY=0.6

# Daily planning + accountability — morning brief, stall check-ins, evening
# review over the existing Goals system (src/core/planner/daily.js). On by
# default (no camera/mic/screen capture involved). Say "be stricter with me"
# to raise the strictness persona dial and harden the check-in tone.
# PLANNER_ENABLED=true
# PLANNER_MORNING_HOUR=9
# PLANNER_EVENING_HOUR=21
# PLANNER_CHECKIN_EVERY_MS=10800000

# ---- W8 (Phase 2 — Wiring Integrity): previously-undocumented schema keys.
# All schema-defined (see src/core/config/schema.js); documented here for
# discoverability. Commented = the schema default is in effect. ----

# Action dispatch / leash / lifecycle
# ACTION_TIMEOUT_MS=30000          # bounds a single dispatchAction() call
# LEASH_CONFIRM_TTL_MS=30000       # confirm popup auto-dismiss
# SHUTDOWN_MS=10000                # graceful-shutdown hard-exit backstop
# MAX_DRAIN_PER_TICK=50            # perception cap per cortex tick (§11.1)

# Server rate limiting + WS/CORS allowlist
# RATE_LIMIT_GLOBAL=240            # /api/* requests per minute
# RATE_LIMIT_EXPENSIVE=8           # /api/voice/transcribe per minute
# ALLOWED_ORIGINS=                 # comma-sep WS/CORS allowlist (P4 — Render hostname)

# Brain chain tuning
# CHAIN_ATTEMPT_TIMEOUT_MS=30000   # per-provider-attempt timeout (distinct from ACTION_TIMEOUT_MS)
# VOICE_OLLAMA_KEEP_ALIVE=10m      # ollama vision-lane keep-alive

# Voice loop
# VOICE_RECALL_TIMEOUT_MS=3500     # RAG recall bound before reply
# VOICE_MAX_TOOL_ITERATIONS=4      # tool-call rounds per voice turn
#
# Conversation memory. The history is SERVER-scoped and persisted to
# vault/Conversation/session.json, so it survives both a dashboard reconnect and
# a restart; it is dropped once it is older than VOICE_INTAKE_IDLE_MS. Entries
# are capped BOTH by count and by total characters — real voice turns run
# 50-400 chars, so 12000 chars holds roughly 12-18 exchanges. Raising
# VOICE_HISTORY_MAX_CHARS costs prompt tokens and latency on EVERY turn.
# VOICE_INTAKE_IDLE_MS=2700000     # idle conversation retention (45 min)
# VOICE_HISTORY_MAX_TURNS=40       # history entries kept (user+assistant+outcomes)
# VOICE_HISTORY_MAX_CHARS=12000    # total history prompt budget
# VOICE_EMAIL_MODE=gmail           # 'gmail' (adapter) or 'mailto' (open client)
# Semicolon-separated sandbox roots for open_folder/list_folder/read_file (the
# project root is always included). Add more roots with ";", e.g.
# %USERPROFILE%;%LOCALAPPDATA%\SomeFolder
# VOICE_ALLOWED_DIRS=%USERPROFILE%

# Speech cadence
# ANNOUNCER_REANNOUNCE_MS=600000   # immune announcer dedup cooldown (BUG-030)
# MYTHOS_LOG_PRETTY=               # 'force' = on when piped, 'false' = off

# Task 5 (step 5, alarms/timers) — override the bundled timer/reminder alert
# tone (a real WAV; default is mythos/ui/public/audio/alert.wav). Missing or
# unreadable degrades honestly — the reminder still speaks, it just doesn't ring.
# REMINDER_ALERT_SOUND=

# Embeddings / STT model overrides (free-tier default models)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# MISTRAL_EMBED_MODEL=mistral-embed
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Provider URL overrides (default to the official endpoints)
# NIM_API_URL=https://integrate.api.nvidia.com/v1
# GROQ_API_URL=https://api.groq.com/openai/v1
# MISTRAL_API_URL=https://api.mistral.ai/v1
# CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Edge-TTS child service. edge-tts is BYO — never bundled, never installed for you.
# Supply it project-local (the autostarter checks these BEFORE PATH):
#   python -m venv .venv
#   .venv/Scripts/python -m pip install edge-tts     # Windows
#   .venv/bin/python -m pip install edge-tts         # macOS / Linux
# Searched, in order: mythos/.venv, <repo>/.venv, then `python`/`python3` on PATH.
# Absent = server TTS stays off and the browser's speechSynthesis speaks instead.
# EDGE_TTS_URL=http://127.0.0.1:5050
# EDGE_TTS_PORT=5050
# EDGE_TTS_AUTOSTART=              # 'false' = don't spawn at boot

# Phase 3 (V7) — run_command effector. Allow-listed shell commands for build
# verification (engagement verify-stages + Forge verify-stages). Empty = disabled
# (fail-closed). Format: 'cmd:flag,flag;cmd2:flag;cmd3' — semicolons between
# commands, colon precedes a command's allowed flags, commas between flags.
# Keep minimal; NEVER allow sh/bash/cmd/powershell. v1 is allowlist+timeout,
# NOT a full sandbox — see mythos/src/core/effectors/from-runner.js.
# RUN_COMMAND_ALLOWLIST=npm:test,install,run;node:--version;git:status,diff,log
# RUN_COMMAND_TIMEOUT_MS=60000

# install_from_github effector — shares the RUN_COMMAND_ALLOWLIST gate above, so
# it is disabled (fail-closed) whenever that list is empty. It needs 'git' plus
# whichever package manager the target repo uses:
#   RUN_COMMAND_ALLOWLIST=git;npm;pip;cargo;go
# TRADE-OFF TO UNDERSTAND BEFORE SETTING THIS: the allowlist is shared, so
# allow-listing these also lets the generic run_command tool invoke them with
# arbitrary arguments (still T3 confirm-gated). Entries without a colon permit
# ANY args for that command — use the 'cmd:flag,flag' form to narrow them.
# Clones land in vault/builds/installs/<repo>. The effector never executes a
# repo's install.sh/Makefile — only git + package-manager commands.
# INSTALL_TIMEOUT_MS is separate from RUN_COMMAND_TIMEOUT_MS because a real
# `npm install`/`pip install .` routinely exceeds the 60s command default.
# INSTALL_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# MCP client — talk to Model Context Protocol servers over stdio.
# ---------------------------------------------------------------------------
# Empty = disabled (fail-closed): nothing is spawned and every mcp_* tool
# reports disabled. This is the default and it is a fine place to stay.
#
# MCP_SERVERS is a JSON array on ONE line. Per entry:
#   name       [A-Za-z0-9_-]. Becomes part of the tool address, which is always
#              mcp__<name>__<tool> — never the server's bare tool name. That
#              prefix is what stops browser-use's browser_navigate from
#              colliding with MYTHOS's own browser_navigate.
#   command    the binary. Spawned with shell:false; no shell expansion.
#   args       array of strings.
#   env        per-server environment. "${VAR}" expands from your real
#              environment, so no key is written into this file twice. This is
#              the ONLY way a secret reaches a server: the ambient environment
#              is scrubbed of API keys/tokens before spawning.
#   autostart  connect at boot instead of on first use. Default false.
#
# READ THIS BEFORE ENABLING ANYTHING. An MCP server is NOT sandboxed by MYTHOS.
# It runs with your privileges. RUN_COMMAND_ALLOWLIST, the folder allowedRoots
# and the shell-metachar reject guard MYTHOS's own effectors and do NOT apply to
# a call routed through this transport — Desktop Commander's write_file reaches
# your whole disk. Every call is therefore tier 3 (confirm), and the real trust
# decision is listing the server here at all.
#
# Desktop Commander (long-lived terminal sessions, paged tree search, surgical
# block edits — see mythos/skills/desktop-commander/SKILL.md for which jobs
# should stay on MYTHOS's own tools instead):
# MCP_SERVERS=[{"name":"desktop_commander","command":"npx","args":["-y","@wonderwhy-er/desktop-commander@latest"]}]
#
# browser-use (outcome-driven browsing; needs uv + its own LLM key. MYTHOS's
# built-in playwright browser_* tools stay the default for anything
# deterministic):
# MCP_SERVERS=[{"name":"browser_use","command":"uvx","args":["--from","browser-use[cli]","browser-use","--mcp"],"env":{"OPENAI_API_KEY":"${OPENAI_API_KEY}"}}]
#
# Both at once (one line, one array):
# MCP_SERVERS=[{"name":"desktop_commander","command":"npx","args":["-y","@wonderwhy-er/desktop-commander@latest"]},{"name":"browser_use","command":"uvx","args":["--from","browser-use[cli]","browser-use","--mcp"],"env":{"OPENAI_API_KEY":"${OPENAI_API_KEY}"}}]
#
# TencentDB Agent Memory (TAM) — Wiki + Code-Graph only. TAM's MCP surface
# exposes 12 read-only tools (wiki_search/read/list/graph, code_search/explore/
# callers/callees/impact/node/status/files). Chat Memory + Skill are NOT MCP
# tools in TAM (they live on separate REST routes) and are deliberately not
# bridged — MYTHOS's local episodic/semantic/skills are richer and feed the
# learning loop natively. This takes the one genuinely-better-than-local part:
# real symbol/call-graph/impact analysis that from-code-search.js doesn't do.
# tam-bridge.js is a stdio↔HTTP shim (MYTHOS's client is stdio-only; TAM is HTTP
# on :8424). Reachable as mcp__hub__code_callers etc. Empty/absent TAM_* env →
# the bridge returns an empty tool list and MYTHOS boots normally (fail-closed).
# Requires TAM running (deploy/global-images/start-all.sh) + a service id + a
# per-user sk-mem-... key issued via the Memory Hub.
# MCP_SERVERS=[{"name":"hub","command":"node","args":["adapters/mcp-client/tam-bridge.js"],"env":{"TAM_BASE_URL":"http://127.0.0.1:8424","TAM_SERVICE_ID":"<knowledge-instance-id>","TAM_USER_KEY":"${TAM_USER_KEY}"},"autostart":true}]
#
# Optional second gate: only these fully-qualified tools may be called.
# Separate with ; , or newlines. Empty = every advertised tool is callable.
# MCP_TOOL_ALLOWLIST=mcp__desktop_commander__start_process;mcp__desktop_commander__interact_with_process;mcp__desktop_commander__start_search
# MCP_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Strix security scanning — the `security_scan` tool (effectors/from-strix.js).
# ---------------------------------------------------------------------------
# Optional. Absent Strix or Docker → the tool reports an install hint and never
# blocks boot. Install with `pip install strix-agent` (Python >=3.12 + a running
# Docker daemon).
#
# STRIX_LLM / LLM_API_KEY are the operator's OWN LLM credentials — Strix bills
# against them, not MYTHOS's brain keys. These only decide whether an authorized
# run can execute; the tool still REFUSES any call that lacks a per-call
# `authorized_by` stating you own or have written permission to test the target.
# Scanning a target you do not control is unlawful — this gate is not optional.
# STRIX_LLM=openai/gpt-5.4
# LLM_API_KEY=your-own-llm-key
# LLM_API_BASE=            # optional OpenAI-compatible proxy base URL
# STRIX_TIMEOUT_MS=1800000 # 30 min; real runs are long
# PERPLEXITY_API_KEY=      # optional research backend Strix can use

# web_search effector — optional first-tier provider. With a key set, Exa's REST
# API is tried first (higher rate limits, better snippets); unset, the chain
# starts at DuckDuckGo HTML -> DuckDuckGo Lite -> Wikipedia OpenSearch, so
# search still works with no key at all. See src/core/effectors/web-search.js.
# EXA_API_KEY=

# Agent-Reach CLI (optional, external) — absolute path to the agent-reach binary
# for a future web_reach effector. Not required by anything today; MYTHOS does
# not spawn it yet. Left unset = feature absent, no error.
# AGENT_REACH_BIN=/path/to/.venv/bin/agent-reach

# Voice VAD (client-side mic speech-detection thresholds; exposed via /api/config/vad)
# VAD_SPEECH_RMS=0.035
# VAD_MIN_PEAK_RMS=0.06
# VAD_HOLD_TICKS=3
# VAD_SILENCE_MS=1800

# Which speech-detector voice-loop.js uses. Default 'rms' (the hand-tuned
# volume-threshold detector above, unchanged behavior for anyone who sets
# nothing). 'silero' runs Silero VAD (MIT, snakers4/silero-vad) client-side
# through onnxruntime — a trained speech/non-speech model instead of a volume
# threshold. Install the model once with:
#   node mythos/scripts/setup-silero.js
# (downloads ~2.2MB into ui/public/models/silero/, gitignored, per-machine —
# same convention as scripts/setup-wakeword.js). Then set VAD_ENGINE=silero
# and restart. NOTE: VAD_SPEECH_RMS/VAD_MIN_PEAK_RMS above are read as speech
# PROBABILITY thresholds (0..1) when silero is active, not RMS amplitude —
# voice-loop.js applies its own sane probability defaults if you don't
# override them, but a value tuned for 'rms' (e.g. 0.035) means something
# very different here.
# VAD_ENGINE=rms

# Effectors & sensors
# MYTHOS_BUILD_CONCURRENCY=3
# MYTHOS_JOBS_MAX_PERSISTED=100
# MYTHOS_WATCH_DIRS=
# MYTHOS_FILE_DEBOUNCE_MS=500

# Gmail triage sensor
# GMAIL_TRIAGE_ENABLED=true
# GMAIL_TRIAGE_POLL_MS=300000

# Android ADB bridge (Task 8-10, Wave 2) — OPTIONAL. adapters/android-child
# probes `adb version` at boot; if adb isn't found, the adapter degrades to
# OFFLINE with an install hint and boot continues unaffected (AD-9) — every
# phone_* tool then fails honestly instead of the process failing to start.
#
# INSTALL (once, per machine that wants phone control):
#   node mythos/scripts/setup-android.js --install
#   node mythos/scripts/setup-android.js            (--check status/devices)
# It downloads Google's official platform-tools zip into
# <repo>/Android Platform Tools/ (gitignored) — never curl|bash / iex(irm).
#
# PAIRING (Android 11+ Wireless Debugging — the pairing code is shown on the
# phone itself, Settings > Developer options > Wireless debugging; no script
# can read or automate that on-phone step):
#   node mythos/scripts/setup-android.js --pair <ip:port> <code>
#   node mythos/scripts/setup-android.js --connect <ip:port>
# --connect persists the address to vault/Identity/android-devices.json (a
# growing device list, not a static secret, hence vault rather than here).
# Recommend a router DHCP reservation for paired phones — a renewed lease
# silently breaks every phone_* tool until reconnected.
#
# ANDROID_ADB_BIN: absolute path to adb if it isn't on PATH — --install
# prints the exact value to set here.
# ANDROID_ADB_BIN=adb
# ANDROID_ADB_POLL_MS=8000
# ANDROID_CMD_TIMEOUT_MS=15000

# WhatsApp Desktop (whatsapp_send) — no env key needed, but messaging someone by
# NAME needs a contacts file. It lives in the vault, not here, because phone
# numbers are personal data that must never be committed:
#
#   vault/Contacts/contacts.json
#   { "dad": "+15551234567", "mom": "+15559876543" }
#
# Numbers are E.164 (leading +, country code). Without the file you can still
# say the number itself ("whatsapp +1 555 123 4567 saying hi"); an unknown name
# fails honestly and lists the names it does know. Requires WhatsApp Desktop
# installed — the tool opens the exact chat via WhatsApp's own
# whatsapp://send?phone= deep link rather than automating its UI.

# Engagement layer
# ENGAGEMENT_TTL_MS=604800000
# ENGAGEMENT_MAX_REPAIRS=3
# ENGAGEMENT_INTERVIEW_MAX_Q=5
# ENGAGEMENT_MAX_STAGES=10

# Forge (multi-file agentic build pipeline — drives Hermes, see the HERMES_*
# build-driver keys above)
# FORGE_MAX_FILES=12
# Checkpoints (workflow approval gates — distinct from LEASH_CONFIRM_TTL_MS)
# CHECKPOINT_TTL_MS=1800000
# CHECKPOINT_SWEEP_MS=60000
# CHECKPOINT_EVERY_TICKS=50

# MCP server (opt-in stdio JSON-RPC tool catalog)
# MCP_SERVER_ENABLED=false

# YouTube embed mode (BUG-006 escape hatch)
# YOUTUBE_MODE=embed               # 'embed' (iframe) or 'newtab' (browser tab)

# Agent skills — where MYTHOS looks for installed SKILL.md packs and their
# runnable tooling (mythos/skills.allowlist selects WHICH ones it surfaces).
# Repo-vendored skills under mythos/skills/ always resolve first so a fresh
# clone works with zero installs. Beyond that, MYTHOS searches, in order:
#   $MYTHOS_SKILLS_DIR (below)
#   <home>/.claude/skills                                 (personal skills)
#   <home>/.claude/plugins/marketplaces/*/src             (plugin packs)
#   <home>/.claude/plugins/marketplaces/*/.claude/skills  (nested layout)
#   <home>/.zcode/skills
# Set this only if your skills live somewhere else. Accepts several paths
# separated by the platform delimiter (';' on Windows, ':' elsewhere) and they
# are searched before all the built-in locations.
# To see exactly where MYTHOS looked, call loader.externalSkillRoots().
# MYTHOS_SKILLS_DIR=

# Aether-BLE proximity-focus sensor (src/core/sensors/aether.js). Pulls the
# Aether aggregator's `election` broadcast — nearest device = owner — and emits
# perception.aether on owner-change / RSSI drift, surfaced in the HUD "NEAREST
# DEVICE" widget. OFF by default; point AETHER_WS_URL at the aggregator (:8766),
# NOT the raw scanner bridge (:8765). Agent_OS is just another dashboard client
# of the aggregator, so no Python-side config is needed.
# AETHER_ENABLED=false
# AETHER_WS_URL=ws://127.0.0.1:8766
