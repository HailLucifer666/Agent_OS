{
  "name": "agent-os",
  "version": "0.1.12",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dist": "electron-builder --win",
    "parity-check": "node mythos/scripts/parity-check.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "cross-fetch": "^4.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mythos.assistant",
    "productName": "MYTHOS",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "asar": true,
    "beforePack": "electron/build-browser-native-host.js",
    "asarUnpack": [
      "mythos/**/*"
    ],
    "files": [
      "package.json",
      "electron/**/*",
      "mythos/**/*",
      "!mythos/vault{,/**/*}",
      "!mythos/.venv{,/**/*}",
      "!mythos/.env",
      "!mythos/services/edge-tts-server.py",
      "!mythos/ui/public/models{,/**/*}",
      "mythos/ui/public/models/gesture_recognizer.task",
      "!mythos/models{,/**/*}",
      "!**/.cache{,/**/*}",
      "!mythos/test{,/**/*}",
      "!mythos/test-fixtures{,/**/*}",
      "!**/*.map",
      "!mythos/Plans{,/**/*}",
      "!mythos/BUGS.md",
      "!mythos/ROADMAP.md",
      "!mythos/scripts/verify-*.js",
      "!mythos/scripts/triage-drift.js",
      "!mythos/scripts/sync-test-count.js",
      "!mythos/scripts/graphify.js",
      "!mythos/scripts/graphify-validate.js",
      "!mythos/scripts/live-logs.js",
      "!mythos/scripts/diagnose-type-mechanisms.js",
      "!mythos/scripts/e2e{,/**/*}",
      "!**/onnxruntime-node/bin/napi-v*/darwin{,/**/*}",
      "!**/onnxruntime-node/bin/napi-v*/linux{,/**/*}",
      "!**/onnxruntime-web/lib{,/**/*}",
      "!**/@huggingface/transformers/src{,/**/*}"
    ],
    "win": {
      "extraResources": [
        { "from": ".cache/native-browser-host/mythos-browser-host.exe", "to": "mythos-browser-host.exe" }
      ],
      "target": "nsis",
      "forceCodeSigning": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HailLucifer666",
        "repo": "Agent_OS",
        "releaseType": "release"
      }
    ]
  }
}
