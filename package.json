{
  "name": "agent-os",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.1",
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mythos.assistant",
    "productName": "MYTHOS",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "asar": false,
    "includeSubNodeModules": true,
    "files": [
      "package.json",
      "electron/**/*",
      "mythos/**/*",
      "!mythos/vault{,/**/*}",
      "!mythos/.venv{,/**/*}",
      "!mythos/.env",
      "!mythos/services/edge-tts-server.py",
      "!mythos/ui/public/models{,/**/*}",
      "!mythos/models{,/**/*}",
      "!**/.cache{,/**/*}",
      "!mythos/test{,/**/*}",
      "!mythos/test-fixtures{,/**/*}",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
