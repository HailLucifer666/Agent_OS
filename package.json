{
  "name": "agent-os",
  "version": "0.1.12",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dist": "electron-builder --win --publish never && node mythos/scripts/verify-package-contents.js --dist dist --receipt dist/package-scan.json",
    "parity-check": "node mythos/scripts/parity-check.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "cross-fetch": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mythos.assistant",
    "productName": "MYTHOS",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "asar": true,
    "beforePack": "electron/build-browser-native-host.js",
    "asarUnpack": [
      "mythos/**/*"
    ],
    "files": [
      "package.json",
      "electron/**/*",
      "mythos/**/*",
      "!mythos/vault{,/**/*}",
      "!mythos/.venv{,/**/*}",
      "!mythos/.env",
      "!mythos/services/edge-tts-server.py",
      "!mythos/ui/public/models{,/**/*}",
      "mythos/ui/public/models/gesture_recognizer.task",
      "!mythos/models{,/**/*}",
      "!**/.cache{,/**/*}",
      "!mythos/test{,/**/*}",
      "!mythos/test-fixtures{,/**/*}",
      "!**/*.map",
      "!mythos/Plans{,/**/*}",
      "!mythos/BUGS.md",
      "!mythos/ROADMAP.md",
      "!mythos/scripts/verify-*.js",
      "!mythos/scripts/triage-drift.js",
      "!mythos/scripts/sync-test-count.js",
      "!mythos/scripts/graphify.js",
      "!mythos/scripts/graphify-validate.js",
      "!mythos/scripts/live-logs.js",
      "!mythos/scripts/diagnose-type-mechanisms.js",
      "!mythos/scripts/e2e{,/**/*}",
      "!**/onnxruntime-node/bin/napi-v*/darwin{,/**/*}",
      "!**/onnxruntime-node/bin/napi-v*/linux{,/**/*}",
      "!**/onnxruntime-web/lib{,/**/*}",
      "!**/@huggingface/transformers/src{,/**/*}",
      "!**/*.[eE][nN][vV]*{,/**/*}",
      "!**/*.[pP][fF][xX]{,/**/*}",
      "!**/*.[pP]12{,/**/*}",
      "!mythos/[cC][oO][nN][fF][iI][gG]*.[jJ][sS][oO][nN]*{,/**/*}",
      "!mythos/[kK][eE][yY][sS]*.[jJ][sS][oO][nN]*{,/**/*}",
      "!mythos/[aA][uU][tT][hH]-[sS][eE][sS][sS][iI][oO][nN][sS]*.[jJ][sS][oO][nN]*{,/**/*}",
      "!mythos/[mM][yY][tT][hH][oO][sS]-[sS][eE][tT][tT][iI][nN][gG][sS]*.[jJ][sS][oO][nN]*{,/**/*}",
      "!mythos/.[bB][rR][oO][wW][sS][eE][rR]-[aA][gG][eE][nN][tT].[pP][iI][dD]{,/**/*}",
      "!mythos/[vV][aA][uU][lL][tT]{,/**/*}",
      "!mythos/[vV][aA][uU][lL][tT]_[tT][eE][sS][tT]_[aA][uU][dD][iI][tT]_*{,/**/*}",
      "!mythos/.[tT][mM][pP]-*{,/**/*}"
    ],
    "win": {
      "extraResources": [
        { "from": ".cache/native-browser-host/mythos-browser-host.exe", "to": "mythos-browser-host.exe" }
      ],
      "target": "nsis",
      "forceCodeSigning": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HailLucifer666",
        "repo": "Agent_OS",
        "releaseType": "release"
      }
    ]
  }
}
