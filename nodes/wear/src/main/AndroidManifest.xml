<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Advertising only. This app never scans, so it declares no BLUETOOTH_SCAN
         and no location permission of any kind — the watch broadcasts an opaque
         19-byte HMAC'd payload and learns nothing about its surroundings. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Required to reach the local BluetoothAdapter at all on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The beacon must keep advertising with the screen off, which is exactly
         what a foreground service is for. connectedDevice is the correct type:
         nothing here derives physical location. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- exported=true is required for the launcher, and is also how the
             one-time realm-key provisioning intent arrives over adb (there is no
             usable keyboard on a watch). MainActivity ignores the extra unless
             it is a well-formed 64-hex-char key. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BeaconService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
