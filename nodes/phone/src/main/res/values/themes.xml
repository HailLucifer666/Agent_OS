<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by declaration, not by inheritance: this app has exactly one look,
         and a light-theme flash on cold start against a true-black UI is jarring.
         windowBackground matches MythosTheme.Bg so the launch window and the first
         composed frame are the same colour. -->
    <style name="Theme.MythosNode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
