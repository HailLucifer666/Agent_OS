<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Scanning only; this node never advertises. neverForLocation is honest
         here: the payload is an opaque HMAC and nothing derives a position from
         it beyond "nearer than the other phone". -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Below API 31 a BLE scan requires a location permission whether or not the
         app wants location, so it is capped rather than requested on modern OSes. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Both service types: the mic must work with the screen off, and so must the
         scanner. That is the entire premise of a counter-top node. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WHY CLEARTEXT IS PERMITTED, and why it is not a lapse.
         MYTHOS runs on the operator's own machine on their own LAN, reached as
         ws://<lan-ip>:4478 — an IP address, so there is no certificate to
         validate and no HTTPS to offer. Since API 28 Android blocks cleartext by
         DEFAULT, and OkHttp then fails the connection with
         UnknownServiceException("CLEARTEXT communication to <ip> not permitted by
         network security policy") BEFORE a packet leaves the phone. That is
         invisible from the server: the operator sees "no link" while the server
         log shows no rejection and no attempt, because there was none.
         Aether PROTOCOL.md §11.4 already defers transport encryption for the
         mesh; the shared MYTHOS_AUTH_TOKEN is what authenticates this node, not
         the transport. Not scoped to a domain because the operator's LAN address
         is assigned by their router and a network-security-config domain entry
         cannot express a private IP range. -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MythosNode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.MythosNode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VoiceNodeService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />

    </application>

</manifest>
