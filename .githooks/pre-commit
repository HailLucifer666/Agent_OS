#!/bin/sh
# Blocks commits that raise the mythos test-failure count above the known baseline (0),
# or that leave README.md/ROADMAP.md test-count mentions stale (see sync-test-count.js).
cd "$(git rev-parse --show-toplevel)/mythos" || exit 1

# --- Environment, decided here rather than left to whoever is committing -----
#
# Audit 2026-08-22, item 15. Two environmental faults made this gate report
# failures that were not real: the SAME unchanged working tree scored 1, then 3,
# then 2, then 0 failures across four consecutive runs. Both are fixed inside the
# hook, because "remember to export these first" is documentation, not a control
# — and the failure text never points at the environment, so every agent who
# works on this repo pays for it exactly once.
#
# FAULT 1 — the temp directory in Windows 8.3 short form ('<NAME>~1').
# os.tmpdir() inherits the short spelling, fs.mkdtempSync() hands a spawned
# server a short-name vault path, and the watcher over it trips a libuv bug: the
# child aborts on `Assertion failed: !_wcsnicmp(filename, dir, dirlen)` and the
# test reports only `connect ECONNREFUSED` after its full timeout, because the
# child's stderr is captured and never printed.
#
# THIS HOOK WAS THE VICTIM, WHICH IS THE PART THAT HID IT. Measured 2026-08-22:
# git does not pass the invoking shell's TEMP to a hook — it sets TEMP=/tmp and
# TMP=/tmp. That string has no '~' in it, so every check written against the
# shell's own TEMP concluded the environment was fine. But Git Bash's /tmp maps
# to the profile's local AppData temp folder spelled with its 8.3 SHORT name, so
# node's os.tmpdir() inside the suite resolved to the short form on every commit
# this repo has ever gated.
# `deploy-config-conformance.test.js`'s real-boot test failed at its 30s timeout
# because of it, and that failure was repeatedly written off as flakiness.
#
# So the question to ask is not "does this shell's TEMP look wrong" but "what
# will node actually use" — ask node, expand that, and hand it back. Unconditional
# and idempotent: on a machine with no short names it resolves to itself.
# realpathSync.native is the expander because node is already a hard dependency
# of this hook and cygpath is not guaranteed to exist.
canon=$(node -e 'const fs=require("fs"),os=require("os");try{process.stdout.write(fs.realpathSync.native(os.tmpdir()))}catch(e){process.stdout.write("")}')
if [ -n "$canon" ]; then
  TEMP="$canon"
  TMP="$canon"
  export TEMP TMP
  echo "pre-commit: temp dir pinned to $TEMP"
fi

# FAULT 2 — a port the suite needs is already held, and it reads as broken code.
# test/boot.test.js spawns src/main.js on 4478 and the legacy proactive-speak
# path needs the edge-tts server on 5050 — the same two ports the desktop
# launcher frees on start. With the app open they fail as EADDRINUSE and as "the
# legacy path must still complete a proactive turn", neither of which mentions a
# port.
#
# THIS HOOK'S FIRST FIX FOR THAT WAS ITSELF SQUATTABLE, and it was squatted.
# It defaulted to 4997/5097, and on 2026-08-27 both were listening: pid 4296
# (node src/main.js) on 4997 and pid 10904 (edge-tts-server.py, from the .venv of
# a worktree that no longer exists) on 5097 — orphaned children of a dead
# session's suite run, not the operator's app. A commit was blocked with three
# failures (`boot`, `BUG-274 T4 engine attribution`, `proactiveSpeak routes
# through the Live session`) on a tree that had just run green. Swapping one
# hardcoded pair for another only moved the collision, and the recovery still
# required knowing to run netstat first — the exact required-knowledge the temp
# fix above exists to abolish.
#
# So: ASK the OS which ports are free instead of naming any. Still `:=`, so an
# operator or CI that set one deliberately keeps it. MYTHOS_PORT=0 is NOT an
# ephemeral port here — the config schema enforces a minimum of 1024 and rejects
# it as a config error — which is why the picker validates what it hands back.
if [ -z "$MYTHOS_PORT" ] || [ -z "$EDGE_TTS_PORT" ]; then
  picked=$(node scripts/pick-free-ports.js 2>/dev/null)
  if [ -n "$picked" ]; then
    : "${MYTHOS_PORT:=$(printf '%s' "$picked" | cut -d' ' -f1)}"
    : "${EDGE_TTS_PORT:=$(printf '%s' "$picked" | cut -d' ' -f2)}"
  else
    # Deliberate fallback rather than a blocked commit: failing to pick a port is
    # not evidence about the code being committed. Loud, because these are the
    # numbers that were squatted before.
    echo "pre-commit: WARNING — could not pick free ports; falling back to 4997/5097."
    echo "pre-commit:   If the suite now fails on boot/proactive-speak, check for a listener:"
    echo "pre-commit:   node scripts/pick-free-ports.js --report"
    : "${MYTHOS_PORT:=4997}"
    : "${EDGE_TTS_PORT:=5097}"
  fi
fi
: "${EDGE_TTS_URL:=http://127.0.0.1:$EDGE_TTS_PORT}"
export MYTHOS_PORT EDGE_TTS_PORT EDGE_TTS_URL
echo "pre-commit: ports MYTHOS_PORT=$MYTHOS_PORT EDGE_TTS_PORT=$EDGE_TTS_PORT"

# No path args: node's own recursive discovery, not a shallow test/*.test.js glob
# (which silently skipped test/assistant/*.test.js + test/engagements/*.test.js —
# 14 files / ~188 tests never gated by this hook. Found 2026-07-30.)
out=$(node --test --test-reporter=tap 2>&1)
fails=$(printf '%s' "$out" | grep -Eo '^# fail [0-9]+' | tail -1 | grep -Eo '[0-9]+')
[ -z "$fails" ] && fails=999
echo "pre-commit: mythos test failures = $fails (baseline 0)"
if [ "$fails" -gt 0 ]; then
  # Name the tests. This used to be `tail -40` of raw TAP, which is the last few
  # PASSING tests plus the summary counts — a blocked commit told you a number
  # and nothing else, so the first move was always to re-run the suite by hand
  # just to find out what broke.
  # BUG-371: both patterns are anchored `^[[:space:]]*`, not `^`. Node's TAP
  # NESTS subtests under their describe block and indents them, so a bare `^`
  # matched only the top-level roll-up:
  #
  #     not ok 1264 - lint-bug-registry — the numbers it reports
  #
  # while the line that says what actually broke sat four levels down, with the
  # numbers that identify it one level deeper still:
  #
  #         not ok 1 - next-free skips the fixture, and is not 1000
  #           error: |-
  #             368 !== 367
  #
  # A blocked commit therefore named the FILE and nothing else. Two sessions hit
  # that on 2026-08-27: one had to sed into raw TAP by line number to recover
  # `368 !== 367` — without which the obvious next move is to hunt for a bug in
  # the linter rather than find a stale constant in its test — and the other
  # could conclude nothing at all from a single unreproducible red because the
  # assertion text was already gone.
  #
  # The `-qE` guard carries the same anchor deliberately. If it ever disagrees
  # with the filter below, a run whose only failures are nested reports "the
  # suite died without a summary" and falls back to `tail -40` — the exact
  # output this reporting block was written to replace.
  if printf '%s' "$out" | grep -qE '^[[:space:]]*not ok'; then
    echo "pre-commit: failing tests —"
    # The awk carries each failure's `error:` body with it. A test name alone
    # cannot distinguish a stale expectation from a real regression; the values
    # are the diagnosis. Bounded at 80 lines rather than 40 because each failure
    # now costs several — still bounded, because an unbounded dump of a
    # 6000-test suite is how this block came to print `tail -40` in the first
    # place.
    # REPORT-FILTER:START — sliced and executed verbatim by
    # mythos/test/bug-371-hook-hides-nested-failures.test.js, which supplies
    # `out` through the environment. Keep the sentinels: a test that restates
    # this pipeline instead of running it is a test of the restatement.
    printf '%s\n' "$out" \
      | awk '
          /^[[:space:]]*not ok/            { print; inerr = 0; next }
          /^[[:space:]]*error:/            { print; inerr = 1; next }
          inerr && /^[[:space:]]*(code|stack|failureType|duration_ms|location|expected|actual|operator|\.\.\.|---)/ { inerr = 0; next }
          inerr                            { print }
        ' \
      | head -80
    # REPORT-FILTER:END
  else
    # A suite that dies without a summary emits no 'not ok' at all (exit 127,
    # fork exhaustion, a crash in a helper). Showing an empty list there would be
    # worse than the tail it replaced, so fall back deliberately.
    echo "pre-commit: no 'not ok' lines — the suite died without a summary. Last 40 lines:"
    printf '%s\n' "$out" | tail -40
  fi
  echo "pre-commit: BLOCKED — failure count above baseline. Fix or revert."
  exit 1
fi
if ! printf '%s' "$out" | node scripts/sync-test-count.js --check; then
  echo "pre-commit: BLOCKED — tracked test-count numbers are stale. Run 'node scripts/sync-test-count.js --write' and commit the result."
  exit 1
fi

# BUG numbering. Two numbers already carry two unrelated defects each (BUG-280,
# BUG-360) because "re-grep the max before you assign one" is a rule that lives
# in a human's memory. ~0.8s, no network.
#
# KNOWN LAG, stated rather than papered over: this reads committed history, so a
# number that appears ONLY in the message of the commit being made is not seen
# until the next commit. A number that also appears in source or in BUGS.md —
# which is every number worth gating on — is seen immediately, because those are
# read from the working tree.
if ! node scripts/lint-bug-registry.js; then
  echo "pre-commit: BLOCKED — bug registry. Renumber, write the missing BUGS.md entries, or"
  echo "            adjudicate with a reason in scripts/lint-bug-registry.js."
  exit 1
fi

# The capability map must keep describing the code it claims to describe. This
# reads only the repository (the registered tool list, live-tools' allowlist and
# the committed suite numbers) — it does NOT run the suite and does NOT need the
# operator's live vault, so it costs about a second and is satisfiable on a
# worktree and on a CI runner. The vault-derived vital is exempt from the check
# for exactly that reason; see the script's header.
# The ticket register in the same file, generated from BUGS.md. Separate gate
# from the map above because a different generator owns it: the map owns nodes
# and vitals, this owns the register. Both splice their own key into one island
# and preserve the rest, so the order they run in does not matter.
if ! node scripts/build-index.js --check; then
  echo "pre-commit: BLOCKED — the ticket register in index.html disagrees with BUGS.md."
  echo "            Run: node mythos/scripts/build-index.js --write"
  exit 1
fi

if ! node scripts/build-capability-map.js --check; then
  echo "pre-commit: BLOCKED — the capability map disagrees with the code. A tool was added or"
  echo "            removed and no node covers it, or a node names a tool that no longer exists."
  echo "            Map the tool to a node, then: node mythos/scripts/build-capability-map.js --write"
  exit 1
fi
exit 0
