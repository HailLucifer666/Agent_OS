# dependencies / build artifacts
mythos/node_modules/
# Electron desktop shell lives at the repo root (electron/main.js + root
# package.json), so its ~180MB of devDeps installs to /node_modules/ —
# separate from mythos/'s runtime deps. Never commit either.
/node_modules/
_devtools/

# python virtualenv (project-local Python tooling, e.g. the agent-reach CLI).
# Never committed — contributors create their own with `python -m venv .venv`.
.venv/

# Hermes-Agent (NousResearch, MIT) — the build engine, installed project-local
# via mythos/scripts/setup-hermes.js. This is HERMES_HOME: it holds a full
# third-party git checkout, its own CPython + uv + PortableGit, AND Hermes's own
# config.yaml/auth.json with provider credentials. Never commit it — contributors
# run the setup script to pull their own copy from git.
# Leading slash pins this to the repo root (see the /design/ note above for why).
/Hermes Agent/

# Android platform-tools (Google, Apache 2.0) — the ADB bridge's `adb`
# binary, installed project-local via mythos/scripts/setup-android.js
# --install. Same convention as /Hermes Agent/ above: a third-party tool
# checkout never belongs in git, contributors fetch their own copy.
/Android Platform Tools/

# local data — real user vault content, never publish
mythos/vault/
# A vault rooted at the REPO level (not mythos/vault) can appear if MYTHOS is
# ever launched with the wrong CWD (e.g. a transient Electron-shell mispath).
# It's boot artifacts, never publish it. Leading slash pins it to repo root so
# it does NOT also match a future tracked mythos/vault-equivalent elsewhere.
/vault/

# test-fixture vaults left behind by test/bug-019-audit-history.test.js (real
# fs-store-backed temp vaults under a Date.now()-suffixed dir, never cleaned up)
mythos/vault_test_audit_*/

# openWakeWord pretrained models (CC BY-NC-SA — fetched by scripts/setup-wakeword.js,
# never committed; see THIRD_PARTY_NOTICES.md)
mythos/ui/public/models/wakeword/

# Silero VAD ONNX model (MIT — fetched by scripts/setup-silero.js, never
# committed; see THIRD_PARTY_NOTICES.md)
mythos/ui/public/models/silero/

# secrets
.env
*.env.local
Nvidia NIM.env
# A copy of .env is still .env: `.env` alone does not match `.env.bak`,
# `.env.save`, `.env.2026-08-08` and friends, so an ordinary "back it up before
# editing" leaves a file holding MYTHOS_AUTH_TOKEN fully trackable — and two
# sessions share this working tree, where one `git add -A` would commit it.
.env.*
!.env.example

# session/tooling junk
.claude/
Thumbs.db
__pycache__/
*.pyc

# knowledge-graph build artifacts (regenerated locally via /graphify)
graphify-out/
# mythos/.graph-data.json is graphify.js's written output ("source of truth"
# for regenerating graphify-out/graph.html, per MYTHOS-ARCHITECTURE.md) —
# regenerable per machine via `node mythos/scripts/graphify.js`, never committed.
mythos/.graph-data.json

# editor/planner scratch
.kilo/

# dashboard design mockups — local-only exploration, deliberately not shipped.
# Leading slash matters: a bare "design/" would also ignore the TRACKED
# mythos/src/core/design/ source dir and silently swallow new files added there.
/design/

# wakeword model backup left behind when test/wakeword.test.js loses the EPERM
# directory-rename race. Must never be committed: it holds the same CC BY-NC-SA
# openWakeWord weights that mythos/ui/public/models/wakeword/ is ignored for.
mythos/ui/public/models/wakeword.test-backup/

# scratch test/debug scripts (root-level ps1 probing scripts)
/check_*.ps1
/test_*.ps1

# Scratch roots created under mythos/ by code-search.test.js and
# document-rag.test.js. Both now delete these in an after() hook, so a clean
# run leaves nothing; these entries exist so a run that DIES mid-test can't
# leave committable garbage behind (an empty dir was already invisible to
# `git status`, which is exactly why two of them sat here unnoticed).
mythos/.tmp-code-search-test/
mythos/.tmp-doc-rag-test/

# zcode session plans
.zcode/plans/
# zcode session logs/scratch (never publish)
.zcode/tmp/
.gstack/

# secrets scratch file — never commit (live API keys)
/env.download

# Generated by scripts/build-release-notes.js right before the electron-builder
# step reads it (release.js and .github/workflows/release.yml both regenerate
# it fresh) — never committed. release.js's preflight aborts on ANY dirty
# working tree, untracked files included, so a leftover copy here would block
# the next release before the build even starts.
/build/release-notes.md

# electron-builder installer output + its project-local download cache.
# ELECTRON_BUILDER_CACHE must be set to this cache dir when running `npm run
# dist` — electron-builder otherwise defaults to %LOCALAPPDATA%\electron-builder,
# which violates the project-isolation rule (nothing outside the repo).
/dist/
/.electron-builder-cache/

# Piper TTS voice models — 60MB each, downloaded per-machine like the wake-word
# models. Install with: node mythos/scripts/setup-piper.js --install
/mythos/models/piper/

# Kokoro TTS + local Whisper STT models — fetched from Hugging Face on first
# use into these per-machine cache dirs (providers/kokoro-tts.js,
# providers/local-whisper-stt.js), never committed. See THIRD_PARTY_NOTICES.md.
/mythos/models/kokoro/
/mythos/models/whisper/

# E2E run artifacts — screenshots, boot logs and the results JSON that
# scripts/e2e/run-e2e.mjs writes on every run. Regenerated per run, never committed.
/mythos/scripts/e2e/artifacts/

# MYTHOS Voice Nodes (nodes/) — the Android/Wear Gradle build. Its outputs and
# machine-specific SDK path never belong in git; contributors point
# nodes/local.properties at their own Android SDK (see nodes/README.md).
nodes/local.properties
nodes/.gradle/
nodes/build/
nodes/*/build/
nodes/.kotlin/

# ---------------------------------------------------------------------------
# Agent-tool scratch directories and stray plan-mode artifacts.
#
# These were TRACKED and therefore public, while containing point-in-time
# findings that current code has since fixed. .qoder/specs/ still carried a
# "CRITICAL: no authentication on any REST route or WS" finding that commit
# 8be82f2 (bearer auth + WS ?token=) closed on 2026-07-30 — a stale CRITICAL
# in a public repo reads as a live advisory to anyone who finds it, so these
# are untracked deliberately rather than left to rot in the open.
#
# The three canonical plan documents live in mythos/Plans/ and stay tracked;
# see the root CLAUDE.md for why there are exactly three and no more.
# i-just-installed-the-virtual-sketch.md is the auto-named plan-mode ancestor
# of mythos/Plans/MYTHOS-IRIS-Synthesis-Plan.md (same title, same wave
# structure) and is superseded by it — ignored, not deleted, because
# CLAUDE.md's "plans can hide outside the repo" rule was written after a plan
# was nearly lost this exact way.
.qoder/
.zcode/
/i-just-installed-the-virtual-sketch.md

# .freebuff — a third-party agent desktop tool's local state: a SQLite DB that
# holds its session/chat history, and a full nested copy of THIS repo (own .git
# included) as one of its worktrees. Neither can ever be published; the nested
# repo alone would be catastrophic bloat under a careless `git add -A`.
# Leading slash pins it to the repo root.
/.freebuff/

# Aether-BLE (HailLucifer666/Aether-BLE) — the BLE proximity mesh MYTHOS talks to
# for nearest-device speech. Cloned project-local so the voice-node verifier can
# drive the REAL aggregator.py, same convention as /Hermes Agent/ and
# /Android Platform Tools/ above: a separate repo with its own history and its
# own Python venv never belongs inside this one.
/Aether-BLE/

# hallmark skill's runtime diversification log (project memory written where
# builds run — runtime-local state, never publish; see mythos/skills/hallmark/)
.hallmark/
