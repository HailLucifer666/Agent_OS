# Agentic OS — copy to .env and fill in as needed. App runs fine with none set.

# Port for the local server (default 4477)
PORT=4477

# Ollama local server URL (default http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default Ollama chat model (default qwen3:latest)
OLLAMA_MODEL=qwen3:latest

# OpenRouter / Gemini seats in AI Agent Mastermind (Phase 2)
OPENROUTER_API_KEY=

# Claude API key, used for Claude tab + Free Claude Code (Phase 2)
ANTHROPIC_API_KEY=

# Optional model id override for the Claude CLI (claude tab). Leave blank for CLI default.
CLAUDE_MODEL=

# Model passed to Free Claude Code's --model flag in Mastermind (default haiku)
FREE_CLAUDE_MODEL=

# OpenRouter model ids for Mastermind seats (defaults shown)
SEAT_GEMINI_MODEL=
SEAT_CODEX_MODEL=
SEAT_GLM_MODEL=

# OpenAI API key, used for Thumbnail Studio image generation/edit (gpt-image-1)
OPENAI_API_KEY=

# Suno music via sunoapi.org (unofficial third-party proxy) — Music Studio
SUNO_API_KEY=
SUNO_API_URL=https://api.sunoapi.org
SUNO_MODEL=V4_5

# HeyGen API key — Video Studio avatar (Presenter mode)
HEYGEN_API_KEY=

# ElevenLabs API key — Video Studio voiceover narration (Voiceover mode)
ELEVENLABS_API_KEY=

# MiniMax API key — Video Studio b-roll (MiniMax engine)
MINIMAX_API_KEY=

# xAI API key + model override — Video Studio b-roll (Grok engine)
XAI_API_KEY=
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Agent Monitor — shells out to the `abtop` CLI (https://github.com/graykode/abtop) for live
# Claude Code / Codex / OpenCode session data. Requires abtop on PATH (cargo install abtop).
AGENT_MONITOR_ENABLED=true
# How often the server re-runs `abtop --json` and caches the result (ms). abtop does a full
# process/port/transcript scan each call — keep this >= 3000.
AGENT_MONITOR_POLL_MS=5000
