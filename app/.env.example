# Agentic OS — Environment Variables
# Copy this file to .env and fill in your keys.
# Do NOT commit .env to version control.

# ---- Server ----
PORT=4477
# Bind address. Defaults to 127.0.0.1 (loopback only — dashboard unreachable from LAN).
# Set to 0.0.0.0 ONLY if you deliberately want network exposure.
BIND=127.0.0.1
# Opt-in fail-fast: set to 1 to refuse boot when ANTHROPIC_API_KEY is missing.
# Default (unset/0): start degraded so the dashboard can still show what's offline.
FAIL_FAST=

# ---- Claude Code CLI ----
# Required for: Claude chat, Free Claude Code, Game Studio, Video script, Pipeline/Kanban agents
ANTHROPIC_API_KEY=
# Optional: override the model the orchestrator + Claude chat use (e.g. sonnet, opus, haiku)
CLAUDE_MODEL=
# Optional: model for the Free Claude Code seat (defaults to haiku)
FREE_CLAUDE_MODEL=

# ---- Ollama (local Hermes) ----
# Required for: Hermes chat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest

# ---- OpenRouter (Gemini, Codex, GLM seats in Mastermind) ----
# Required for: Mastermind seats (Gemini, Codex, GLM)
OPENROUTER_API_KEY=
SEAT_GEMINI_MODEL=google/gemini-2.5-flash
SEAT_CODEX_MODEL=openai/gpt-5-mini
SEAT_GLM_MODEL=z-ai/glm-4.6

# ---- Suno (Music Studio) ----
# Required for: Music generation
SUNO_API_KEY=
SUNO_API_URL=https://api.sunoapi.org
SUNO_MODEL=V4_5

# ---- ElevenLabs (Video Studio voiceover) ----
# Required for: Video Studio narrator (voiceover mode)
ELEVENLABS_API_KEY=

# ---- HeyGen (Video Studio avatar) ----
# Required for: Video Studio avatar video
HEYGEN_API_KEY=

# ---- MiniMax (Video Studio b-roll) ----
# Required for: Video Studio b-roll generation
MINIMAX_API_KEY=

# ---- Grok (Video Studio b-roll) ----
# Required for: Video Studio b-roll generation
GROK_API_KEY=

# ---- OpenAI (Thumbnail Studio) ----
# Required for: Thumbnail generation / edit
OPENAI_API_KEY=

# ---- ZCode (Z.AI GLM) — primary reasoning engine ----
# Powers: ZCode chat seat, Mastermind seat, and the orchestrator (Pipeline/Kanban/Game/Video)
# when ANTHROPIC_API_KEY is absent. Get a key at https://z.ai.
ZCODE_API_KEY=
# Optional: override the GLM model (default glm-4.6). e.g. glm-4.5-air, glm-4.5-flash
ZCODE_MODEL=
# Optional: override the API base URL. Default includes the /v4 version segment.
ZCODE_API_URL=https://api.z.ai/api/paas/v4

# ---- NVIDIA NIM — secondary reasoning engine ----
# Powers: NIM chat seat, Mastermind seat, and the orchestrator fallback after ZCode.
# Get a key (nvapi-…) at https://build.nvidia.com.
NIM_API_KEY=
# Optional: override the model (default nvidia/llama-3.1-nemotron-70b-instruct).
# Browse model IDs at https://build.nvidia.com (e.g. meta/llama-3.1-405b-instruct, deepseek-ai/deepseek-r1).
NIM_MODEL=
# Optional: override the API base URL. Default includes the /v1 version segment.
NIM_API_URL=https://integrate.api.nvidia.com/v1

# ---- Free Provider Fleet (Sprint 4) ----
# All providers below have genuinely free tiers (no trial expiry, no credit card).
# Add keys only for the providers you want to use; unset keys = that provider stays OFFLINE.

# Groq — free LPU inference. Get a key at https://console.groq.com (free: ~30 RPM, ~14,400 req/day).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1

# OpenRouter free-models auto-router. REUSES the OPENROUTER_API_KEY already set above
# (Mastermind seats) — no separate key needed. Defaults to the free auto-router.
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_FREE_API_URL=https://openrouter.ai/api/v1

# Cerebras — fastest free inference. Get a key at https://cloud.cerebras.ai (free: ~1M tokens/day, 8K context).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Mistral — free Experiment mode. Get a key at https://console.mistral.ai (free: ~1 req/sec).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1

# Cloudflare Workers AI — free edge inference. Get credentials at https://dash.cloudflare.com (Workers AI section; free: 10,000 Neurons/day).
# NOTE: requires BOTH an API token AND your account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Edge TTS (free Microsoft Neural, UNOFFICIAL) ----
# Provides 322 Microsoft Neural voices via a local Python service. No API key,
# no account. UNOFFICIAL: reverse-engineers Edge's Read Aloud endpoint — personal/
# hobby use only, NOT for commercial deployment (violates Microsoft ToS).
# One-time install:  pip install edge-tts
EDGE_TTS_PORT=5050
EDGE_TTS_AUTOSTART=true
EDGE_TTS_DEFAULT_VOICE=en-US-AriaNeural
# EDGE_TTS_URL=http://127.0.0.1:5050

# ---- Orchestrator ----
# Limit how many agent jobs run in parallel (default: 1)
ORCHESTRATOR_CONCURRENCY=1

# ---- Agent Monitor ----
# Set to false to disable abtop polling entirely
AGENT_MONITOR_ENABLED=true
AGENT_MONITOR_POLL_MS=5000

# ---- Radar (free RSS MVP) ----
# Comma-separated RSS/Atom feed URLs. No API key needed — server fetches them on
# each "Consult the oracle" click to avoid browser CORS. Empty = empty Radar (honest).
# Examples (tech/AI feeds):
# RADAR_FEEDS=https://hnrss.org/frontpage,https://www.uie.com/brainsparks/feed/,https://feeds.arstechnica.com/arstechnica/index
RADAR_FEEDS=

# Optional: comma-separated keywords that boost signal scores when found in title/body.
# Each matching keyword adds +5 to score (max +20). Empty = no keyword boost.
# RADAR_KEYWORDS=ai,agents,llm,open source,local first
RADAR_KEYWORDS=
